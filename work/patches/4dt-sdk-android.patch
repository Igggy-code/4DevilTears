+// [4deviltears] Reads back what the GPU's copy of guest memory (shared memory) holds
+// for every texture of the traced frame - without requesting / re-uploading the ranges,
+// to compare with the CPU-side dumps (stale data = missed CPU write invalidation).
+void VulkanCommandProcessor::DumpTracedTexturesFromSharedMemory() {
+  std::vector<frame_trace::TextureRange> ranges = frame_trace::TakeTextureRanges();
+  std::vector<frame_trace::HostTextureDump> host_dumps = frame_trace::TakeHostTextureDumps();
+  auto write_host_dumps = [&]() {
+    const ui::vulkan::VulkanDevice* vd = GetVulkanDevice();
+    const ui::vulkan::VulkanDevice::Functions& f = vd->functions();
+    std::filesystem::path dir = std::filesystem::path(frame_trace::Directory()) / "tex";
+    for (const auto& dump : host_dumps) {
+      VkDeviceMemory dump_memory = VkDeviceMemory(dump.memory);
+      if (dump.image_width) {
+        // Linear image checkpoint.
+        VkImage image = VkImage(dump.buffer);
+        VkImageSubresource subresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0};
+        VkSubresourceLayout layout;
+        f.vkGetImageSubresourceLayout(vd->device(), image, &subresource, &layout);
+        void* image_mapping;
+        if (f.vkMapMemory(vd->device(), dump_memory, 0, VK_WHOLE_SIZE, 0, &image_mapping) ==
+            VK_SUCCESS) {
+          VkMappedMemoryRange invalidate = {};
+          invalidate.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+          invalidate.memory = dump_memory;
+          invalidate.size = VK_WHOLE_SIZE;
+          f.vkInvalidateMappedMemoryRanges(vd->device(), 1, &invalidate);
+          if (std::FILE* file = std::fopen((dir / dump.name).string().c_str(), "wb")) {
+            const uint8_t* rows = static_cast<const uint8_t*>(image_mapping) + layout.offset;
+            for (uint32_t y = 0; y < dump.image_height; ++y) {
+              std::fwrite(rows + size_t(y) * layout.rowPitch, 1,
+                          size_t(dump.image_width) * dump.image_bpp, file);
+            }
+            std::fclose(file);
+          }
+          f.vkUnmapMemory(vd->device(), dump_memory);
+        }
+        f.vkDestroyImage(vd->device(), image, nullptr);
+        f.vkFreeMemory(vd->device(), dump_memory, nullptr);
+        continue;
+      }
+      void* dump_mapping;
+      if (f.vkMapMemory(vd->device(), dump_memory, 0, VK_WHOLE_SIZE, 0, &dump_mapping) ==
+          VK_SUCCESS) {
+        VkMappedMemoryRange invalidate = {};
+        invalidate.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+        invalidate.memory = dump_memory;
+        invalidate.size = VK_WHOLE_SIZE;
+        f.vkInvalidateMappedMemoryRanges(vd->device(), 1, &invalidate);
+        if (std::FILE* file = std::fopen((dir / dump.name).string().c_str(), "wb")) {
+          std::fwrite(dump_mapping, 1, size_t(dump.size), file);
+          std::fclose(file);
+        }
+        f.vkUnmapMemory(vd->device(), dump_memory);
+      }
+      f.vkDestroyBuffer(vd->device(), VkBuffer(dump.buffer), nullptr);
+      f.vkFreeMemory(vd->device(), dump_memory, nullptr);
+    }
+    if (!host_dumps.empty()) {
+      REXGPU_INFO("frame_trace: {} decoded host textures written", host_dumps.size());
+    }
+  };
+  if (ranges.empty() || !shared_memory_ || !BeginSubmission(false)) {
+    if (!host_dumps.empty()) {
+      EndSubmission(false);
+      AwaitAllQueueOperationsCompletion();
+      write_host_dumps();
+    }
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkDeviceSize total = 0;
+  for (const auto& range : ranges) total += range.size;
+  VkBuffer buffer;
+  VkDeviceMemory memory;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, total, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, buffer, memory)) {
+    return;
+  }
+  shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+  SubmitBarriers(true);
+  VkBufferCopy* regions =
+      deferred_command_buffer_.CmdCopyBufferEmplace(shared_memory_->buffer(), buffer,
+                                                    uint32_t(ranges.size()));
+  VkDeviceSize offset = 0;
+  for (size_t i = 0; i < ranges.size(); ++i) {
+    regions[i].srcOffset = ranges[i].base;
+    regions[i].dstOffset = offset;
+    regions[i].size = ranges[i].size;
+    offset += ranges[i].size;
+  }
+  EndSubmission(false);
+  AwaitAllQueueOperationsCompletion();
+  void* mapping;
+  if (dfn.vkMapMemory(device, memory, 0, VK_WHOLE_SIZE, 0, &mapping) == VK_SUCCESS) {
+    VkMappedMemoryRange invalidate = {};
+    invalidate.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    invalidate.memory = memory;
+    invalidate.size = VK_WHOLE_SIZE;
+    dfn.vkInvalidateMappedMemoryRanges(device, 1, &invalidate);
+    std::filesystem::path dir = std::filesystem::path(frame_trace::Directory()) / "tex";
+    offset = 0;
+    for (const auto& range : ranges) {
+      std::FILE* f = std::fopen((dir / (std::string("gpu_") + range.name)).string().c_str(), "wb");
+      if (f) {
+        std::fwrite(static_cast<const uint8_t*>(mapping) + offset, 1, range.size, f);
+        std::fclose(f);
+      }
+      {
+        // Shared memory vs guest memory staleness diagnostics.
+        const uint8_t* gpu_data = static_cast<const uint8_t*>(mapping) + offset;
+        const uint8_t* cpu_data = memory_->TranslatePhysical<const uint8_t*>(range.base);
+        uint32_t pages = uint32_t((range.size + 4095) >> 12), stale_pages = 0;
+        uint32_t first_stale = UINT32_MAX;
+        for (uint32_t p = 0; p < pages; ++p) {
+          size_t page_offset = size_t(p) << 12;
+          size_t n = std::min<size_t>(4096, range.size - page_offset);
+          if (std::memcmp(gpu_data + page_offset, cpu_data + page_offset, n)) {
+            ++stale_pages;
+            if (first_stale == UINT32_MAX) first_stale = p;
+          }
+        }
+        if (stale_pages) {
+          uint32_t page_address = uint32_t(range.base) + (first_stale << 12);
+          bool valid = false, gpu_written = false;
+          shared_memory_->DebugPageFlags(page_address, valid, gpu_written);
+          REXGPU_INFO("STALE {} pages {}/{} first {:08X} shm valid {} gpuw {} {}", range.name,
+                      stale_pages, pages, page_address, valid, gpu_written,
+                      memory_->DebugDescribePhysicalPage(page_address));
+        }
+      }
+      offset += range.size;
+    }
+    dfn.vkUnmapMemory(device, memory);
+  }
+  dfn.vkDestroyBuffer(device, buffer, nullptr);
+  dfn.vkFreeMemory(device, memory, nullptr);
+  write_host_dumps();
+  REXGPU_INFO("frame_trace: {} textures read back from shared memory", ranges.size());
+}
