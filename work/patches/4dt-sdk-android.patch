diff --git a/src/graphics/vulkan/fast_resolve.cpp b/src/graphics/vulkan/fast_resolve.cpp
new file mode 100644
index 0000000..f7c1236
--- /dev/null
+++ b/src/graphics/vulkan/fast_resolve.cpp
@@ -0,0 +1,726 @@
+/**
+ * [4deviltears] Fast resolves for the Vulkan render target cache.
+ *
+ * A Xenos resolve copies a rectangle of EDRAM into a texture in guest memory. The
+ * Xenia-derived path does it in three full passes: dump the host render target into
+ * an EDRAM-layout buffer, run the resolve shader from that buffer into shared memory
+ * (tiled guest layout), then - when the game samples the texture - untile shared
+ * memory into a host texture again. On a mobile GPU that is most of the frame's
+ * memory traffic.
+ *
+ * Here a resolve reads the host render target directly and writes 32-bit words of the
+ * destination format into a per-destination "resolve alias" image; the texture cache
+ * then copies that image into the texture (vkCmdCopyImage between size-compatible
+ * formats, a raw bit copy - exactly the guest semantics of reinterpreting the memory).
+ * While an address hasn't been confirmed to be consumed only through the alias, the
+ * regular path runs too, so nothing can go stale.
+ */
+
+#include <algorithm>
+#include <cmath>
+#include <string>
+#include <vector>
+#include <unordered_set>
+
+#include <rex/cvar.h>
+#include <rex/graphics/flags.h>
+#include <rex/graphics/frame_trace.h>
+#include <rex/graphics/vulkan/command_processor.h>
+#include <rex/graphics/vulkan/render_target_cache.h>
+#include <rex/graphics/vulkan/texture_cache.h>
+#include <rex/logging.h>
+#include <rex/ui/vulkan/util.h>
+
+namespace {
+// [4DevilTears] Fast resolve destinations whose memory is also read as other textures: they
+// keep the fast path, but the regular resolve runs too (outside the public headers).
+std::unordered_set<uint32_t> g_overlap_read_aliases;
+}  // namespace
+
+namespace rex::graphics::vulkan {
+extern VulkanTextureCache* g_4dt_resolve_texture_cache;
+extern std::vector<void*> g_4dt_zero_copy_pending;
+}  // namespace rex::graphics::vulkan
+
+REXCVAR_DEFINE_INT32(fast_resolve, 2, "GPU",
+                     "Resolves straight from render targets into host images: 0 = off, 1 = in "
+                     "addition to the regular resolve, 2 = skip the regular resolve for "
+                     "addresses consumed only as textures")
+    .range(0, 2)
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
+REXCVAR_DEFINE_BOOL(fast_resolve_overlap_dual, true, "GPU",
+                    "[4DevilTears] When another texture overlaps a fast resolve destination, "
+                    "keep the fast path for the destination texture itself and also run the "
+                    "regular resolve (for the overlapping reader) instead of dropping the fast "
+                    "path - saves the untiling texture load of the destination")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_BOOL(fast_resolve_single_source, false, "GPU",
+                    "[4DevilTears] Fast resolve only for textures written from one render "
+                    "target per frame")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+namespace rex::graphics::vulkan {
+
+namespace {
+
+constexpr std::string_view kFastResolveColorShader = R"(#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(set = 0, binding = 0) uniform texture2D src_color;
+layout(set = 1, binding = 0, r32ui) uniform writeonly uimage2D dst;
+layout(push_constant) uniform Params {
+  ivec2 src_origin;
+  ivec2 dst_origin;
+  uvec2 size;
+  uint mode;
+  float scale;
+} p;
+void main() {
+  uvec2 id = gl_GlobalInvocationID.xy;
+  if (id.x >= p.size.x || id.y >= p.size.y) {
+    return;
+  }
+  vec4 c = texelFetch(src_color, p.src_origin + ivec2(id), 0);
+  c = clamp(c * p.scale, 0.0, 1.0);
+  if ((p.mode & 16u) != 0u) {
+    c = c.bgra;
+  }
+  uint w;
+  if ((p.mode & 15u) == 1u) {
+    uvec4 q = uvec4(c * vec4(1023.0, 1023.0, 1023.0, 3.0) + 0.5);
+    w = q.r | (q.g << 10) | (q.b << 20) | (q.a << 30);
+  } else {
+    uvec4 q = uvec4(c * 255.0 + 0.5);
+    w = q.r | (q.g << 8) | (q.b << 16) | (q.a << 24);
+  }
+  imageStore(dst, p.dst_origin + ivec2(id), uvec4(w, 0u, 0u, 0u));
+}
+)";
+
+constexpr std::string_view kFastResolveDepthShader = R"(#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(set = 0, binding = 0) uniform texture2D src_depth;
+layout(set = 1, binding = 0, r32ui) uniform writeonly uimage2D dst;
+layout(push_constant) uniform Params {
+  ivec2 src_origin;
+  ivec2 dst_origin;
+  uvec2 size;
+  uint mode;
+  float scale;
+} p;
+void main() {
+  uvec2 id = gl_GlobalInvocationID.xy;
+  if (id.x >= p.size.x || id.y >= p.size.y) {
+    return;
+  }
+  // The texture cache stores 24_8 / 24_8_FLOAT as R32 float depth values.
+  float d = texelFetch(src_depth, p.src_origin + ivec2(id), 0).r * p.scale;
+  imageStore(dst, p.dst_origin + ivec2(id), uvec4(floatBitsToUint(d), 0u, 0u, 0u));
+}
+)";
+
+struct FastResolveConstants {
+  int32_t src_origin[2];
+  int32_t dst_origin[2];
+  uint32_t size[2];
+  uint32_t mode;
+  float scale;
+};
+static_assert(sizeof(FastResolveConstants) == 32);
+
+}  // namespace
+
+bool VulkanRenderTargetCache::InitializeFastResolve() {
+  if (REXCVAR_GET(fast_resolve) <= 0) {
+    return true;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  VkDescriptorSetLayoutBinding binding = {};
+  binding.binding = 0;
+  binding.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  binding.descriptorCount = 1;
+  binding.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+  VkDescriptorSetLayoutCreateInfo set_layout_info = {};
+  set_layout_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+  set_layout_info.bindingCount = 1;
+  set_layout_info.pBindings = &binding;
+  if (dfn.vkCreateDescriptorSetLayout(device, &set_layout_info, nullptr,
+                                      &fast_resolve_dest_layout_) != VK_SUCCESS) {
+    REXGPU_ERROR("Fast resolve: failed to create the descriptor set layout");
+    return false;
+  }
+
+  VkDescriptorPoolSize pool_size;
+  pool_size.type = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  pool_size.descriptorCount = 512;
+  VkDescriptorPoolCreateInfo pool_info = {};
+  pool_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+  pool_info.maxSets = 512;
+  // Zero-copy texture descriptor sets are freed with their textures.
+  pool_info.flags = VK_DESCRIPTOR_POOL_CREATE_FREE_DESCRIPTOR_SET_BIT;
+  pool_info.poolSizeCount = 1;
+  pool_info.pPoolSizes = &pool_size;
+  if (dfn.vkCreateDescriptorPool(device, &pool_info, nullptr, &fast_resolve_descriptor_pool_) !=
+      VK_SUCCESS) {
+    REXGPU_ERROR("Fast resolve: failed to create the descriptor pool");
+    return false;
+  }
+
+  VkPushConstantRange push_constants;
+  push_constants.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+  push_constants.offset = 0;
+  push_constants.size = sizeof(FastResolveConstants);
+  auto create_layout = [&](VkDescriptorSetLayout source_layout, VkPipelineLayout& layout_out) {
+    VkDescriptorSetLayout set_layouts[] = {source_layout, fast_resolve_dest_layout_};
+    VkPipelineLayoutCreateInfo layout_info = {};
+    layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    layout_info.setLayoutCount = 2;
+    layout_info.pSetLayouts = set_layouts;
+    layout_info.pushConstantRangeCount = 1;
+    layout_info.pPushConstantRanges = &push_constants;
+    return dfn.vkCreatePipelineLayout(device, &layout_info, nullptr, &layout_out) == VK_SUCCESS;
+  };
+  if (!create_layout(descriptor_set_layout_sampled_image_, fast_resolve_layout_color_) ||
+      !create_layout(descriptor_set_layout_sampled_image_x2_, fast_resolve_layout_depth_)) {
+    REXGPU_ERROR("Fast resolve: failed to create the pipeline layouts");
+    return false;
+  }
+
+  auto create_pipeline = [&](std::string_view source, VkPipelineLayout layout,
+                             VkPipeline& pipeline_out) {
+    std::vector<uint32_t> spirv;
+    std::string error;
+    if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, source, spirv,
+                                               error)) {
+      REXGPU_ERROR("Fast resolve: shader compilation failed: {}", error);
+      return false;
+    }
+    pipeline_out = ui::vulkan::util::CreateComputePipeline(vulkan_device, layout, spirv.data(),
+                                                           spirv.size() * sizeof(uint32_t));
+    return pipeline_out != VK_NULL_HANDLE;
+  };
+  if (!create_pipeline(kFastResolveColorShader, fast_resolve_layout_color_,
+                       fast_resolve_pipeline_color_) ||
+      !create_pipeline(kFastResolveDepthShader, fast_resolve_layout_depth_,
+                       fast_resolve_pipeline_depth_)) {
+    REXGPU_ERROR("Fast resolve: failed to create the pipelines");
+    return false;
+  }
+  REXGPU_INFO("Fast resolve: enabled (mode {})", REXCVAR_GET(fast_resolve));
+  return true;
+}
+
+void VulkanRenderTargetCache::ShutdownFastResolve() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (auto& alias_pair : resolve_aliases_) {
+    ResolveAlias& alias = alias_pair.second;
+    if (alias.view != VK_NULL_HANDLE) dfn.vkDestroyImageView(device, alias.view, nullptr);
+    if (alias.image != VK_NULL_HANDLE) dfn.vkDestroyImage(device, alias.image, nullptr);
+    if (alias.memory != VK_NULL_HANDLE) dfn.vkFreeMemory(device, alias.memory, nullptr);
+  }
+  resolve_aliases_.clear();
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device,
+                                         fast_resolve_pipeline_color_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device,
+                                         fast_resolve_pipeline_depth_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device,
+                                         fast_resolve_layout_color_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device,
+                                         fast_resolve_layout_depth_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyDescriptorPool, device,
+                                         fast_resolve_descriptor_pool_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyDescriptorSetLayout, device,
+                                         fast_resolve_dest_layout_);
+}
+
+VulkanRenderTargetCache::ResolveAlias* VulkanRenderTargetCache::FindResolveAlias(
+    uint32_t address) {
+  auto it = resolve_aliases_.find(address);
+  return it != resolve_aliases_.end() ? &it->second : nullptr;
+}
+
+void VulkanRenderTargetCache::MarkResolveAliasesOverlappingAsIncompatible(
+    uint32_t start, uint32_t length, uint32_t except_address) {
+  for (auto& alias_pair : resolve_aliases_) {
+    ResolveAlias& alias = alias_pair.second;
+    if (alias.address == except_address || alias.incompatible) {
+      continue;
+    }
+    if (start < alias.address + alias.extent_length && alias.address < start + length) {
+      if (REXCVAR_GET(fast_resolve_overlap_dual)) {
+        if (g_overlap_read_aliases.insert(alias.address).second) {
+          REXGPU_INFO("Fast resolve: {:08X} ({}x{}) is also read as a different texture "
+                      "{:08X}+{:X} - fast path kept, regular resolve also runs",
+                      alias.address, alias.width, alias.height, start, length);
+        }
+        continue;
+      }
+      alias.incompatible = true;
+      REXGPU_INFO("Fast resolve: {:08X} ({}x{}) is also read as a different texture "
+                  "{:08X}+{:X} - keeping the regular resolve for it",
+                  alias.address, alias.width, alias.height, start, length);
+    }
+  }
+}
+
+bool VulkanRenderTargetCache::Dmc4CollectStackedAliases(uint32_t start, uint32_t length,
+                                                        uint32_t pitch, uint32_t endian,
+                                                        std::vector<ResolveAlias*>& aliases_out,
+                                                        std::vector<uint32_t>& rows_out) {
+  aliases_out.clear();
+  rows_out.clear();
+  const uint32_t tile_row_bytes = pitch * 32 * 4;
+  for (auto& alias_pair : resolve_aliases_) {
+    ResolveAlias& alias = alias_pair.second;
+    if (!(start < alias.address + alias.extent_length && alias.address < start + length)) {
+      continue;
+    }
+    // Resolved to memory as well (or only) - guest memory already has it.
+    if (alias.incompatible || g_overlap_read_aliases.count(alias.address)) {
+      continue;
+    }
+    // Zero-copy: the data is in the consuming texture (copied from there).
+    if (alias.zero_copy_last ? !alias.zero_copy_texture : !alias.written) {
+      if (alias.zero_copy_last) {
+        return false;
+      }
+      continue;  // no fast resolve since the last regular one
+    }
+    if (alias.width != pitch || alias.endian != endian || alias.address < start ||
+        !tile_row_bytes || (alias.address - start) % tile_row_bytes) {
+      return false;
+    }
+    aliases_out.push_back(&alias);
+    rows_out.push_back((alias.address - start) / tile_row_bytes * 32);
+  }
+  return true;
+}
+
+void VulkanRenderTargetCache::UseResolveAliasAsCopySource(ResolveAlias& alias) {
+  command_processor_.PushImageMemoryBarrier(
+      alias.image, ui::vulkan::util::InitializeSubresourceRange(), alias.stage_mask,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, alias.access_mask, VK_ACCESS_TRANSFER_READ_BIT,
+      alias.layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  alias.stage_mask = VK_PIPELINE_STAGE_TRANSFER_BIT;
+  alias.access_mask = VK_ACCESS_TRANSFER_READ_BIT;
+  alias.layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+}
+
+VulkanRenderTargetCache::ResolveAlias* VulkanRenderTargetCache::GetOrCreateResolveAlias(
+    uint32_t address, uint32_t width, uint32_t height) {
+  auto it = resolve_aliases_.find(address);
+  if (it != resolve_aliases_.end()) {
+    ResolveAlias& alias = it->second;
+    if (alias.width >= width && alias.height >= height) {
+      return &alias;
+    }
+    // A bigger destination at the same address - can't replace an image that may still
+    // be in use by the GPU here; keep using the regular path for it.
+    alias.incompatible = true;
+    return nullptr;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  ResolveAlias alias;
+  alias.address = address;
+  alias.width = width;
+  alias.height = height;
+  VkImageCreateInfo image_info = {};
+  image_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+  image_info.imageType = VK_IMAGE_TYPE_2D;
+  image_info.format = VK_FORMAT_R32_UINT;
+  image_info.extent = {width, height, 1};
+  image_info.mipLevels = 1;
+  image_info.arrayLayers = 1;
+  image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+  image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+  // TRANSFER_DST: a fresh alias is cleared with vkCmdClearColorImage.
+  image_info.usage =
+      VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+  image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  if (!ui::vulkan::util::CreateDedicatedAllocationImage(
+          vulkan_device, image_info, ui::vulkan::util::MemoryPurpose::kDeviceLocal, alias.image,
+          alias.memory)) {
+    REXGPU_ERROR("Fast resolve: failed to create a {}x{} alias image", width, height);
+    return nullptr;
+  }
+  VkImageViewCreateInfo view_info = {};
+  view_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+  view_info.image = alias.image;
+  view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+  view_info.format = VK_FORMAT_R32_UINT;
+  view_info.subresourceRange = ui::vulkan::util::InitializeSubresourceRange();
+  if (dfn.vkCreateImageView(device, &view_info, nullptr, &alias.view) != VK_SUCCESS) {
+    dfn.vkDestroyImage(device, alias.image, nullptr);
+    dfn.vkFreeMemory(device, alias.memory, nullptr);
+    return nullptr;
+  }
+  VkDescriptorSetAllocateInfo allocate_info = {};
+  allocate_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+  allocate_info.descriptorPool = fast_resolve_descriptor_pool_;
+  allocate_info.descriptorSetCount = 1;
+  allocate_info.pSetLayouts = &fast_resolve_dest_layout_;
+  if (dfn.vkAllocateDescriptorSets(device, &allocate_info, &alias.descriptor_set) != VK_SUCCESS) {
+    dfn.vkDestroyImageView(device, alias.view, nullptr);
+    dfn.vkDestroyImage(device, alias.image, nullptr);
+    dfn.vkFreeMemory(device, alias.memory, nullptr);
+    return nullptr;
+  }
+  VkDescriptorImageInfo descriptor_image;
+  descriptor_image.sampler = VK_NULL_HANDLE;
+  descriptor_image.imageView = alias.view;
+  descriptor_image.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+  VkWriteDescriptorSet write = {};
+  write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  write.dstSet = alias.descriptor_set;
+  write.dstBinding = 0;
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  write.pImageInfo = &descriptor_image;
+  dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+  REXGPU_INFO("Fast resolve: alias {:08X} {}x{}", address, width, height);
+  return &resolve_aliases_.emplace(address, alias).first->second;
+}
+
+// [4DevilTears] Why the last TryFastResolve didn't take the fast path (0 = it did).
+uint32_t g_4dt_fast_resolve_reject = 0;
+char g_4dt_fast_resolve_reject_detail[128] = {};
+static bool FastResolveReject(uint32_t reason) {
+  g_4dt_fast_resolve_reject = reason;
+  return false;
+}
+
+bool VulkanRenderTargetCache::TryFastResolve(const draw_util::ResolveInfo& resolve_info,
+                                             bool& legacy_needed_out) {
+  legacy_needed_out = true;
+  g_4dt_fast_resolve_reject = 0;
+  g_4dt_fast_resolve_reject_detail[0] = 0;
+  const int32_t mode_setting = REXCVAR_GET(fast_resolve);
+  if (mode_setting <= 0 || fast_resolve_pipeline_color_ == VK_NULL_HANDLE ||
+      GetPath() != Path::kHostRenderTargets || IsDrawResolutionScaled() ||
+      !resolve_info.copy_dest_extent_length) {
+    return FastResolveReject(1);
+  }
+  xenos::CopyCommand copy_command = resolve_info.rb_copy_control.copy_command;
+  if (copy_command != xenos::CopyCommand::kRaw && copy_command != xenos::CopyCommand::kConvert) {
+    return FastResolveReject(2);
+  }
+  if (resolve_info.copy_dest_info.copy_dest_array) {
+    return FastResolveReject(3);
+  }
+  bool is_depth = resolve_info.IsCopyingDepth();
+  const draw_util::ResolveEdramInfo& edram_info =
+      is_depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  if (edram_info.msaa_samples != xenos::MsaaSamples::k1X || edram_info.format_is_64bpp) {
+    return FastResolveReject(4);
+  }
+  uint32_t width = resolve_info.coordinate_info.width_div_8 << 3;
+  uint32_t height = resolve_info.height_div_8 << 3;
+  if (!width || !height) {
+    return FastResolveReject(5);
+  }
+
+  // The render target owning the whole source span.
+  uint32_t span_base, span_row_length, span_rows, span_pitch;
+  resolve_info.GetCopyEdramTileSpan(span_base, span_row_length, span_rows, span_pitch);
+  if (!span_rows || !span_row_length) {
+    return FastResolveReject(6);
+  }
+  uint32_t span_end = span_base + (span_rows - 1) * span_pitch + span_row_length;
+  if (span_end > xenos::kEdramTileCount) {
+    return FastResolveReject(7);
+  }
+  std::vector<EdramOwner> owners;
+  GetEdramOwners(span_base, span_end, owners);
+  RenderTarget* source = nullptr;
+  for (const EdramOwner& owner : owners) {
+    if (!owner.render_target || (source && owner.render_target != source)) {
+      return FastResolveReject(8);
+    }
+    source = owner.render_target;
+  }
+  if (!source) {
+    return FastResolveReject(9);
+  }
+  RenderTargetKey source_key = source->key();
+  if (bool(source_key.is_depth) != is_depth ||
+      source_key.msaa_samples != xenos::MsaaSamples::k1X ||
+      source_key.pitch_tiles_at_32bpp != edram_info.pitch_tiles) {
+    std::snprintf(g_4dt_fast_resolve_reject_detail, sizeof(g_4dt_fast_resolve_reject_detail),
+                  " (owner %s fmt%u base%u p%u msaa%u vs resolve p%u base%u owners %zu)",
+                  source_key.is_depth ? "D" : "C", uint32_t(source_key.resource_format),
+                  uint32_t(source_key.base_tiles), uint32_t(source_key.pitch_tiles_at_32bpp),
+                  1u << uint32_t(source_key.msaa_samples), uint32_t(edram_info.pitch_tiles),
+                  uint32_t(edram_info.base_tiles), owners.size());
+    return FastResolveReject(10);
+  }
+  uint32_t original_base = is_depth ? resolve_info.depth_original_base
+                                    : resolve_info.color_original_base;
+  if (original_base < source_key.base_tiles || !source_key.pitch_tiles_at_32bpp) {
+    return FastResolveReject(11);
+  }
+  uint32_t base_delta = original_base - source_key.base_tiles;
+  int32_t src_x = int32_t((base_delta % source_key.pitch_tiles_at_32bpp) *
+                          xenos::kEdramTileWidthSamples) +
+                  int32_t(resolve_info.copy_dest_x0);
+  int32_t src_y = int32_t((base_delta / source_key.pitch_tiles_at_32bpp) *
+                          xenos::kEdramTileHeightSamples) +
+                  int32_t(resolve_info.copy_dest_y0);
+  uint32_t source_width = source_key.GetWidth();
+  uint32_t source_height =
+      GetRenderTargetHeight(source_key.pitch_tiles_at_32bpp, source_key.msaa_samples);
+  if (src_x < 0 || src_y < 0 || uint32_t(src_x) + width > source_width ||
+      uint32_t(src_y) + height > source_height) {
+    return FastResolveReject(12);
+  }
+
+  // Destination format.
+  FastResolveConstants constants;
+  constants.mode = 0;
+  constants.scale = 1.0f;
+  if (is_depth) {
+    switch (source_key.GetDepthFormat()) {
+      case xenos::DepthRenderTargetFormat::kD24FS8:
+        // Host depth holds the 20e4 value halved (to fit [0, 2) into [0, 1]).
+        constants.scale = 2.0f;
+        break;
+      case xenos::DepthRenderTargetFormat::kD24S8:
+        break;
+      default:
+        return FastResolveReject(13);
+    }
+  } else {
+    xenos::ColorRenderTargetFormat source_format = source_key.GetColorFormat();
+    uint32_t source_mode;
+    switch (source_format) {
+      case xenos::ColorRenderTargetFormat::k_8_8_8_8:
+        source_mode = 0;
+        break;
+      case xenos::ColorRenderTargetFormat::k_2_10_10_10:
+      case xenos::ColorRenderTargetFormat::k_2_10_10_10_AS_10_10_10_10:
+        source_mode = 1;
+        break;
+      default:
+        return FastResolveReject(14);
+    }
+    if (copy_command == xenos::CopyCommand::kRaw) {
+      constants.mode = source_mode;
+    } else {
+      switch (resolve_info.copy_dest_info.copy_dest_format) {
+        case xenos::ColorFormat::k_8_8_8_8:
+          constants.mode = 0;
+          break;
+        case xenos::ColorFormat::k_2_10_10_10:
+          constants.mode = 1;
+          break;
+        default:
+          return FastResolveReject(15);
+      }
+      if (resolve_info.copy_dest_info.copy_dest_swap) {
+        constants.mode |= 16;
+      }
+      constants.scale = std::ldexp(1.0f, resolve_info.copy_dest_info.copy_dest_exp_bias);
+    }
+  }
+
+  // Destination image (whole destination texture at the unadjusted base address).
+  uint32_t dest_width = resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32 << 5;
+  uint32_t dest_height = resolve_info.copy_dest_coordinate_info.height_aligned_div_32 << 5;
+  uint32_t dst_x = resolve_info.copy_dest_x0;
+  uint32_t dst_y = resolve_info.copy_dest_y0;
+  if (!dest_width || !dest_height || dst_x + width > dest_width ||
+      dst_y + height > dest_height) {
+    return FastResolveReject(16);
+  }
+  uint32_t address = resolve_info.rb_copy_dest_base & 0x1FFFFFFF;
+  ResolveAlias* alias = nullptr;
+  if (!FindResolveAlias(address)) {
+    // Predicated tiling resolves each band of the frame into the same texture by moving
+    // the destination base down by whole rows of 32x32 tiles - write into the alias of
+    // the whole texture at the matching row instead of creating a separate one.
+    for (auto& alias_pair : resolve_aliases_) {
+      ResolveAlias& parent = alias_pair.second;
+      uint32_t tile_row_bytes = parent.width * 32 * 4;
+      if (parent.width != dest_width || parent.incompatible || address <= parent.address ||
+          address >= parent.address + parent.width * parent.height * 4 ||
+          (address - parent.address) % tile_row_bytes) {
+        continue;
+      }
+      uint32_t row_offset = (address - parent.address) / tile_row_bytes * 32;
+      if (dst_y + row_offset + height <= parent.height) {
+        alias = &parent;
+        dst_y += row_offset;
+      }
+      break;
+    }
+  }
+  if (!alias) {
+    alias = GetOrCreateResolveAlias(address, dest_width, dest_height);
+  }
+  if (!alias || alias->incompatible) {
+    return FastResolveReject(17);
+  }
+  // [4deviltears] The same texture written from different render targets within one frame
+  // (e.g. the HDR scene, then the final frame into the same address): keep the regular
+  // resolve for it - a texture read between the two must get the first one.
+  if (REXCVAR_GET(fast_resolve_single_source)) {
+    uint64_t frame = command_processor_.GetCurrentFrame();
+    if (alias->last_source_frame == frame && alias->last_source_key != source_key.key) {
+      alias->incompatible = true;
+      REXGPU_INFO("Fast resolve: {:08X} is written from different render targets in one "
+                  "frame - keeping the regular resolve for it",
+                  alias->address);
+      return FastResolveReject(18);
+    }
+    alias->last_source_frame = frame;
+    alias->last_source_key = source_key.key;
+  }
+  if (!alias->written) {
+    alias->extent_length = 0;
+    alias->covered_x0 = alias->covered_y0 = UINT32_MAX;
+    alias->covered_x1 = alias->covered_y1 = 0;
+  }
+  alias->covered_x0 = std::min(alias->covered_x0, dst_x);
+  alias->covered_y0 = std::min(alias->covered_y0, dst_y);
+  alias->covered_x1 = std::max(alias->covered_x1, dst_x + width);
+  alias->covered_y1 = std::max(alias->covered_y1, dst_y + height);
+  uint32_t extent_end = std::max(alias->address + alias->extent_length,
+                                 resolve_info.copy_dest_extent_start +
+                                     resolve_info.copy_dest_extent_length);
+  alias->extent_length = extent_end - alias->address;
+  alias->endian = uint32_t(resolve_info.copy_dest_info.copy_dest_endian);
+
+  // [4DevilTears] Zero-copy: the texture that consumes this alias was created with storage
+  // usage - write it directly (the alias stays as it was; the texture is revalidated after
+  // the range invalidation in Resolve).
+  VulkanTextureCache::Dmc4ZeroCopyTarget zc_targets[4];
+  uint32_t zc_count = 0;
+  if (g_4dt_resolve_texture_cache && alias->compatible && mode_setting >= 2) {
+    zc_count = g_4dt_resolve_texture_cache->Dmc4GetZeroCopyTargets(
+        alias->address, dst_x + width, dst_y + height, fast_resolve_dest_layout_,
+        fast_resolve_descriptor_pool_, zc_targets, 4);
+    // Readers that aren't zero-copy textures are caught when they read the alias (zero-copy
+    // is then blocked for the address).
+  }
+  void* zero_copy_texture = zc_count ? zc_targets[0].texture : nullptr;
+
+  // Record the copy.
+  auto& vulkan_source = *static_cast<VulkanRenderTarget*>(source);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.PushImageMemoryBarrier(
+      vulkan_source.image(),
+      ui::vulkan::util::InitializeSubresourceRange(
+          is_depth ? (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)
+                   : VK_IMAGE_ASPECT_COLOR_BIT),
+      vulkan_source.current_stage_mask(), VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      vulkan_source.current_access_mask(), VK_ACCESS_SHADER_READ_BIT,
+      vulkan_source.current_layout(), VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  vulkan_source.SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+                         VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  for (uint32_t i = 0; i < zc_count; ++i) {
+    g_4dt_resolve_texture_cache->Dmc4ZeroCopyBeginWrite(zc_targets[i].texture);
+  }
+  if (zero_copy_texture) {
+  } else if (alias->layout == VK_IMAGE_LAYOUT_UNDEFINED) {
+    // Fresh image - zero it so parts never written don't show garbage.
+    command_processor_.PushImageMemoryBarrier(
+        alias->image, ui::vulkan::util::InitializeSubresourceRange(),
+        VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+        VK_ACCESS_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+    command_processor_.SubmitBarriers(true);
+    VkClearColorValue zero = {};
+    VkImageSubresourceRange range = ui::vulkan::util::InitializeSubresourceRange();
+    command_buffer.CmdVkClearColorImage(alias->image, VK_IMAGE_LAYOUT_GENERAL, &zero, 1, &range);
+    alias->stage_mask = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    alias->access_mask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    alias->layout = VK_IMAGE_LAYOUT_GENERAL;
+  }
+  if (!zero_copy_texture) {
+    // The alias is only ever written in a rectangle, keep previous contents (other
+    // tiling bands of the same texture).
+    command_processor_.PushImageMemoryBarrier(
+        alias->image, ui::vulkan::util::InitializeSubresourceRange(), alias->stage_mask,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, alias->access_mask, VK_ACCESS_SHADER_WRITE_BIT,
+        alias->layout, VK_IMAGE_LAYOUT_GENERAL, VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED,
+        false);
+    alias->stage_mask = VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+    alias->access_mask = VK_ACCESS_SHADER_WRITE_BIT;
+    alias->layout = VK_IMAGE_LAYOUT_GENERAL;
+  }
+  command_processor_.SubmitBarriers(true);
+
+  VkPipelineLayout layout = is_depth ? fast_resolve_layout_depth_ : fast_resolve_layout_color_;
+  command_processor_.BindExternalComputePipeline(is_depth ? fast_resolve_pipeline_depth_
+                                                          : fast_resolve_pipeline_color_);
+  constants.src_origin[0] = src_x;
+  constants.src_origin[1] = src_y;
+  constants.dst_origin[0] = int32_t(dst_x);
+  constants.dst_origin[1] = int32_t(dst_y);
+  constants.size[0] = width;
+  constants.size[1] = height;
+  for (uint32_t i = 0; i < std::max(zc_count, uint32_t(1)); ++i) {
+    VkDescriptorSet descriptor_sets[] = {vulkan_source.GetDescriptorSetTransferSource(),
+                                         zc_count ? zc_targets[i].set : alias->descriptor_set};
+    command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, layout, 0, 2,
+                                           descriptor_sets, 0, nullptr);
+    FastResolveConstants target_constants = constants;
+    if (zc_count) {
+      target_constants.size[0] = std::min(width, zc_targets[i].width - dst_x);
+      target_constants.size[1] = std::min(height, zc_targets[i].height - dst_y);
+    }
+    command_buffer.CmdVkPushConstants(layout, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                      sizeof(target_constants), &target_constants);
+    command_buffer.CmdVkDispatch((target_constants.size[0] + 7) / 8,
+                                 (target_constants.size[1] + 7) / 8, 1);
+  }
+  alias->zero_copy_last = zero_copy_texture != nullptr;
+  if (zero_copy_texture) {
+    alias->zero_copy_texture = zero_copy_texture;
+    alias->zero_copy_texture_id =
+        g_4dt_resolve_texture_cache->Dmc4ZeroCopyId(zero_copy_texture);
+  }
+  if (zero_copy_texture) {
+    for (uint32_t i = 0; i < zc_count; ++i) {
+      g_4dt_resolve_texture_cache->Dmc4ZeroCopyEndWrite(zc_targets[i].texture);
+      g_4dt_zero_copy_pending.push_back(zc_targets[i].texture);
+    }
+    gpu_stats::Add(gpu_stats::kResolveKPixels, (uint64_t(width) * height) >> 10);
+    // Guest memory is only needed by readers of other textures overlapping this range.
+    legacy_needed_out = g_overlap_read_aliases.count(alias->address) != 0;
+    return true;
+  }
+  alias->written = true;
+  if (frame_trace::Active()) {
+    char name[48];
+    std::snprintf(name, sizeof(name), "fastresolve_%08X_at%u_%u_%ux%u", alias->address, dst_x,
+                  dst_y, width, height);
+    command_processor_.TraceDumpImage(alias->image, VK_FORMAT_R32_UINT, 4, alias->width,
+                                      alias->height, alias->stage_mask, alias->access_mask,
+                                      alias->layout, name);
+  }
+  gpu_stats::Add(gpu_stats::kResolveKPixels, (uint64_t(width) * height) >> 10);
+
+  bool covers_consumed = alias->covered_x0 == 0 && alias->covered_y0 == 0 &&
+                         alias->covered_x1 >= alias->consumed_width &&
+                         alias->covered_y1 >= alias->consumed_height;
+  legacy_needed_out = mode_setting < 2 || !alias->compatible || !covers_consumed ||
+                      g_overlap_read_aliases.count(alias->address) != 0;
+  if (frame_trace::Active()) {
+    frame_trace::Line("  fast resolve %08X %ux%u src %d,%d dst %u,%u mode %u legacy %u", address,
+                      width, height, src_x, src_y, dst_x,
+                      dst_y, constants.mode, uint32_t(legacy_needed_out));
+  }
+  return true;
+}
+
