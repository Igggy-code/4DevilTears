+void OnFileOpened(uint32_t handle, const std::string& path) {
+  int mode = kModeInteractive;
+  if (EndsWithNoCase(path, ".wmv") || EndsWithNoCase(path, ".xmv")) {
+    mode = kModeMovie;
+  } else if (EndsWithNoCase(path, ".xma") && (ContainsNoCase(path, "sound\\demo\\") || ContainsNoCase(path, "sound/demo/"))) {
+    mode = kModeCutscene;
+  }
+  if (mode == kModeInteractive) return;
+  std::lock_guard<std::mutex> lock(g_scene_mutex);
+  g_scene_handles[handle] = mode;
+  int now = RecomputeLocked();
+  if (now != g_scene_mode.exchange(now)) {
+    REXKRNL_INFO("SCENE mode {} (open '{}' handle={:#x})", now, path, handle);
