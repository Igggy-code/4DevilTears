+bool Active() { return g_file != nullptr; }
+void Line(const char* format, ...) {
+  if (!g_file) return;
+  va_list args;
+  va_start(args, format);
+  std::vfprintf(g_file, format, args);
+  va_end(args);
+  std::fputc('\n', g_file);
