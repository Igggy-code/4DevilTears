+// shader's interface). Both empty (the default): nothing is looked up, the
+// translated shaders are used as they are.
+VkShaderModule VulkanPipelineCache::GetPixelShaderOverride(uint64_t ucode_hash, bool scene_pass) {
+  const std::string flat_list = REXCVAR_GET(vulkan_flat_ps);
+  const std::string override_dir = REXCVAR_GET(vulkan_shader_override_dir);
+  if (flat_list.empty() && override_dir.empty()) {
+    return VK_NULL_HANDLE;
+  }
+  std::lock_guard<std::mutex> lock(ps_override_mutex_);
+  std::string upper_list = flat_list;
+  for (char& c : upper_list) c = char(std::toupper(uint8_t(c)));
+  if (scene_pass && upper_list.find("SCENE") != std::string::npos) {
+    if (flat_pixel_shader_ == VK_NULL_HANDLE) {
+      std::vector<uint32_t> spirv;
+      std::string error;
+      if (command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_FRAGMENT_BIT,
+                                                kFlatPixelShaderSource, spirv, error)) {
+        flat_pixel_shader_ = ui::vulkan::util::CreateShaderModule(
+            command_processor_.GetVulkanDevice(), spirv.data(), spirv.size() * sizeof(uint32_t));
+      }
+      REXGPU_INFO("SHADER OVERRIDE: all 3D scene pixel shaders flat colour (test)");
+    }
+    return flat_pixel_shader_;
+  }
+  auto it = ps_overrides_.find(ucode_hash);
+  if (it != ps_overrides_.end()) {
+    return it->second;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const std::string hash_text = fmt::format("{:016X}", ucode_hash);
+  auto compile = [&](std::string_view source, const char* what) -> VkShaderModule {
+    std::vector<uint32_t> spirv;
+    std::string error;
+    if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_FRAGMENT_BIT, source, spirv,
+                                               error)) {
+      REXGPU_ERROR("SHADER OVERRIDE ps={} {}: compile failed: {}", hash_text, what, error);
+      return VK_NULL_HANDLE;
+    }
+    return ui::vulkan::util::CreateShaderModule(vulkan_device, spirv.data(),
+                                                spirv.size() * sizeof(uint32_t));
+  };
+  VkShaderModule result = VK_NULL_HANDLE;
+  if (!flat_list.empty() && upper_list.find(hash_text) != std::string::npos) {
+    if (flat_pixel_shader_ == VK_NULL_HANDLE) {
+      flat_pixel_shader_ = compile(kFlatPixelShaderSource, "flat");
+    }
+    result = flat_pixel_shader_;
+    REXGPU_INFO("SHADER OVERRIDE ps={} flat colour (test)", hash_text);
+  } else if (!override_dir.empty()) {
+    const std::string path = override_dir + "/" + hash_text + ".frag";
+    if (FILE* f = std::fopen(path.c_str(), "rb")) {
+      std::string source;
+      char buf[4096];
+      size_t n;
+      while ((n = std::fread(buf, 1, sizeof(buf), f)) > 0) source.append(buf, n);
+      std::fclose(f);
+      result = compile(source, path.c_str());
+      REXGPU_INFO("SHADER OVERRIDE ps={} from {} ({})", hash_text, path,
+                  result != VK_NULL_HANDLE ? "ok" : "failed - translated shader used");
+    }
+  }
+  ps_overrides_.emplace(ucode_hash, result);
+  return result;
+}
