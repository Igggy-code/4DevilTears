+void VulkanCommandProcessor::PassAreaBegin(bool patchable, VkExtent2D extent) {
+  ++dmc4_pass_begin_count_;
+  dmc4_clear_only_pass_ = false;
+  pass_area_patchable_ = patchable && REXCVAR_GET(vulkan_tight_render_area);
+  pass_area_extent_ = extent;
+  pass_area_x0_ = INT32_MAX;
+  pass_area_y0_ = INT32_MAX;
+  pass_area_x1_ = 0;
+  pass_area_y1_ = 0;
+}
