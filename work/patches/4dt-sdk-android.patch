+constexpr uint32_t kBurstFrames = 12;
+uint32_t g_burst_left = 0;
+std::vector<TextureRange> g_texture_ranges;
+std::vector<HostTextureDump> g_host_texture_dumps;
+}  // namespace
+bool Active() { return g_file != nullptr; }
+void Line(const char* format, ...) {
+  if (!g_file) return;
