+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+  // Initial frame laid out exactly as rex_fiber_switch restores it: all
+  // callee-saved registers zero, x30 (return address) = Trampoline, so the
+  // first switch "returns" into Trampoline with a 16-byte aligned SP.
+  uintptr_t top = reinterpret_cast<uintptr_t>(f->stack_.data() + f->stack_.size()) & ~uintptr_t(15);
