+void RenderTargetCache::GetEdramOwners(uint32_t start_tiles, uint32_t end_tiles,
+                                       std::vector<EdramOwner>& owners_out) const {
+  owners_out.clear();
+  if (start_tiles >= end_tiles) {
+    return;
+  }
+  auto it = ownership_ranges_.upper_bound(start_tiles);
+  if (it != ownership_ranges_.begin()) {
+    --it;
+  }
+  for (; it != ownership_ranges_.end() && it->first < end_tiles; ++it) {
+    uint32_t range_start = std::max(it->first, start_tiles);
+    uint32_t range_end = std::min(it->second.end_tiles, end_tiles);
+    if (range_start >= range_end) {
+      continue;
+    }
+    RenderTarget* render_target = nullptr;
+    if (!it->second.render_target.IsEmpty()) {
+      auto rt_it = render_targets_.find(it->second.render_target);
+      if (rt_it != render_targets_.end()) {
+        render_target = rt_it->second;
+      }
+    }
+    owners_out.push_back({range_start, range_end, render_target});
+  }
+}
