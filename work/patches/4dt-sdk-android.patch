+
+void VulkanSharedMemory::MarkSubmissionPages(uint32_t start, uint32_t length) {
+  if (!length) {
+    return;
+  }
+  SyncSubmissionPages();
+  uint32_t page_first = start >> page_size_log2();
+  uint32_t page_last = (start + length - 1) >> page_size_log2();
+  for (uint32_t page = page_first; page <= page_last; ++page) {
+    submission_pages_[page >> 6] |= uint64_t(1) << (page & 63);
+  }
+}
