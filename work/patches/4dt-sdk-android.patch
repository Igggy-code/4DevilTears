+void VulkanTextureCache::Dmc4ZeroCopyBeginWrite(void* texture_ptr) {
+  auto* texture = static_cast<VulkanTexture*>(texture_ptr);
+  texture->MarkAsUsed();
+  VulkanTexture::Usage old_usage = texture->SetUsage(VulkanTexture::Usage::kUndefined);
+  VkPipelineStageFlags src_stage_mask;
+  VkAccessFlags src_access_mask;
+  VkImageLayout old_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  if (!src_stage_mask) {
+    src_stage_mask = VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT;
+  }
+  // The whole image is rewritten only in the resolved rectangle - keep the rest (old layout
+  // preserved unless undefined).
+  command_processor_.PushImageMemoryBarrier(
+      texture->image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, src_access_mask, VK_ACCESS_SHADER_WRITE_BIT,
+      old_layout, VK_IMAGE_LAYOUT_GENERAL);
+  g_4dt_fragment_only_textures.erase(texture);
+}
+
+void VulkanTextureCache::Dmc4ZeroCopyEndWrite(void* texture_ptr) {
+  auto* texture = static_cast<VulkanTexture*>(texture_ptr);
+  VkPipelineStageFlags dst_stage_mask;
+  VkAccessFlags dst_access_mask;
+  VkImageLayout new_layout;
+  GetTextureUsageMasks(VulkanTexture::Usage::kGuestShaderSampled, dst_stage_mask,
+                       dst_access_mask, new_layout);
+  command_processor_.PushImageMemoryBarrier(
+      texture->image(), ui::vulkan::util::InitializeSubresourceRange(),
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, dst_stage_mask, VK_ACCESS_SHADER_WRITE_BIT,
+      dst_access_mask, VK_IMAGE_LAYOUT_GENERAL, new_layout);
+  texture->SetUsage(VulkanTexture::Usage::kGuestShaderSampled);
+}
+
+uint64_t VulkanTextureCache::Dmc4ZeroCopyId(const void* texture) {
+  auto it = g_4dt_zero_copy.find(texture);
+  return it != g_4dt_zero_copy.end() ? it->second.id : 0;
+}
+
+void VulkanTextureCache::Dmc4ZeroCopyRevalidate(void* texture_ptr) {
+  auto* texture = static_cast<VulkanTexture*>(texture_ptr);
+  auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+  texture->MakeUpToDateAndWatch(global_lock);
+}
