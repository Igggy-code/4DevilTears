+REXCVAR_DEFINE_BOOL(vulkan_merge_clear_passes, true, "GPU/Vulkan",
+                    "[4DevilTears] Clears done in their own pass right before a draw pass on the "
+                    "same images become that pass's clear load op (the clear passes do nothing)");
+
+void VulkanCommandProcessor::Dmc4AfterEndRendering() {
+  if (dmc4_clear_pending_end_) {
+    dmc4_clear_pending_end_ = false;
+    dmc4_clear_pending_.end_offset = deferred_command_buffer_.Dmc4Size();
+    if (dmc4_clear_chain_.size() >= 4) {
+      dmc4_clear_chain_.erase(dmc4_clear_chain_.begin());
+    }
+    dmc4_clear_chain_.push_back(dmc4_clear_pending_);
+  }
+}
+
+void VulkanCommandProcessor::Dmc4DrawPassBegun() {
+  dmc4_draw_chain_.clear();
+  dmc4_draw_args_ = SIZE_MAX;
+  std::vector<Dmc4ClearPass> chain;
+  chain.swap(dmc4_clear_chain_);
+  if (!REXCVAR_GET(vulkan_merge_clear_passes) || chain.empty()) {
+    return;
+  }
+  size_t args = deferred_command_buffer_.Dmc4LastBeginArgsOffset();
+  if (args == SIZE_MAX) {
+    return;
+  }
+  // Keep the clear passes directly before this one (only barriers in between).
+  size_t next_begin = args - DeferredCommandBuffer::kDmc4HeaderElements;
+  std::vector<Dmc4ClearPass> contiguous;
+  for (size_t i = chain.size(); i-- > 0;) {
+    if (chain[i].end_offset == SIZE_MAX || chain[i].submission != GetCurrentSubmission() ||
+        chain[i].image == VK_NULL_HANDLE ||
+        !deferred_command_buffer_.Dmc4OnlyBarriersBetween(chain[i].end_offset, next_begin)) {
+      break;
+    }
+    contiguous.insert(contiguous.begin(), chain[i]);
+    next_begin = chain[i].args_offset - DeferredCommandBuffer::kDmc4HeaderElements;
+  }
+  if (contiguous.empty()) {
+    return;
+  }
+  render_target_cache_->Dmc4GetLastUpdateImages(dmc4_draw_depth_image_, dmc4_draw_color_images_);
+  dmc4_draw_chain_ = std::move(contiguous);
+  dmc4_draw_args_ = args;
+}
+
+bool VulkanCommandProcessor::Dmc4MergeClearsIntoDrawPass() {
+  if (!pass_area_patchable_ || pass_area_x1_ <= pass_area_x0_ ||
+      pass_area_y1_ <= pass_area_y0_ || dmc4_draw_args_ == SIZE_MAX) {
+    return false;
+  }
+  uint32_t color_count;
+  bool has_depth, has_stencil;
+  VkRenderingAttachmentInfo* attachments = deferred_command_buffer_.Dmc4RenderingAttachments(
+      dmc4_draw_args_, color_count, has_depth, has_stencil);
+  if (!attachments) {
+    return false;
+  }
+  // Every merged clear must cover what the pass draws, all with the same rectangle (it becomes
+  // the render area - cleared in full, which is what the clear passes did).
+  const VkRect2D* area = nullptr;
+  struct Match {
+    VkRenderingAttachmentInfo* attachment;
+    const Dmc4ClearPass* clear;
+  };
+  Match matches[6];
+  uint32_t match_count = 0;
+  for (const Dmc4ClearPass& clear : dmc4_draw_chain_) {
+    if (area && (clear.rect.offset.x != area->offset.x || clear.rect.offset.y != area->offset.y ||
+                 clear.rect.extent.width != area->extent.width ||
+                 clear.rect.extent.height != area->extent.height)) {
+      return false;
+    }
+    if (pass_area_x0_ < clear.rect.offset.x || pass_area_y0_ < clear.rect.offset.y ||
+        pass_area_x1_ > clear.rect.offset.x + int32_t(clear.rect.extent.width) ||
+        pass_area_y1_ > clear.rect.offset.y + int32_t(clear.rect.extent.height)) {
+      return false;
+    }
+    bool found = false;
+    if (clear.depth) {
+      if (has_depth && clear.image == dmc4_draw_depth_image_) {
+        matches[match_count++] = {&attachments[color_count], &clear};
+        if (has_stencil) {
+          matches[match_count++] = {&attachments[color_count + 1], &clear};
+        }
+        found = true;
+      }
+    } else {
+      for (uint32_t i = 0; i < color_count && i < 4; ++i) {
+        if (attachments[i].imageView != VK_NULL_HANDLE &&
+            clear.image == dmc4_draw_color_images_[i]) {
+          matches[match_count++] = {&attachments[i], &clear};
+          found = true;
+          break;
+        }
+      }
+    }
+    if (!found) {
+      return false;  // a clear of an image this pass doesn't attach - keep everything as is
+    }
+    area = &clear.rect;
+  }
+  if (!area || !match_count) {
+    return false;
+  }
+  for (uint32_t i = 0; i < match_count; ++i) {
+    matches[i].attachment->loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+    matches[i].attachment->clearValue = matches[i].clear->value;
+  }
+  // The clear passes neither load nor store now.
+  for (const Dmc4ClearPass& clear : dmc4_draw_chain_) {
+    uint32_t cc;
+    bool hd, hs;
+    VkRenderingAttachmentInfo* a =
+        deferred_command_buffer_.Dmc4RenderingAttachments(clear.args_offset, cc, hd, hs);
+    if (a) {
+      for (uint32_t i = 0; i < cc + uint32_t(hd) + uint32_t(hs); ++i) {
+        a[i].storeOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+      }
+    }
+  }
+  deferred_command_buffer_.Dmc4PatchRenderArea(dmc4_draw_args_, *area);
+  gpu_stats::Add(gpu_stats::kTightPasses, 1);
+  static uint32_t logged = 0;
+  if (logged < 4) {
+    ++logged;
+    REXGPU_INFO("Clear passes merged into the draw pass: {} clear(s), area {}x{} at {},{}",
+                dmc4_draw_chain_.size(), area->extent.width, area->extent.height,
+                area->offset.x, area->offset.y);
+  }
+  return true;
+}
