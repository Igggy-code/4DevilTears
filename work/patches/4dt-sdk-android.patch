+// [4deviltears] Consecutive render pass / dynamic rendering instances on the same
+// attachments: the render target usage tracking sees "attachment -> attachment" and skips
+// the barrier, but without one the stores of the previous instance and the loads/stores of
+// the next are unordered. On tile-based GPUs that let a transfer instance's store of a few
+// tiles land after the following draw instance (Mali-G78: the top EDRAM tiles of the frame
+// kept the transferred bloom data - a flickering band).
+void VulkanCommandProcessor::EmitAttachmentPassBarrierIfNeeded(bool next_is_transfer) {
+  // The images of the pass being started become the current ones.
+  bool shared = false;
+  for (VkImage a : next_pass_images_) {
+    if (a == VK_NULL_HANDLE) continue;
+    for (VkImage b : ended_pass_images_) {
+      if (a == b) shared = true;
+    }
+  }
+  bool unknown = next_pass_images_[0] == VK_NULL_HANDLE;
+  std::memcpy(pass_images_, next_pass_images_, sizeof(pass_images_));
+  std::memset(next_pass_images_, 0, sizeof(next_pass_images_));
+  bool was_transfer = ended_pass_is_transfer_;
+  pass_is_transfer_ = next_is_transfer;
+  // Passes attaching the image through the same views are ordered by the driver; a pass
+  // through a different view (transfer format <-> draw format) is where Mali-G78 didn't.
+  if (!attachment_pass_barrier_needed_ || !REXCVAR_GET(vulkan_pass_to_pass_barrier) ||
+      (!shared && !unknown) || (!unknown && !was_transfer && !next_is_transfer &&
+                                !REXCVAR_GET(vulkan_pass_to_pass_barrier_all))) {
+    attachment_pass_barrier_needed_ = false;
+    return;
+  }
+  attachment_pass_barrier_needed_ = false;
+  gpu_stats::Add(gpu_stats::kPassBarriers, 1);
+  VkMemoryBarrier barrier = {};
+  barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+  barrier.srcAccessMask =
+      VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+  barrier.dstAccessMask =
+      VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT |
+      VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+  VkPipelineStageFlags stages = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT |
+                                VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT |
+                                VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT;
+  // Same pixels of the same attachments only: framebuffer-local (cheap on tilers).
+  deferred_command_buffer_.CmdVkPipelineBarrier(stages, stages, VK_DEPENDENCY_BY_REGION_BIT, 1,
+                                                &barrier, 0, nullptr, 0, nullptr);
+}
