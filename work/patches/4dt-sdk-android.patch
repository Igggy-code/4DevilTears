+
+void VulkanCommandProcessor::ProfileReport() {
+  if (!REXCVAR_GET(gpu_profile)) {
+    return;
+  }
+  if (++profile_report_frames_ < 120) {
+    return;
+  }
+  double frames = double(profile_report_frames_);
+  profile_report_frames_ = 0;
+  std::vector<std::pair<std::string, std::pair<double, uint64_t>>> entries(
+      profile_totals_.begin(), profile_totals_.end());
+  std::sort(entries.begin(), entries.end(), [](const auto& a, const auto& b) {
+    return a.second.first > b.second.first;
+  });
+  double total = 0.0;
+  for (const auto& entry : entries) total += entry.second.first;
+  REXGPU_INFO("PROF total {:.2f} ms/frame in {} kinds of segments", total / frames / 1000.0,
+              entries.size());
+  for (size_t i = 0; i < std::min(entries.size(), size_t(20)); ++i) {
+    REXGPU_INFO("PROF {:7.2f} ms/frame  x{:5.1f}/frame  draws {:6.1f}/frame  {}",
+                entries[i].second.first / frames / 1000.0,
+                double(profile_counts_[entries[i].first]) / frames,
+                double(entries[i].second.second) / frames, entries[i].first);
+  }
+  profile_totals_.clear();
+  profile_counts_.clear();
+}
