+}  // namespace
+
+bool On() { return g_on.load(std::memory_order_relaxed); }
+
+void Line(const std::string& text) {
+  std::lock_guard<std::mutex> lock(g_file_mutex);
+  if (!g_file) return;
+  std::fprintf(g_file, "%8lld %s\n", (long long)Ms(), text.c_str());
+}
+
+void Sync(const char* what, uint32_t object, uint32_t extra) {
+  if (!On()) return;
+  if (object < 0x82000000u || object >= 0x83000000u) return;  // the game's static data only
+  uint32_t tid = 0, lr = 0;
+  if (auto* thread = rex::system::XThread::GetCurrentThread()) tid = thread->thread_id();
+  if (auto* ts = rex::runtime::ThreadState::Get()) {
+    if (ts->context()) lr = uint32_t(ts->context()->lr);
+  }
+  // The same call from the same place repeats every few ms (audio callbacks): one line per
+  // 250 ms with the number of repeats.
+  static std::mutex sync_mutex;
+  static std::unordered_map<uint64_t, std::pair<int64_t, uint32_t>> last;
+  const uint64_t key = (uint64_t(object) << 32) ^ (uint64_t(lr) << 8) ^ tid ^
+                       (uint64_t(reinterpret_cast<uintptr_t>(what)) << 3);
+  const int64_t now = NowUs();
+  uint32_t repeats = 0;
+  {
+    std::lock_guard<std::mutex> lock(sync_mutex);
+    auto& entry = last[key];
+    if (entry.first && now - entry.first < 250000) {
+      ++entry.second;
+      return;
+    }
+    repeats = entry.second;
+    entry = {now, 0};
+  }
+  Line(fmt::format("SYNC {} obj {:08X} {:X} t{:X} lr {:08X}{}", what, object, extra, tid, lr,
+                   repeats ? fmt::format(" (+{} since)", repeats) : std::string()));
+}
+
+void AddTick(TickFn fn, void* user) {
+  std::lock_guard<std::mutex> lock(g_tick_mutex);
+  g_ticks.emplace_back(fn, user);
+}
+
+WaitScope::WaitScope(const char* kind, uint32_t object, uint32_t type, uint32_t count,
+                     bool infinite) {
+  Slot* s = MySlot();
+  if (!s) return;
+  s->kind = kind;
+  s->object = object;
+  s->type = type;
+  s->count = count;
+  s->infinite = infinite;
+  PPCContext* ctx = s->ctx.load();
+  s->lr = ctx ? uint32_t(ctx->lr) : 0u;
+  s->since_us = NowUs();
+  if (On() && rex::thread::GlobalLockOwnerTid() == int(syscall(SYS_gettid))) {
+    Line(fmt::format("WAIT-GLOCK t{:X} lr {:08X} {} obj {:08X}", s->thread_id.load(), s->lr.load(),
+                     kind, object));
+  }
+  active_ = true;
+  slot_ = reinterpret_cast<uint64_t>(s);
+}
+
+WaitScope::~WaitScope() {
+  if (!active_) return;
+  Slot* s = reinterpret_cast<Slot*>(slot_);
+  const int64_t since = s->since_us.exchange(0);
+  if (On() && since && s->reported_since.load() == since) {
+    Line(fmt::format("WAIT-END t{:X} obj {:08X} after {}ms", s->thread_id.load(), s->object.load(),
+                     (NowUs() - since) / 1000));
+  }
+}
+
+}  // namespace rex::dmc4rec
+
+using namespace rex::dmc4rec;
+
+extern "C" void Rex4dtRecStart(const char* path) {
+  if (On()) return;
+  {
+    std::lock_guard<std::mutex> lock(g_file_mutex);
+    g_file = path && *path ? std::fopen(path, "w") : nullptr;
+    if (!g_file) return;
+    g_start = std::chrono::steady_clock::now();
+  }
+  g_on.store(true);
+  Line("REC start");
+  {
+    std::lock_guard<std::mutex> lock(g_watch_mutex);
+    g_watch_stop = false;
+  }
+  if (!g_watchdog.joinable()) g_watchdog = std::thread(WatchdogMain);
+}
+
+extern "C" void Rex4dtRecStop() {
+  if (!On()) return;
+  Line("REC stop");
+  g_on.store(false);
+  {
+    std::lock_guard<std::mutex> lock(g_watch_mutex);
+    g_watch_stop = true;
+  }
+  g_watch_cv.notify_all();
+  if (g_watchdog.joinable()) g_watchdog.join();
+  std::lock_guard<std::mutex> lock(g_file_mutex);
+  if (g_file) {
+    std::fclose(g_file);
+    g_file = nullptr;
+  }
+}
+
+extern "C" void Rex4dtRecNote(const char* text) {
+  if (On() && text) Line(std::string("NOTE ") + text);
+}
