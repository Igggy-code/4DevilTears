+void VulkanCommandProcessor::TraceDumpImage(VkImage image, VkFormat format,
+                                            uint32_t bytes_per_pixel, uint32_t width,
+                                            uint32_t height, VkPipelineStageFlags stage,
+                                            VkAccessFlags access, VkImageLayout layout,
+                                            const char* name) {
+  static uint32_t frame = UINT32_MAX, count = 0;
+  if (!REXCVAR_GET(frame_trace_texture_dumps) || !frame_trace::Active() ||
+      image == VK_NULL_HANDLE || !width || !height ||
+      layout == VK_IMAGE_LAYOUT_UNDEFINED) {
+    return;
+  }
+  if (frame != frame_trace::FrameSerial()) {
+    frame = frame_trace::FrameSerial();
+    count = 0;
+  }
+  if (count >= 64) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  VkImageCreateInfo info = {};
+  info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+  info.imageType = VK_IMAGE_TYPE_2D;
+  info.format = format;
+  info.extent = {width, height, 1};
+  info.mipLevels = 1;
+  info.arrayLayers = 1;
+  info.samples = VK_SAMPLE_COUNT_1_BIT;
+  info.tiling = VK_IMAGE_TILING_LINEAR;
+  info.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+  info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  VkImage dump_image;
+  VkDeviceMemory dump_memory;
+  if (!ui::vulkan::util::CreateDedicatedAllocationImage(vulkan_device, info,
+                                                        ui::vulkan::util::MemoryPurpose::kReadback,
+                                                        dump_image, dump_memory)) {
+    REXGPU_WARN("frame_trace: no linear {}x{} image (format {}) for {}", width, height,
+                uint32_t(format), name);
+    return;
+  }
+  VkImageSubresourceRange range = ui::vulkan::util::InitializeSubresourceRange();
+  PushImageMemoryBarrier(image, range, stage, VK_PIPELINE_STAGE_TRANSFER_BIT, access,
+                         VK_ACCESS_TRANSFER_READ_BIT, layout,
+                         VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  PushImageMemoryBarrier(dump_image, range, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                         VK_PIPELINE_STAGE_TRANSFER_BIT, 0, VK_ACCESS_TRANSFER_WRITE_BIT,
+                         VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+  SubmitBarriers(true);
+  VkImageCopy region = {};
+  region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  region.srcSubresource.layerCount = 1;
+  region.dstSubresource = region.srcSubresource;
+  region.extent = {width, height, 1};
+  deferred_command_buffer_.CmdVkCopyImage(image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                          dump_image, VK_IMAGE_LAYOUT_GENERAL, region);
+  PushImageMemoryBarrier(image, range, VK_PIPELINE_STAGE_TRANSFER_BIT, stage,
+                         VK_ACCESS_TRANSFER_READ_BIT, access,
+                         VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, layout);
+  PushImageMemoryBarrier(dump_image, range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                         VK_ACCESS_HOST_READ_BIT, VK_IMAGE_LAYOUT_GENERAL,
+                         VK_IMAGE_LAYOUT_GENERAL, VK_QUEUE_FAMILY_IGNORED,
+                         VK_QUEUE_FAMILY_IGNORED, false);
+  SubmitBarriers(true);
+  frame_trace::HostTextureDump dump;
+  dump.buffer = uint64_t(dump_image);
+  dump.memory = uint64_t(dump_memory);
+  dump.size = 0;
+  dump.image_width = width;
+  dump.image_height = height;
+  dump.image_bpp = bytes_per_pixel;
+  std::snprintf(dump.name, sizeof(dump.name), "img_%03u_d%05u_%s_%ux%u_vk%u.bin", count,
+                frame_trace::PeekDrawIndex(), name, width, height, uint32_t(format));
+  frame_trace::AddHostTextureDump(dump);
+  frame_trace::Line("I img_%03u %s %ux%u", count, name, width, height);
+  ++count;
+}
+
+void VulkanCommandProcessor::ProfileMark(uint16_t kind, uint32_t width, uint32_t height) {
+  if (!profile_active_ || profile_segments_.size() >= kProfileMarksPerSubmission - 1) {
+    return;
+  }
+  uint32_t base = uint32_t(GetCurrentSubmission() % kProfileSlots) * kProfileMarksPerSubmission;
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                               profile_query_pool_,
+                                               base + uint32_t(profile_segments_.size()));
+  ProfileSegment segment = {};
+  segment.kind = kind;
