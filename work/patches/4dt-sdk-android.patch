+void BandCollapseOnFrame() {
+  g_band_collapse.OnFrame();
+  // Only while the last frame had tiled bands to collapse.
+  bool ready = false;
+  for (const auto& entry : g_band_collapse.configs_previous) {
+    ready |= g_band_collapse.Ready(entry.second);
+  }
+  g_4dt_predication_all_bins = REXCVAR_GET(collapse_predicated_tiling) && ready;
+}
