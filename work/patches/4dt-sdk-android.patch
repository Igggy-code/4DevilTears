+// Guest EDRAM encoding of a clear value for a render target format (same encoding as
+// RB_COLOR_CLEAR / RB_DEPTH_CLEAR). NaN behaves like the GPU's float -> UNORM (0).
+bool PackHleClearValue(bool is_depth, uint32_t format, const float* color, float depth,
+                       uint32_t stencil, uint64_t& value_out) {
+  if (is_depth) {
+    uint32_t d24 = xenos::DepthRenderTargetFormat(format) == xenos::DepthRenderTargetFormat::kD24FS8
+                       ? xenos::Float32To20e4(depth, true)
+                       : uint32_t(std::lround(depth * float(0xFFFFFF)));
+    value_out = (uint64_t(d24 & 0xFFFFFF) << 8) | (stencil & 0xFF);
+    return true;
+  }
+  auto c = [&](uint32_t i, float scale) {
+    float v = std::isnan(color[i]) ? 0.0f : std::clamp(color[i], 0.0f, 1.0f);
+    return uint64_t(std::lround(v * scale));
+  };
+  switch (xenos::ColorRenderTargetFormat(format)) {
+    case xenos::ColorRenderTargetFormat::k_8_8_8_8:
+      value_out = c(0, 255.0f) | (c(1, 255.0f) << 8) | (c(2, 255.0f) << 16) | (c(3, 255.0f) << 24);
+      return true;
+    case xenos::ColorRenderTargetFormat::k_2_10_10_10:
+    case xenos::ColorRenderTargetFormat::k_2_10_10_10_AS_10_10_10_10:
+      value_out =
+          c(0, 1023.0f) | (c(1, 1023.0f) << 10) | (c(2, 1023.0f) << 20) | (c(3, 3.0f) << 30);
+      return true;
+    default:
+      return false;
+  }
+}
