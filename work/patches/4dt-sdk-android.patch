+  optimizer.RegisterPerformancePasses();
+  spvtools::OptimizerOptions options;
+  options.set_run_validator(false);
+  const uint32_t* words = reinterpret_cast<const uint32_t*>(module_bytes.data());
+  size_t word_count = module_bytes.size() / sizeof(uint32_t);
+  std::vector<uint32_t> optimized;
+  auto start = std::chrono::steady_clock::now();
+  if (!optimizer.Run(words, word_count, &optimized, options) || optimized.empty()) {
+    REXGPU_WARN("SPIR-V optimizer failed; using the unoptimized shader");
+    return;
+  }
+  auto us = std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now() - start)
+                .count();
+  REXGPU_INFO("SPVOPT {} -> {} words in {} us", word_count, optimized.size(), us);
+  module_bytes.assign(reinterpret_cast<const uint8_t*>(optimized.data()),
+                      reinterpret_cast<const uint8_t*>(optimized.data() + optimized.size()));
+}
