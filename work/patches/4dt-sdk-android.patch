+ * every 4x4 block on Mali (a regular lattice over smooth textures - the menu "grid").
+ *
+ * Same interface as the Xenia texture load shaders: set 0 binding 0 - destination
+ * storage buffer, set 1 binding 0 - source (guest memory) storage buffer, push
+ * constants = TextureCache::LoadConstants, local size 4x32, every invocation handles
+ * (1 << BLOCKS_PER_THREAD_LOG2) blocks along X and one block row.
+ */
+#pragma once
+
+#include <string>
+#include <string_view>
+
+namespace rex::graphics::vulkan::bc_decode {
+
+enum class Format { kDXT1, kDXT3, kDXT5, kDXT5A, kDXN, kCTX1 };
+
+inline std::string GetShaderSource(Format format, unsigned blocks_per_thread_log2) {
+  std::string defines = "#version 450\n#define BLOCKS_PER_THREAD_LOG2 " +
+                        std::to_string(blocks_per_thread_log2) + "u\n";
+  switch (format) {
+    case Format::kDXT1: defines += "#define FORMAT_DXT1 1\n"; break;
+    case Format::kDXT3: defines += "#define FORMAT_DXT3 1\n"; break;
+    case Format::kDXT5: defines += "#define FORMAT_DXT5 1\n"; break;
+    case Format::kDXT5A: defines += "#define FORMAT_DXT5A 1\n"; break;
+    case Format::kDXN: defines += "#define FORMAT_DXN 1\n"; break;
+    case Format::kCTX1: defines += "#define FORMAT_CTX1 1\n"; break;
+  }
+  static constexpr std::string_view kBody = R"(
+layout(local_size_x = 4, local_size_y = 32, local_size_z = 1) in;
+layout(set = 0, binding = 0) writeonly buffer Dest { uint dest[]; };
+layout(set = 1, binding = 0) readonly buffer Source { uint source[]; };
+layout(push_constant) uniform LoadConstants {
+  uint is_tiled_3d_endian_scale;
+  uint guest_offset;
+  uint guest_pitch_aligned;
+  uint guest_z_stride_block_rows_aligned;
+  uvec3 size_blocks;
+  uint host_offset;
+  uint host_pitch;
+  uint height_texels;
+} c;
+
+#if defined(FORMAT_DXT1) || defined(FORMAT_DXT5A) || defined(FORMAT_CTX1)
+const uint kBlockBytesLog2 = 3u;
+#else
+const uint kBlockBytesLog2 = 4u;
+#endif
+
+uint TiledOffset2D(uint x, uint y, uint pitch, uint bpb_log2) {
+  uint macro_offset = ((x >> 5u) + (y >> 5u) * (pitch >> 5u)) << (bpb_log2 + 7u);
+  uint micro_offset = ((x & 7u) + ((y & 0xEu) << 2u)) << bpb_log2;
+  uint offset = macro_offset + ((micro_offset & ~0xFu) << 1u) + (micro_offset & 0xFu) +
+                ((y & 1u) << 4u);
+  return ((offset & ~0x1FFu) << 3u) + ((y & 16u) << 7u) + ((offset & 0x1C0u) << 2u) +
+         (((((y & 8u) >> 2u) + (x >> 3u)) & 3u) << 6u) + (offset & 0x3Fu);
+}
+
+uint Swap(uint v, uint endian) {
+  if (endian == 1u) {
+    return ((v & 0x00FF00FFu) << 8u) | ((v >> 8u) & 0x00FF00FFu);
+  }
+  if (endian == 2u) {
+    return (v << 24u) | ((v & 0xFF00u) << 8u) | ((v >> 8u) & 0xFF00u) | (v >> 24u);
+  }
+  if (endian == 3u) {
+    return (v << 16u) | (v >> 16u);
+  }
+  return v;
+}
+
+uvec3 Rgb565(uint c) {
+  uint r = (c >> 11u) & 31u, g = (c >> 5u) & 63u, b = c & 31u;
+  return uvec3((r << 3u) | (r >> 2u), (g << 2u) | (g >> 4u), (b << 3u) | (b >> 2u));
+}
+
+// Color part of DXT1/3/5: 4 rows of 4 RGBA8 texels packed (alpha 255, or 0 for the
+// DXT1 transparent index).
+void DecodeColor(uint endpoints, uint indices, bool allow_3_color, out uint texels[16]) {
+  uint c0 = endpoints & 0xFFFFu, c1 = endpoints >> 16u;
+  uvec3 p0 = Rgb565(c0), p1 = Rgb565(c1);
+  uint palette[4];
+  palette[0] = p0.r | (p0.g << 8u) | (p0.b << 16u) | 0xFF000000u;
+  palette[1] = p1.r | (p1.g << 8u) | (p1.b << 16u) | 0xFF000000u;
+  if (!allow_3_color || c0 > c1) {
+    uvec3 p2 = (2u * p0 + p1 + 1u) / 3u, p3 = (p0 + 2u * p1 + 1u) / 3u;
+    palette[2] = p2.r | (p2.g << 8u) | (p2.b << 16u) | 0xFF000000u;
+    palette[3] = p3.r | (p3.g << 8u) | (p3.b << 16u) | 0xFF000000u;
+  } else {
+    uvec3 p2 = (p0 + p1 + 1u) / 2u;
+    palette[2] = p2.r | (p2.g << 8u) | (p2.b << 16u) | 0xFF000000u;
+    palette[3] = 0u;
+  }
+  for (uint i = 0u; i < 16u; ++i) {
+    texels[i] = palette[(indices >> (2u * i)) & 3u];
+  }
+}
+
+// DXT5-style alpha block (also DXT5A, DXN channels): 16 values 0...255.
+void DecodeAlpha(uint w0, uint w1, out uint values[16]) {
+  uint a0 = w0 & 0xFFu, a1 = (w0 >> 8u) & 0xFFu;
+  uint palette[8];
+  palette[0] = a0;
+  palette[1] = a1;
+  if (a0 > a1) {
+    for (uint i = 1u; i < 7u; ++i) {
+      palette[1u + i] = ((7u - i) * a0 + i * a1 + 3u) / 7u;
+    }
+  } else {
+    for (uint i = 1u; i < 5u; ++i) {
+      palette[1u + i] = ((5u - i) * a0 + i * a1 + 2u) / 5u;
+    }
+    palette[6] = 0u;
+    palette[7] = 255u;
+  }
+  // 48 index bits: w0 >> 16 (16 bits) then w1 (32 bits).
+  for (uint i = 0u; i < 16u; ++i) {
+    uint bit = 16u + 3u * i;
+    uint index;
+    if (bit + 3u <= 32u) {
+      index = (w0 >> bit) & 7u;
+    } else if (bit >= 32u) {
+      index = (w1 >> (bit - 32u)) & 7u;
+    } else {
+      index = ((w0 >> bit) | (w1 << (32u - bit))) & 7u;
+    }
+    values[i] = palette[index];
+  }
+}
+
+void main() {
+  uint block_y = gl_GlobalInvocationID.y;
+  if (block_y >= c.size_blocks.y) {
+    return;
+  }
+  uint z = gl_GlobalInvocationID.z;
+  bool tiled = (c.is_tiled_3d_endian_scale & 1u) != 0u;
+  uint endian = (c.is_tiled_3d_endian_scale >> 2u) & 3u;
+  uint blocks_per_thread = 1u << BLOCKS_PER_THREAD_LOG2;
+  for (uint b = 0u; b < blocks_per_thread; ++b) {
+    uint block_x = (gl_GlobalInvocationID.x << BLOCKS_PER_THREAD_LOG2) + b;
+    if (block_x >= c.size_blocks.x) {
+      break;
+    }
+    uint guest_address;
+    if (tiled) {
+      guest_address = c.guest_offset +
+                      TiledOffset2D(block_x, block_y + z * c.guest_z_stride_block_rows_aligned,
+                                    c.guest_pitch_aligned, kBlockBytesLog2);
+    } else {
+      guest_address = c.guest_offset + (block_y + z * c.guest_z_stride_block_rows_aligned) *
+                                           c.guest_pitch_aligned + (block_x << kBlockBytesLog2);
+    }
+    uint word = guest_address >> 2u;
+    uint w0 = Swap(source[word], endian);
+    uint w1 = Swap(source[word + 1u], endian);
+#if !defined(FORMAT_DXT1) && !defined(FORMAT_DXT5A) && !defined(FORMAT_CTX1)
+    uint w2 = Swap(source[word + 2u], endian);
+    uint w3 = Swap(source[word + 3u], endian);
+#endif
+    uint texel_y = block_y * 4u;
+    uint host_rows = c.height_texels;
+
+#if defined(FORMAT_DXT1) || defined(FORMAT_DXT3) || defined(FORMAT_DXT5)
+    uint texels[16];
+#if defined(FORMAT_DXT1)
+    DecodeColor(w0, w1, true, texels);
+#else
+    DecodeColor(w2, w3, false, texels);
+#endif
+#if defined(FORMAT_DXT3)
+    for (uint i = 0u; i < 16u; ++i) {
+      uint a = ((i < 8u ? w0 : w1) >> ((i & 7u) * 4u)) & 0xFu;
+      texels[i] = (texels[i] & 0x00FFFFFFu) | ((a * 17u) << 24u);
+    }
+#elif defined(FORMAT_DXT5)
+    uint alpha[16];
+    DecodeAlpha(w0, w1, alpha);
+    for (uint i = 0u; i < 16u; ++i) {
+      texels[i] = (texels[i] & 0x00FFFFFFu) | (alpha[i] << 24u);
+    }
+#endif
+    for (uint row = 0u; row < 4u && texel_y + row < c.height_texels; ++row) {
+      uint offset = c.host_offset + (z * host_rows + texel_y + row) * c.host_pitch +
+                    block_x * 16u;
+      uint index = offset >> 2u;
+      dest[index] = texels[row * 4u];
+      dest[index + 1u] = texels[row * 4u + 1u];
+      dest[index + 2u] = texels[row * 4u + 2u];
+      dest[index + 3u] = texels[row * 4u + 3u];
+    }
+#elif defined(FORMAT_DXT5A)
+    uint values[16];
+    DecodeAlpha(w0, w1, values);
+    for (uint row = 0u; row < 4u && texel_y + row < c.height_texels; ++row) {
+      uint offset = c.host_offset + (z * host_rows + texel_y + row) * c.host_pitch +
+                    block_x * 4u;
+      dest[offset >> 2u] = values[row * 4u] | (values[row * 4u + 1u] << 8u) |
+                           (values[row * 4u + 2u] << 16u) | (values[row * 4u + 3u] << 24u);
+    }
+#elif defined(FORMAT_DXN)
+    uint red[16], green[16];
+    DecodeAlpha(w0, w1, red);
+    DecodeAlpha(w2, w3, green);
+    for (uint row = 0u; row < 4u && texel_y + row < c.height_texels; ++row) {
+      uint offset = c.host_offset + (z * host_rows + texel_y + row) * c.host_pitch +
+                    block_x * 8u;
+      uint i = row * 4u;
+      dest[offset >> 2u] = red[i] | (green[i] << 8u) | (red[i + 1u] << 16u) |
+                           (green[i + 1u] << 24u);
+      dest[(offset >> 2u) + 1u] = red[i + 2u] | (green[i + 2u] << 8u) |
+                                  (red[i + 3u] << 16u) | (green[i + 3u] << 24u);
+    }
+#elif defined(FORMAT_CTX1)
+    uvec2 e0 = uvec2(w0 & 0xFFu, (w0 >> 8u) & 0xFFu);
+    uvec2 e1 = uvec2((w0 >> 16u) & 0xFFu, w0 >> 24u);
+    uvec2 palette[4];
+    palette[0] = e0;
+    palette[1] = e1;
+    palette[2] = (2u * e0 + e1 + 1u) / 3u;
+    palette[3] = (e0 + 2u * e1 + 1u) / 3u;
+    for (uint row = 0u; row < 4u && texel_y + row < c.height_texels; ++row) {
+      uint offset = c.host_offset + (z * host_rows + texel_y + row) * c.host_pitch +
+                    block_x * 8u;
+      uint packed[2];
+      for (uint h = 0u; h < 2u; ++h) {
+        uvec2 t0 = palette[(w1 >> (2u * (row * 4u + h * 2u))) & 3u];
+        uvec2 t1 = palette[(w1 >> (2u * (row * 4u + h * 2u + 1u))) & 3u];
+        packed[h] = t0.x | (t0.y << 8u) | (t1.x << 16u) | (t1.y << 24u);
+      }
+      dest[offset >> 2u] = packed[0];
+      dest[(offset >> 2u) + 1u] = packed[1];
+    }
+#endif
+  }
+}
+)";
+  return defines + std::string(kBody);
+}
+
+}  // namespace rex::graphics::vulkan::bc_decode
