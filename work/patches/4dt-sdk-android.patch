+void VulkanCommandProcessor::PassAreaAddScissor() {
+  const VkRect2D& r = dynamic_scissor_;
+  int32_t x0 = r.offset.x, y0 = r.offset.y;
+  int32_t x1 = x0 + int32_t(r.extent.width), y1 = y0 + int32_t(r.extent.height);
