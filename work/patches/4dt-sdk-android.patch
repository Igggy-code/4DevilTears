+void VulkanPipelineCache::InitializeVkPipelineCache(const std::filesystem::path& directory) {
+  ShutdownVkPipelineCache();
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  vk_pipeline_cache_path_ = directory / "vk_pipeline_cache.bin";
+  std::vector<uint8_t> data;
+  if (FILE* file = rex::filesystem::OpenFile(vk_pipeline_cache_path_, "rb")) {
+    rex::filesystem::Seek(file, 0, SEEK_END);
+    int64_t size = rex::filesystem::Tell(file);
+    rex::filesystem::Seek(file, 0, SEEK_SET);
+    if (size > 0 && size < (int64_t(1) << 30)) {
+      data.resize(size_t(size));
+      if (fread(data.data(), 1, data.size(), file) != data.size()) {
+        data.clear();
+      }
+    }
+    fclose(file);
+  }
+  VkPipelineCacheCreateInfo create_info = {};
+  create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+  create_info.initialDataSize = data.size();
+  create_info.pInitialData = data.empty() ? nullptr : data.data();
+  if (dfn.vkCreatePipelineCache(vulkan_device->device(), &create_info, nullptr,
+                                &vk_pipeline_cache_) != VK_SUCCESS) {
+    // Incompatible / corrupt data (driver update) - start empty.
+    create_info.initialDataSize = 0;
+    create_info.pInitialData = nullptr;
+    if (dfn.vkCreatePipelineCache(vulkan_device->device(), &create_info, nullptr,
+                                  &vk_pipeline_cache_) != VK_SUCCESS) {
+      vk_pipeline_cache_ = VK_NULL_HANDLE;
+    }
+  }
+  vk_pipelines_since_save_ = 0;
+  vk_pipeline_cache_last_save_ms_ = rex::chrono::Clock::QueryHostUptimeMillis();
+  REXGPU_INFO("VulkanPipelineCache: driver pipeline cache {} ({} bytes loaded)",
+              vk_pipeline_cache_ != VK_NULL_HANDLE ? "ready" : "unavailable", data.size());
+}
+
+void VulkanPipelineCache::SaveVkPipelineCache(bool force) {
+  if (vk_pipeline_cache_ == VK_NULL_HANDLE || vk_pipeline_cache_path_.empty()) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(vk_pipeline_cache_save_mutex_);
+  uint64_t now_ms = rex::chrono::Clock::QueryHostUptimeMillis();
+  if (!force && (!vk_pipelines_since_save_ || now_ms - vk_pipeline_cache_last_save_ms_ < 5000)) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  size_t size = 0;
+  if (dfn.vkGetPipelineCacheData(vulkan_device->device(), vk_pipeline_cache_, &size, nullptr) !=
+          VK_SUCCESS ||
+      !size) {
+    return;
+  }
+  std::vector<uint8_t> data(size);
+  if (dfn.vkGetPipelineCacheData(vulkan_device->device(), vk_pipeline_cache_, &size,
+                                 data.data()) != VK_SUCCESS) {
+    return;
+  }
+  std::filesystem::path temp_path = vk_pipeline_cache_path_;
+  temp_path += ".tmp";
+  if (FILE* file = rex::filesystem::OpenFile(temp_path, "wb")) {
+    bool ok = fwrite(data.data(), 1, size, file) == size;
+    fclose(file);
+    std::error_code ec;
+    if (ok) {
+      std::filesystem::rename(temp_path, vk_pipeline_cache_path_, ec);
+    }
+  }
+  vk_pipelines_since_save_ = 0;
+  vk_pipeline_cache_last_save_ms_ = now_ms;
+}
+
+void VulkanPipelineCache::FlushVkPipelineCacheIfPending() {
+  if (!vk_pipelines_since_save_.load(std::memory_order_relaxed)) {
+    return;
+  }
+  uint64_t now_ms = rex::chrono::Clock::QueryHostUptimeMillis();
+  if (now_ms - vk_pipeline_cache_last_save_ms_ < 1000) {
+    return;
+  }
+  SaveVkPipelineCache(true);
+}
+
+void VulkanPipelineCache::ShutdownVkPipelineCache() {
+  if (vk_pipeline_cache_ == VK_NULL_HANDLE) {
+    return;
+  }
+  SaveVkPipelineCache(true);
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  vulkan_device->functions().vkDestroyPipelineCache(vulkan_device->device(), vk_pipeline_cache_,
+                                                    nullptr);
+  vk_pipeline_cache_ = VK_NULL_HANDLE;
+}
