+uint32_t NextDrawIndex() { return g_draw_index++; }
+uint32_t PeekDrawIndex() { return g_draw_index; }
+uint32_t g_frame_serial = 0;
+uint32_t FrameSerial() { return g_frame_serial; }
+// Raw guest bytes of the base level (and packed mips) of each texture used in the
+// traced frame, for offline untiling/decoding: <dir>/tex/<6 fetch dwords>.bin.
+void DumpGuestTexture(memory::Memory* memory, const uint32_t* fetch) {
+  if (!g_file || !memory) return;
+  static std::unordered_set<uint32_t> dumped;
+  const uint32_t base = (fetch[1] >> 12) << 12;
+  if (!base || !dumped.insert(base ^ (fetch[1] & 0x3F) ^ (fetch[2] << 6)).second) return;
+  const uint32_t format = fetch[1] & 0x3F;
+  uint32_t bw = 1, bpb = 4;
+  switch (format) {
+    case 2: case 8: case 9: bpb = 1; break;
+    case 3: case 4: case 5: case 10: case 15: case 24: case 27: bpb = 2; break;
+    case 18: case 59: case 60: bw = 4; bpb = 8; break;
+    case 19: case 20: case 49: bw = 4; bpb = 16; break;
+    case 26: case 29: case 31: case 32: bpb = 8; break;
+    case 34: bpb = 16; break;
+    default: break;
+  }
+  const uint32_t dim = (fetch[5] >> 9) & 3;
+  const uint32_t pitch_px = ((fetch[0] >> 22) & 0x1FF) * 32;
+  uint32_t width, height, depth = 1;
+  if (dim == 2) {  // 3D
+    width = (fetch[2] & 0x7FF) + 1; height = ((fetch[2] >> 11) & 0x7FF) + 1;
+    depth = ((fetch[2] >> 22) & 0x3FF) + 1;
+  } else {
+    width = (fetch[2] & 0x1FFF) + 1; height = ((fetch[2] >> 13) & 0x1FFF) + 1;
+    if (dim == 3) depth = 6;
+    else depth = (fetch[2] >> 26) + 1;  // array layers
+  }
+  const uint32_t pw = std::max(pitch_px, width);
+  const uint32_t blocks_x = (((pw + bw - 1) / bw) + 31) & ~31u;
+  const uint32_t blocks_y = (((height + bw - 1) / bw) + 31) & ~31u;
+  uint64_t size = uint64_t(blocks_x) * blocks_y * bpb * std::max(depth, 1u);
+  size = size + size / 2;  // packed mip tail / slack
+  size = std::min<uint64_t>(size, 32ull << 20);
+  if (uint64_t(base) + size > 0x20000000ull) size = 0x20000000ull - base;
+  const std::string dir = REXCVAR_GET(frame_trace_dir);
+  std::error_code ec;
+  std::filesystem::create_directories(std::filesystem::path(dir) / "tex", ec);
+  char name[128];
+  std::snprintf(name, sizeof(name), "%08X_%08X_%08X_%08X_%08X_%08X.bin", fetch[0], fetch[1],
+                fetch[2], fetch[3], fetch[4], fetch[5]);
+  std::FILE* f = std::fopen((std::filesystem::path(dir) / "tex" / name).string().c_str(), "wb");
+  if (!f) return;
+  std::fwrite(memory->TranslatePhysical(base), 1, size_t(size), f);
+  std::fclose(f);
+  TextureRange range;
+  range.base = base;
+  range.size = uint32_t(size);
+  std::snprintf(range.name, sizeof(range.name), "%s", name);
+  g_texture_ranges.push_back(range);
+}
+void DumpGuestRange(memory::Memory* memory, uint32_t base, uint32_t size, const char* tag) {
+  if (!g_file || !memory || !size) return;
+  static std::unordered_set<uint32_t> dumped;
+  if (!dumped.insert(base).second) return;
+  const std::string dir = REXCVAR_GET(frame_trace_dir);
+  std::error_code ec;
+  std::filesystem::create_directories(std::filesystem::path(dir) / "tex", ec);
+  char name[64];
+  std::snprintf(name, sizeof(name), "%s_%08X_%u.bin", tag, base, size);
+  if (std::FILE* f =
+          std::fopen((std::filesystem::path(dir) / "tex" / name).string().c_str(), "wb")) {
+    std::fwrite(memory->TranslatePhysical(base), 1, size, f);
+    std::fclose(f);
+  }
+  TextureRange range;
+  range.base = base;
+  range.size = size;
+  std::snprintf(range.name, sizeof(range.name), "%s", name);
+  g_texture_ranges.push_back(range);
+}
+std::vector<TextureRange> TakeTextureRanges() {
+  std::vector<TextureRange> ranges;
+  ranges.swap(g_texture_ranges);
+  return ranges;
+}
+std::string Directory() { return REXCVAR_GET(frame_trace_dir); }
+bool Light() { return g_light; }
+void AddHostTextureDump(const HostTextureDump& dump) { g_host_texture_dumps.push_back(dump); }
+std::vector<HostTextureDump> TakeHostTextureDumps() {
+  std::vector<HostTextureDump> dumps;
+  dumps.swap(g_host_texture_dumps);
+  return dumps;
+}
+void OnSwap(uint32_t frontbuffer_width, uint32_t frontbuffer_height) {
+  if (g_file) {
+    std::fprintf(g_file, "SWAP fb=%ux%u draws=%u\n", frontbuffer_width, frontbuffer_height,
+                 g_draw_index);
+    // Light traces record a burst of consecutive frames into the same file: a glitch that
+    // flickers (a few frames on, a few off) is caught in some of them.
+    if (g_burst_left > 0) {
+      --g_burst_left;
+      g_draw_index = 0;
+      ++g_frame_serial;
+      std::fprintf(g_file, "FRAME %u\n", kBurstFrames - g_burst_left);
+      return;
+    }
+    std::fprintf(g_file, "END\n");
+    std::fclose(g_file);
+    g_file = nullptr;
+    REXGPU_INFO("frame_trace: frame written ({} draws)", g_draw_index);
+    return;
+  }
+  const std::string dir = REXCVAR_GET(frame_trace_dir);
+  // Checking the file system every frame is cheap but pointless; ~10 times a second (a
+  // glitch trace is asked by a button the moment something shows).
+  if (dir.empty() || (g_frames_checked++ % 6) != 0) return;
+  std::error_code ec;
+  // trace_now_light: the frame as it is (no forced texture reload: a stale texture is part
+  // of what a rendering glitch trace must show, and nothing heavy is written).
+  const std::filesystem::path trigger = std::filesystem::path(dir) / "trace_now";
+  const std::filesystem::path light = std::filesystem::path(dir) / "trace_now_light";
+  if (std::filesystem::exists(light, ec)) {
+    std::filesystem::remove(light, ec);
+    g_light = true;
+    g_burst_left = kBurstFrames - 1;
+  } else if (std::filesystem::exists(trigger, ec)) {
+    std::filesystem::remove(trigger, ec);
+    g_light = false;
+    g_burst_left = 0;
+  } else {
+    return;
+  }
+  g_file = std::fopen((std::filesystem::path(dir) / "frame_trace.txt").string().c_str(), "w");
+  g_draw_index = 0;
+  ++g_frame_serial;
+  if (g_file) {
+    std::fprintf(g_file,
+                 "# 4DevilTears frame trace. D=draw C=copy(resolve) T=render target transfer\n"
+                 "# regs raw: surf=RB_SURFACE_INFO cN=RB_COLORn_INFO d=RB_DEPTH_INFO "
+                 "mask=RB_COLOR_MASK cc=RB_COLORCONTROL dc=RB_DEPTHCONTROL b0=RB_BLENDCONTROL0 "
+                 "scis=PA_SC_WINDOW_SCISSOR_BR mode=PA_SU_SC_MODE_CNTL\n");
+    REXGPU_INFO("frame_trace: recording next frame");
+  }
+}
