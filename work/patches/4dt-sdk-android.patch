diff --git a/tools/shader_stats/main.cpp b/tools/shader_stats/main.cpp
new file mode 100644
index 0000000..854f57c
--- /dev/null
+++ b/tools/shader_stats/main.cpp
@@ -0,0 +1,130 @@
+// [4deviltears] Offline shader statistics: translates dumped Xenos ucode
+// (shader_<hash>.ucode.bin.vert/.frag from --dump_shaders) with the SPIR-V
+// translator and prints the instruction mix of the generated SPIR-V.
+// Usage: rex-shader-stats <dump_dir> [--spv out_dir]
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <string>
+#include <vector>
+
+#include <rex/graphics/pipeline/shader/shader.h>
+#include <rex/graphics/pipeline/shader/spirv_translator.h>
+#include <rex/string/buffer.h>
+#include <rex/cvar.h>
+
+using namespace rex::graphics;
+
+static const char* Category(uint32_t op) {
+  switch (op) {
+    case 109: case 110: case 111: case 112: case 113: case 114: case 115: case 116: case 124:
+      return "convert";
+    case 126: case 128: case 130: case 132: case 134: case 135: case 137: case 138: case 139:
+      return "int_arith";
+    case 127: case 129: case 131: case 133: case 136: case 140: case 141: case 142: case 143:
+    case 144: case 145: case 146: case 147: case 148:
+      return "float_arith";
+    case 194: case 195: case 196: case 197: case 198: case 199: case 200: case 201: case 202:
+    case 203: case 204: case 205:
+      return "bit";
+    case 12:
+      return "ext_inst";
+    case 87: case 88: case 89: case 90: case 91: case 92: case 93: case 94: case 95: case 96:
+    case 97: case 98:
+      return "image";
+    case 103: case 104: case 105: case 106: case 107:
+      return "image_query";
+    case 245: case 246: case 247: case 248: case 249: case 250: case 251: case 252: case 253:
+    case 254: case 255:
+      return "control";
+    case 61: case 62: case 63: case 65: case 66:
+      return "memory";
+    case 79: case 80: case 81: case 82: case 83:
+      return "composite";
+    default:
+      if (op >= 164 && op <= 191) return "compare_select";
+      return nullptr;
+  }
+}
+
+int main(int argc, char** argv) {
+  // Cvars (e.g. --shader_mul_zero_dx9=false) are parsed first; the rest are
+  // positional: <dump_dir> [spv_out_dir].
+  std::vector<std::string> positional = rex::cvar::Init(argc, argv);
+  if (positional.empty()) {
+    std::fprintf(stderr, "usage: %s [--cvar=value...] <dump_dir> [spv_out_dir]\n", argv[0]);
+    return 2;
+  }
+  std::filesystem::path dump_dir = positional[0];
+  std::filesystem::path spv_out;
+  if (positional.size() > 1) spv_out = positional[1];
+  SpirvShaderTranslator::Features features(true);
+  // Mali-G715-like feature set.
+  features.fragment_shader_sample_interlock = false;
+  features.vertex_pipeline_stores_and_atomics = false;
+  SpirvShaderTranslator translator(features, true, false, false);
+  std::map<std::string, uint64_t> total;
+  uint64_t total_words = 0;
+  std::printf("%-22s %5s %7s %7s %7s %7s %7s %7s %7s %7s\n", "shader", "type", "words", "convert",
+              "int", "bit", "float", "ext", "image", "control");
+  for (const auto& entry : std::filesystem::directory_iterator(dump_dir)) {
+    std::string name = entry.path().filename().string();
+    bool is_vs = name.ends_with(".ucode.bin.vert"), is_ps = name.ends_with(".ucode.bin.frag");
+    if (!is_vs && !is_ps) continue;
+    uint64_t hash = std::stoull(name.substr(7, 16), nullptr, 16);
+    std::ifstream f(entry.path(), std::ios::binary);
+    std::vector<uint32_t> ucode((std::istreambuf_iterator<char>(f)), {});
+    f.seekg(0, std::ios::end);
+    size_t bytes = size_t(f.tellg());
+    ucode.resize(bytes / 4);
+    f.seekg(0);
+    f.read(reinterpret_cast<char*>(ucode.data()), std::streamsize(ucode.size() * 4));
+    Shader shader(is_vs ? xenos::ShaderType::kVertex : xenos::ShaderType::kPixel, hash,
+                  ucode.data(), ucode.size(), std::endian::native);
+    rex::string::StringBuffer disasm;
+    shader.AnalyzeUcode(disasm);
+    uint64_t modification = is_vs ? translator.GetDefaultVertexShaderModification(64)
+                                  : translator.GetDefaultPixelShaderModification(64);
+    Shader::Translation* translation = shader.GetOrCreateTranslation(modification);
+    if (!translator.TranslateAnalyzedShader(*translation)) {
+      std::printf("%-22s translation failed\n", name.c_str());
+      continue;
+    }
+    const std::vector<uint8_t>& bin = translation->translated_binary();
+    const uint32_t* words = reinterpret_cast<const uint32_t*>(bin.data());
+    size_t word_count = bin.size() / 4;
+    std::map<std::string, uint64_t> mix;
+    for (size_t i = 5; i < word_count;) {
+      uint32_t op = words[i] & 0xFFFF, len = words[i] >> 16;
+      if (!len) break;
+      if (const char* c = Category(op)) ++mix[c];
+      i += len;
+    }
+    for (auto& [k, v] : mix) total[k] += v;
+    total_words += word_count;
+    std::printf("%-22s %5s %7zu %7llu %7llu %7llu %7llu %7llu %7llu %7llu\n",
+                name.substr(7, 16).c_str(), is_vs ? "VS" : "PS", word_count,
+                (unsigned long long)mix["convert"], (unsigned long long)mix["int_arith"],
+                (unsigned long long)mix["bit"], (unsigned long long)mix["float_arith"],
+                (unsigned long long)mix["ext_inst"], (unsigned long long)mix["image"],
+                (unsigned long long)mix["control"]);
+    if (!spv_out.empty()) {
+      std::filesystem::create_directories(spv_out);
+      std::ofstream o(spv_out / (name + ".spv"), std::ios::binary);
+      o.write(reinterpret_cast<const char*>(bin.data()), std::streamsize(bin.size()));
+    }
+  }
+  std::printf("\nTOTAL words %llu:", (unsigned long long)total_words);
+  for (auto& [k, v] : total) std::printf(" %s=%llu", k.c_str(), (unsigned long long)v);
+  std::printf("\n");
+  return 0;
+}
+
+// The tool doesn't link util/draw.cpp (heavy deps); provide the two tables the RB translator needs.
+namespace rex::graphics::draw_util {
+extern const int8_t kD3D10StandardSamplePositions2x[2][2];
+extern const int8_t kD3D10StandardSamplePositions4x[4][2];
+const int8_t kD3D10StandardSamplePositions2x[2][2] = {{4, 4}, {-4, -4}};
+const int8_t kD3D10StandardSamplePositions4x[4][2] = {{-2, -6}, {6, -2}, {-6, 2}, {2, 6}};
+}  // namespace rex::graphics::draw_util
