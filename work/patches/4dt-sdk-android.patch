+void VulkanSharedMemory::SyncSubmissionPages() {
+  uint64_t submission = command_processor_.GetCurrentSubmission();
+  if (submission_pages_submission_ != submission) {
+    submission_pages_submission_ = submission;
+    size_t blocks = size_t(kBufferSize >> page_size_log2()) >> 6;
+    if (submission_pages_.size() != blocks) {
