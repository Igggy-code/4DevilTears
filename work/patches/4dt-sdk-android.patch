+REXCVAR_DEFINE_BOOL(vulkan_merge_clear_passes, true, "GPU/Vulkan",
+                    "[4DevilTears] Clears done in their own pass right before a draw pass on the "
+                    "same images become that pass's clear load op (the clear passes do nothing)");
+
+void VulkanCommandProcessor::Dmc4AfterEndRendering() {
+  if (dmc4_clear_pending_end_) {
+    dmc4_clear_pending_end_ = false;
+    dmc4_clear_pending_.end_offset = deferred_command_buffer_.Dmc4Size();
+    if (dmc4_clear_chain_.size() >= 4) {
+      dmc4_clear_chain_.erase(dmc4_clear_chain_.begin());
+    }
+    dmc4_clear_chain_.push_back(dmc4_clear_pending_);
+  }
+}
+
+void VulkanCommandProcessor::Dmc4DrawPassBegun() {
+  dmc4_draw_chain_.clear();
+  dmc4_draw_args_ = SIZE_MAX;
+  std::vector<Dmc4ClearPass> chain;
+  chain.swap(dmc4_clear_chain_);
+  if (!REXCVAR_GET(vulkan_merge_clear_passes) || chain.empty()) {
+    return;
+  }
+  size_t args = deferred_command_buffer_.Dmc4LastBeginArgsOffset();
+  if (args == SIZE_MAX) {
+    return;
+  }
+  // Keep the clear passes directly before this one (only barriers in between).
+  size_t next_begin = args - DeferredCommandBuffer::kDmc4HeaderElements;
+  std::vector<Dmc4ClearPass> contiguous;
+  for (size_t i = chain.size(); i-- > 0;) {
+    if (chain[i].end_offset == SIZE_MAX || chain[i].submission != GetCurrentSubmission() ||
+        chain[i].image == VK_NULL_HANDLE ||
+        !deferred_command_buffer_.Dmc4OnlyBarriersBetween(chain[i].end_offset, next_begin)) {
+      break;
+    }
+    contiguous.insert(contiguous.begin(), chain[i]);
+    next_begin = chain[i].args_offset - DeferredCommandBuffer::kDmc4HeaderElements;
+  }
+  if (contiguous.empty()) {
+    return;
+  }
+  render_target_cache_->Dmc4GetLastUpdateImages(dmc4_draw_depth_image_, dmc4_draw_color_images_);
+  dmc4_draw_chain_ = std::move(contiguous);
+  dmc4_draw_args_ = args;
+}
+
+bool VulkanCommandProcessor::Dmc4MergeClearsIntoDrawPass() {
+  if (!pass_area_patchable_ || pass_area_x1_ <= pass_area_x0_ ||
+      pass_area_y1_ <= pass_area_y0_ || dmc4_draw_args_ == SIZE_MAX) {
+    return false;
+  }
+  uint32_t color_count;
+  bool has_depth, has_stencil;
+  VkRenderingAttachmentInfo* attachments = deferred_command_buffer_.Dmc4RenderingAttachments(
+      dmc4_draw_args_, color_count, has_depth, has_stencil);
+  if (!attachments) {
+    return false;
+  }
+  // Every merged clear must cover what the pass draws, all with the same rectangle (it becomes
+  // the render area - cleared in full, which is what the clear passes did).
+  const VkRect2D* area = nullptr;
+  struct Match {
+    VkRenderingAttachmentInfo* attachment;
+    const Dmc4ClearPass* clear;
+  };
+  Match matches[6];
+  uint32_t match_count = 0;
+  for (const Dmc4ClearPass& clear : dmc4_draw_chain_) {
+    if (area && (clear.rect.offset.x != area->offset.x || clear.rect.offset.y != area->offset.y ||
+                 clear.rect.extent.width != area->extent.width ||
+                 clear.rect.extent.height != area->extent.height)) {
+      return false;
+    }
+    if (pass_area_x0_ < clear.rect.offset.x || pass_area_y0_ < clear.rect.offset.y ||
+        pass_area_x1_ > clear.rect.offset.x + int32_t(clear.rect.extent.width) ||
+        pass_area_y1_ > clear.rect.offset.y + int32_t(clear.rect.extent.height)) {
+      return false;
+    }
+    bool found = false;
+    if (clear.depth) {
+      if (has_depth && clear.image == dmc4_draw_depth_image_) {
+        matches[match_count++] = {&attachments[color_count], &clear};
+        if (has_stencil) {
+          matches[match_count++] = {&attachments[color_count + 1], &clear};
+        }
+        found = true;
+      }
+    } else {
+      for (uint32_t i = 0; i < color_count && i < 4; ++i) {
+        if (attachments[i].imageView != VK_NULL_HANDLE &&
+            clear.image == dmc4_draw_color_images_[i]) {
+          matches[match_count++] = {&attachments[i], &clear};
+          found = true;
+          break;
+        }
+      }
+    }
+    if (!found) {
+      return false;  // a clear of an image this pass doesn't attach - keep everything as is
+    }
+    area = &clear.rect;
+  }
+  if (!area || !match_count) {
+    return false;
+  }
+  for (uint32_t i = 0; i < match_count; ++i) {
+    matches[i].attachment->loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+    matches[i].attachment->clearValue = matches[i].clear->value;
+  }
+  // The clear passes neither load nor store now.
+  for (const Dmc4ClearPass& clear : dmc4_draw_chain_) {
+    uint32_t cc;
+    bool hd, hs;
+    VkRenderingAttachmentInfo* a =
+        deferred_command_buffer_.Dmc4RenderingAttachments(clear.args_offset, cc, hd, hs);
+    if (a) {
+      for (uint32_t i = 0; i < cc + uint32_t(hd) + uint32_t(hs); ++i) {
+        a[i].storeOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+      }
+    }
+  }
+  deferred_command_buffer_.Dmc4PatchRenderArea(dmc4_draw_args_, *area);
+  gpu_stats::Add(gpu_stats::kTightPasses, 1);
+  static uint32_t logged = 0;
+  if (logged < 4) {
+    ++logged;
+    REXGPU_INFO("Clear passes merged into the draw pass: {} clear(s), area {}x{} at {},{}",
+                dmc4_draw_chain_.size(), area->extent.width, area->extent.height,
+                area->offset.x, area->offset.y);
+  }
+  return true;
+}
+
+void VulkanCommandProcessor::PassAreaBegin(bool patchable, VkExtent2D extent) {
+  ++dmc4_pass_begin_count_;
+  dmc4_clear_only_pass_ = false;
+  pass_area_patchable_ = patchable && REXCVAR_GET(vulkan_tight_render_area);
+  pass_area_extent_ = extent;
+  pass_area_x0_ = INT32_MAX;
+  pass_area_y0_ = INT32_MAX;
+  pass_area_x1_ = 0;
+  pass_area_y1_ = 0;
+}
+
+void VulkanCommandProcessor::PassAreaAddScissor() {
+  const VkRect2D& r = dynamic_scissor_;
+  int32_t x0 = r.offset.x, y0 = r.offset.y;
+  int32_t x1 = x0 + int32_t(r.extent.width), y1 = y0 + int32_t(r.extent.height);
+  // [4DevilTears] Draws without a guest scissor (clears and blurs on small surfaces in a
+  // large EDRAM-sized framebuffer) are still limited by the guest viewport: primitives are
+  // clipped to it, so nothing outside is rasterized - don't load / store the rest of the
+  // attachments. (The host viewport can't be used - it covers the whole render target with
+  // the guest transform done in the vertex shader.)
+  if (REXCVAR_GET(vulkan_pass_area_viewport)) {
+    const RegisterFile& regs = *register_file_;
+    auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+    if (vte.vport_x_scale_ena && vte.vport_x_offset_ena && vte.vport_y_scale_ena &&
+        vte.vport_y_offset_ena && !regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET]) {
+      auto regf = [&](uint32_t reg) {
+        float f;
+        std::memcpy(&f, &regs[reg], 4);
+        return f;
+      };
+      float sx = std::abs(regf(XE_GPU_REG_PA_CL_VPORT_XSCALE));
+      float sy = std::abs(regf(XE_GPU_REG_PA_CL_VPORT_YSCALE));
+      float ox = regf(XE_GPU_REG_PA_CL_VPORT_XOFFSET);
+      float oy = regf(XE_GPU_REG_PA_CL_VPORT_YOFFSET);
+      if (std::isfinite(sx) && std::isfinite(sy) && std::isfinite(ox) && std::isfinite(oy) &&
+          sx > 0.0f && sy > 0.0f) {
+        // Host pixels per guest pixel: resolution scale, and up to 2x2 for MSAA surfaces
+        // (whether the host keeps the samples or stores them as a bigger 1x image).
+        xenos::MsaaSamples msaa = regs.Get<reg::RB_SURFACE_INFO>().msaa_samples;
+        int32_t mx = int32_t(render_target_cache_->draw_resolution_scale_x()) *
+                     (msaa >= xenos::MsaaSamples::k4X ? 2 : 1);
+        int32_t my = int32_t(render_target_cache_->draw_resolution_scale_y()) *
+                     (msaa >= xenos::MsaaSamples::k2X ? 2 : 1);
+        // One pixel of margin for half-pixel offsets.
+        int32_t vx0 = (int32_t(std::floor(ox - sx)) - 1) * mx;
+        int32_t vx1 = (int32_t(std::ceil(ox + sx)) + 1) * mx;
+        int32_t vy0 = (int32_t(std::floor(oy - sy)) - 1) * my;
+        int32_t vy1 = (int32_t(std::ceil(oy + sy)) + 1) * my;
+        x0 = std::max(x0, vx0);
+        y0 = std::max(y0, vy0);
+        x1 = std::min(x1, vx1);
+        y1 = std::min(y1, vy1);
+      }
+    }
+  }
+  if (x1 <= x0 || y1 <= y0) {
+    return;
+  }
+  PassAreaAddRect(x0, y0, uint32_t(x1 - x0), uint32_t(y1 - y0));
+}
+
+void VulkanCommandProcessor::PassAreaAddRect(int32_t x, int32_t y, uint32_t width,
+                                             uint32_t height) {
+  if (!pass_area_patchable_ || !in_render_pass_) {
+    return;
+  }
+  int32_t x0 = std::max(x, 0), y0 = std::max(y, 0);
+  int32_t x1 = std::min(int32_t(x + int32_t(width)), int32_t(pass_area_extent_.width));
+  int32_t y1 = std::min(int32_t(y + int32_t(height)), int32_t(pass_area_extent_.height));
+  if (x1 <= x0 || y1 <= y0) {
+    return;
+  }
+  pass_area_x0_ = std::min(pass_area_x0_, x0);
+  pass_area_y0_ = std::min(pass_area_y0_, y0);
+  pass_area_x1_ = std::max(pass_area_x1_, x1);
+  pass_area_y1_ = std::max(pass_area_y1_, y1);
+}
+
+REXCVAR_DEFINE_BOOL(vulkan_clear_pass_no_load, true, "GPU/Vulkan",
+                    "[4DevilTears] Passes doing only a clear of a rectangle: render area = that "
+                    "rectangle, attachments not loaded into tile memory first");
+
+void VulkanCommandProcessor::PassAreaFinish() {
+  if (dmc4_clear_only_pass_) {
+    dmc4_clear_only_pass_ = false;
+    if (REXCVAR_GET(vulkan_clear_pass_no_load)) {
+      pass_area_patchable_ = false;
+      deferred_command_buffer_.PatchLastBeginRenderArea(dmc4_clear_only_rect_);
+      deferred_command_buffer_.PatchLastBeginLoadOpDontCare();
+      gpu_stats::Add(gpu_stats::kTightPasses, 1);
+      size_t args = deferred_command_buffer_.Dmc4LastBeginArgsOffset();
+      if (args != SIZE_MAX) {
+        dmc4_clear_pending_ = {args, SIZE_MAX, dmc4_clear_only_image_, dmc4_clear_only_depth_,
+                               dmc4_clear_only_rect_, dmc4_clear_only_value_,
+                               GetCurrentSubmission()};
+        dmc4_clear_pending_end_ = true;
+      }
+      return;
+    }
+  }
+  if (!dmc4_draw_chain_.empty()) {
+    bool merged = Dmc4MergeClearsIntoDrawPass();
+    dmc4_draw_chain_.clear();
+    dmc4_draw_args_ = SIZE_MAX;
+    if (merged) {
+      pass_area_patchable_ = false;
+      return;
+    }
+  }
+  if (!pass_area_patchable_) {
+    return;
+  }
+  pass_area_patchable_ = false;
+  if (pass_area_x1_ <= pass_area_x0_ || pass_area_y1_ <= pass_area_y0_) {
+    return;  // No draws with a known extent - keep the full area.
+  }
+  // Align to 32 pixels (a whole number of tiles on Mali / Adreno bins are larger anyway).
+  int32_t x0 = pass_area_x0_ & ~31, y0 = pass_area_y0_ & ~31;
+  int32_t x1 = std::min((pass_area_x1_ + 31) & ~31, int32_t(pass_area_extent_.width));
+  int32_t y1 = std::min((pass_area_y1_ + 31) & ~31, int32_t(pass_area_extent_.height));
+  if (x0 == 0 && y0 == 0 && uint32_t(x1) == pass_area_extent_.width &&
+      uint32_t(y1) == pass_area_extent_.height) {
+    return;
+  }
+  VkRect2D area;
+  area.offset.x = x0;
+  area.offset.y = y0;
+  area.extent.width = uint32_t(x1 - x0);
+  area.extent.height = uint32_t(y1 - y0);
+  deferred_command_buffer_.PatchLastBeginRenderArea(area);
+  gpu_stats::Add(gpu_stats::kTightPasses, 1);
 }
 
