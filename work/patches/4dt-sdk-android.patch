+  char hash_text[17];
+  std::snprintf(hash_text, sizeof(hash_text), "%016llX",
+                static_cast<unsigned long long>(current_shader().ucode_data_hash()));
+  size_t position = debug_list.find(hash_text);
+  if (position == std::string::npos || position + 17 >= debug_list.size() ||
+      debug_list[position + 16] != ':') {
+    return -1;
+  }
+  const char* spec = debug_list.c_str() + position + 17;
+  if (*spec == 'i') {
+    initial = true;
+    ++spec;
+  }
+  int register_index = std::atoi(spec);
+  if (register_index < 0 || uint32_t(register_index) >= register_count()) {
+    return -1;
+  }
+  return register_index;
