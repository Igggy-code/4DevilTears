+uint32_t VulkanTextureCache::Dmc4GetZeroCopyTargets(uint32_t address, uint32_t dst_x1,
+                                                    uint32_t dst_y1,
+                                                    VkDescriptorSetLayout set_layout,
+                                                    VkDescriptorPool pool,
+                                                    Dmc4ZeroCopyTarget* targets_out,
+                                                    uint32_t max_targets) {
+  if (!REXCVAR_GET(fast_resolve_zero_copy) || g_4dt_zero_copy_blocked.count(address)) {
+    return 0;
+  }
+  auto by_address_it = g_4dt_zero_copy_by_address.find(address);
+  if (by_address_it == g_4dt_zero_copy_by_address.end() || by_address_it->second.empty()) {
+    return 0;
+  }
+  if (by_address_it->second.size() > max_targets) {
+    Dmc4BlockZeroCopy(address, "too many textures at the same address");
+    return 0;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  uint32_t count = 0;
+  for (const void* texture_ptr : by_address_it->second) {
+    auto* texture = const_cast<VulkanTexture*>(static_cast<const VulkanTexture*>(texture_ptr));
+    Dmc4ZeroCopyTexture& entry = g_4dt_zero_copy[texture];
+    // Textures not sampled for a while (left over from another scene) don't count - if one is
+    // used again, its stale read blocks zero-copy for the address.
+    if (texture->last_usage_submission_index() + 120 < command_processor_.GetCurrentSubmission()) {
+      continue;
+    }
+    uint32_t width = texture->key().GetWidth(), height = texture->key().GetHeight();
+    // Resolves are in 8x8 blocks - the rows / columns past the texture are left out.
+    uint32_t slack = REXCVAR_GET(fast_resolve_zero_copy_slack) ? 7 : 0;
+    if (dst_x1 > ((width + slack) & ~slack) || dst_y1 > ((height + slack) & ~slack)) {
+      static std::unordered_set<uint32_t> logged;
+      if (logged.insert(address).second) {
+        REXGPU_INFO("Fast resolve: no zero-copy at {:08X} for now - a {}x{} texture format {} "
+                    "there can't hold {}x{}",
+                    address, width, height, uint32_t(texture->key().format), dst_x1, dst_y1);
+      }
+      return 0;  // one of the readers can't hold it - the alias path for all
+    }
+    if (entry.set == VK_NULL_HANDLE) {
+      VkImageViewUsageCreateInfo usage_info = {};
+      usage_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_USAGE_CREATE_INFO;
+      usage_info.usage = VK_IMAGE_USAGE_STORAGE_BIT;
+      VkImageViewCreateInfo view_info = {};
+      view_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+      view_info.pNext = &usage_info;
+      view_info.image = texture->image();
+      view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      view_info.format = VK_FORMAT_R32_UINT;
+      view_info.subresourceRange = ui::vulkan::util::InitializeSubresourceRange();
+      if (dfn.vkCreateImageView(device, &view_info, nullptr, &entry.storage_view) != VK_SUCCESS) {
+        entry.storage_view = VK_NULL_HANDLE;
+        Dmc4BlockZeroCopy(address, "storage view failed");
+        return 0;
+      }
+      VkDescriptorSetAllocateInfo allocate_info = {};
+      allocate_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+      allocate_info.descriptorPool = pool;
+      allocate_info.descriptorSetCount = 1;
+      allocate_info.pSetLayouts = &set_layout;
+      if (dfn.vkAllocateDescriptorSets(device, &allocate_info, &entry.set) != VK_SUCCESS) {
+        entry.set = VK_NULL_HANDLE;
+        Dmc4BlockZeroCopy(address, "descriptor set allocation failed");
+        return 0;
+      }
+      entry.pool = pool;
+      VkDescriptorImageInfo image_info;
+      image_info.sampler = VK_NULL_HANDLE;
+      image_info.imageView = entry.storage_view;
+      image_info.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+      VkWriteDescriptorSet write = {};
+      write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+      write.dstSet = entry.set;
+      write.dstBinding = 0;
+      write.descriptorCount = 1;
+      write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+      write.pImageInfo = &image_info;
+      dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+      REXGPU_INFO("Fast resolve: zero-copy into the {}x{} texture format {} at {:08X} ({} of {})",
+                  width, height, uint32_t(texture->key().format), address, count + 1,
+                  by_address_it->second.size());
+    }
+    Dmc4ZeroCopyTarget& target = targets_out[count++];
+    target.image = texture->image();
+    target.set = entry.set;
+    target.texture = texture;
+    target.width = width;
+    target.height = height;
+  }
+  return count;
+}
+
+void VulkanTextureCache::Dmc4ZeroCopyBeginWrite(void* texture_ptr) {
+  auto* texture = static_cast<VulkanTexture*>(texture_ptr);
+  texture->MarkAsUsed();
+  VulkanTexture::Usage old_usage = texture->SetUsage(VulkanTexture::Usage::kUndefined);
+  VkPipelineStageFlags src_stage_mask;
+  VkAccessFlags src_access_mask;
+  VkImageLayout old_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  if (!src_stage_mask) {
+    src_stage_mask = VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT;
+  }
+  // The whole image is rewritten only in the resolved rectangle - keep the rest (old layout
+  // preserved unless undefined).
+  command_processor_.PushImageMemoryBarrier(
+      texture->image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, src_access_mask, VK_ACCESS_SHADER_WRITE_BIT,
+      old_layout, VK_IMAGE_LAYOUT_GENERAL);
+  g_4dt_fragment_only_textures.erase(texture);
+}
+
+void VulkanTextureCache::Dmc4ZeroCopyEndWrite(void* texture_ptr) {
+  auto* texture = static_cast<VulkanTexture*>(texture_ptr);
+  VkPipelineStageFlags dst_stage_mask;
+  VkAccessFlags dst_access_mask;
+  VkImageLayout new_layout;
+  GetTextureUsageMasks(VulkanTexture::Usage::kGuestShaderSampled, dst_stage_mask,
+                       dst_access_mask, new_layout);
+  command_processor_.PushImageMemoryBarrier(
+      texture->image(), ui::vulkan::util::InitializeSubresourceRange(),
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, dst_stage_mask, VK_ACCESS_SHADER_WRITE_BIT,
+      dst_access_mask, VK_IMAGE_LAYOUT_GENERAL, new_layout);
+  texture->SetUsage(VulkanTexture::Usage::kGuestShaderSampled);
+}
+
+uint64_t VulkanTextureCache::Dmc4ZeroCopyId(const void* texture) {
+  auto it = g_4dt_zero_copy.find(texture);
+  return it != g_4dt_zero_copy.end() ? it->second.id : 0;
+}
+
+void VulkanTextureCache::Dmc4ZeroCopyRevalidate(void* texture_ptr) {
+  auto* texture = static_cast<VulkanTexture*>(texture_ptr);
+  auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+  texture->MakeUpToDateAndWatch(global_lock);
+}
+
 }  // namespace rex::graphics::vulkan
