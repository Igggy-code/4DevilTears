+// [4DevilTears] Touch menus: every 2D sprite the game's UI shader draws in a frame
+// (screen rectangle in 1280x720 game pixels, texture rectangle, texture, colour), published
+// at the frame swap for the touch layer - taps are matched against the sprites the game
+// really draws (list rows, value arrows, button prompts), on any screen.
+REXCVAR_DEFINE_BOOL(ui_touch_sprites, true, "GPU",
+                    "[4DevilTears] Collect the UI sprites of each frame for touch menus");
+namespace {
+constexpr uint64_t kDmc4UiSpriteVs = UINT64_C(0x835AD9A82995A342);
+constexpr int kDmc4UiSpriteInts = 11;
+constexpr size_t kDmc4UiSpritesMax = 768;
+std::vector<int32_t> g_ui_sprites_building;
+std::vector<int32_t> g_ui_sprites_published;
+std::mutex g_ui_sprites_mutex;
+uint32_t g_ui_sprites_frame = 0;
+uint32_t g_ui_sprite_draw = 0;
+}  // namespace
+
+extern "C" __attribute__((visibility("default"))) int Rex4dtUiSprites(int32_t* out, int max_sprites,
+                                                                      uint32_t* frame) {
+  std::lock_guard<std::mutex> lock(g_ui_sprites_mutex);
+  const int count = std::min<int>(max_sprites, int(g_ui_sprites_published.size() / kDmc4UiSpriteInts));
+  if (out && count > 0) {
+    std::memcpy(out, g_ui_sprites_published.data(), size_t(count) * kDmc4UiSpriteInts * 4);
+  }
+  if (frame) *frame = g_ui_sprites_frame;
+  return count;
+}
+
+// [4DevilTears] Debug recorder: frames presented per half second (a stall shows as 0).
+static std::atomic<uint32_t> g_4dt_rec_swaps{0};
+static std::atomic<uint32_t> g_4dt_rec_draws{0};
+static void Dmc4RecGpuTick(void*) {
+  rex::dmc4rec::Line(fmt::format("GPU swaps {} ui-draws {}", g_4dt_rec_swaps.exchange(0),
+                                 g_4dt_rec_draws.exchange(0)));
+}
+
+static void Dmc4UiSpritesOnSwap() {
+  {
+    static bool registered = false;
+    if (!registered) {
+      registered = true;
+      rex::dmc4rec::AddTick(Dmc4RecGpuTick, nullptr);
+    }
+    ++g_4dt_rec_swaps;
+    g_4dt_rec_draws += g_ui_sprite_draw;
+  }
+  if (!REXCVAR_GET(ui_touch_sprites)) return;
+  {
+    std::lock_guard<std::mutex> lock(g_ui_sprites_mutex);
+    g_ui_sprites_published.swap(g_ui_sprites_building);
+    ++g_ui_sprites_frame;
+  }
+  g_ui_sprites_building.clear();
+  g_ui_sprite_draw = 0;
+}
+
+static void Dmc4UiSpritesDraw(const rex::graphics::RegisterFile& regs,
+                              rex::memory::Memory* memory, const rex::graphics::Shader* vs,
+                              uint32_t index_count, uint32_t ib_base,
+                              rex::graphics::xenos::IndexFormat ib_format,
+                              rex::graphics::xenos::Endian ib_endian) {
+  using namespace rex::graphics;
+  if (vs->ucode_data_hash() != kDmc4UiSpriteVs || vs->vertex_bindings().empty()) return;
+  if (index_count > 4096 ||
+      g_ui_sprites_building.size() >= kDmc4UiSpritesMax * kDmc4UiSpriteInts) {
+    return;
+  }
+  if (regs.Get<reg::RB_SURFACE_INFO>().surface_pitch != 1280) return;
+  const uint32_t draw = g_ui_sprite_draw++;
+  const auto& binding = vs->vertex_bindings()[0];
+  const uint32_t* vf =
+      &regs.values[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + binding.fetch_constant * 2];
+  if ((vf[0] & 3) != uint32_t(xenos::FetchConstantType::kVertex)) return;
+  const uint32_t base = vf[0] & ~uint32_t(3);
+  const uint32_t size_words = (vf[1] >> 2) & 0xFFFFFF;
+  const auto endian = xenos::Endian(vf[1] & 3);
+  const uint32_t stride = binding.stride_words;
+  // Layout of this shader's vertices: xyz float, colour (8888), texcoord (16_16).
+  if (stride < 5) return;
+  const uint32_t* vb = memory->TranslatePhysical<const uint32_t*>(base);
+  if (!vb) return;
+  auto word = [&](uint32_t index) -> uint32_t {
+    return index < size_words ? xenos::GpuSwap(vb[index], endian) : 0;
+  };
+  uint32_t tex_base = 0;
+  {
+    const uint32_t* t = &regs.values[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0];
+    if ((t[0] & 3) == uint32_t(xenos::FetchConstantType::kTexture)) tex_base = t[1] & 0xFFFFF000u;
+  }
+  const uint32_t indx_offset = regs[XE_GPU_REG_VGT_INDX_OFFSET] & 0xFFFFFF;
+  const void* ib = ib_base ? memory->TranslatePhysical<const void*>(ib_base) : nullptr;
+  float x0 = 1e30f, y0 = 1e30f, x1 = -1e30f, y1 = -1e30f;
+  uint32_t u0 = 0xFFFF, v0 = 0xFFFF, u1 = 0, v1 = 0, color = 0;
+  uint32_t verts = 0;
+  auto flush = [&]() {
+    if (verts >= 3 && x1 > x0 && y1 > y0 &&
+        g_ui_sprites_building.size() < kDmc4UiSpritesMax * kDmc4UiSpriteInts) {
+      const int32_t s[kDmc4UiSpriteInts] = {
+          int32_t(std::lround(x0)), int32_t(std::lround(y0)), int32_t(std::lround(x1)),
+          int32_t(std::lround(y1)), int32_t(u0), int32_t(v0), int32_t(u1), int32_t(v1),
+          int32_t(tex_base >> 12), int32_t(color), int32_t(draw)};
+      g_ui_sprites_building.insert(g_ui_sprites_building.end(), s, s + kDmc4UiSpriteInts);
+    }
+    x0 = y0 = 1e30f;
+    x1 = y1 = -1e30f;
+    u0 = v0 = 0xFFFF;
+    u1 = v1 = 0;
+    verts = 0;
+  };
+  for (uint32_t i = 0; i < index_count; ++i) {
+    uint32_t v = i;
+    if (ib) {
+      if (ib_format == xenos::IndexFormat::kInt32) {
+        v = xenos::GpuSwap(static_cast<const uint32_t*>(ib)[i], ib_endian);
+        if (v == 0xFFFFFFFFu) {
+          flush();
+          continue;
+        }
+      } else {
+        v = xenos::GpuSwap(static_cast<const uint16_t*>(ib)[i], ib_endian);
+        if (v == 0xFFFFu) {
+          flush();
+          continue;
+        }
+      }
+    }
+    v = (v + indx_offset) & 0xFFFFFF;
+    const uint32_t wx = word(v * stride), wy = word(v * stride + 1);
+    float x, y;
+    std::memcpy(&x, &wx, 4);
+    std::memcpy(&y, &wy, 4);
+    if (!(std::abs(x) < 100000.0f) || !(std::abs(y) < 100000.0f)) continue;
+    const uint32_t uv = word(v * stride + 4);
+    if (verts == 0) color = word(v * stride + 3);
+    x0 = std::min(x0, x);
+    y0 = std::min(y0, y);
+    x1 = std::max(x1, x);
+    y1 = std::max(y1, y);
+    u0 = std::min(u0, uv >> 16);
+    v0 = std::min(v0, uv & 0xFFFF);
+    u1 = std::max(u1, uv >> 16);
+    v1 = std::max(v1, uv & 0xFFFF);
+    ++verts;
+  }
+  flush();
+}
+
+// One frame on request (the touch layer asks when a tap finds nothing it knows).
+static std::atomic<bool> g_4dt_ui_oneshot{false};
+extern "C" __attribute__((visibility("default"))) void Rex4dtUiCaptureFrame(const char* path) {
+  auto& c = g_uicap;
+  if (!c.file && path && *path) {
+    c.file = std::fopen(path, "a");
+    c.file_tried = true;
+  }
+  g_4dt_ui_oneshot.store(true);
+}
+
+static void Dmc4UiCaptureOnSwap() {
+  auto& c = g_uicap;
+  if (c.logging) {
+    c.logging = false;
+    c.done.insert(c.logging_key);
+    Dmc4UiOut(fmt::format("UIDRAW end {:016X} ({} draws)", c.logging_key, c.frame_draw));
+    if (c.file) std::fflush(c.file);
+  }
+  if (g_4dt_ui_oneshot.exchange(false)) {
+    c.logging = true;
+    c.logging_key = 0;
+    c.last_consts_hash = 0;
+    c.frame_draw = 0;
+    c.frame_items.clear();
+    Dmc4UiOut(fmt::format("UIDRAW frame 0000000000000000 sig 0 layout 0 t {} (on request)",
+                          Dmc4UiNowMs()));
+    return;
+  }
+  if (!REXCVAR_GET(ui_capture_draws)) return;
+  // Screen key: the host menu signature (menu, cursor) + the set of distinct
+  // shader/texture pairs drawn (independent of order and of how many sprites).
+  uint64_t layout = 0;
+  for (uint64_t item : c.frame_items) layout += item * 0x9E3779B97F4A7C15ull;
+  c.layout_hash = layout;
+  uint64_t (*sig_fn)() = g_4dt_ui_signature_fn.load();
+  const uint64_t sig = sig_fn ? sig_fn() : 0;
+  // A known menu: one frame per screen + cursor position. Otherwise the drawn set.
+  const uint64_t key = (sig & ~uint64_t(0xFF)) != 0 ? Dmc4Mix(sig, 1) : Dmc4Mix(sig, layout);
+  const int64_t now = Dmc4UiNowMs();
+  if (key != c.last_key) {
+    c.last_key = key;
+    c.key_since_ms = now;
+  }
+  const bool stable_new = now - c.key_since_ms >= 300 && !c.done.count(key);
+  // Fallback: a frame every 2.5 s even if the key looks the same (animated screens).
+  const bool periodic = now - c.last_log_ms >= 2500;
+  if ((stable_new || periodic) && now - c.last_log_ms >= 500 && c.done.size() < 1500) {
+    c.logging = true;
+    c.logging_key = key;
+    c.last_log_ms = now;
+    c.last_consts_hash = 0;
+    Dmc4UiOut(fmt::format("UIDRAW frame {:016X} sig {:016X} layout {:016X} t {}", key, sig,
+                          layout, now));
+  }
+  c.frame_draw = 0;
+  c.frame_items.clear();
+}
+
+static void Dmc4UiCaptureDraw(const rex::graphics::RegisterFile& regs,
+                              rex::memory::Memory* memory, const rex::graphics::Shader* vs,
+                              const rex::graphics::Shader* ps,
+                              rex::graphics::xenos::PrimitiveType prim, uint32_t index_count,
+                              uint32_t ib_base, rex::graphics::xenos::IndexFormat ib_format,
+                              rex::graphics::xenos::Endian ib_endian) {
+  const bool ib = ib_base != 0;
+  using namespace rex::graphics;
+  auto& c = g_uicap;
+  const uint32_t draw = c.frame_draw++;
+  const uint64_t vs_hash = vs->ucode_data_hash();
+  const uint64_t ps_hash = ps ? ps->ucode_data_hash() : 0;
+  // Texture fetch constant 0 (UI sprites use one texture).
+  const uint32_t* tf = &regs.values[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0];
+  uint32_t tex_base = 0, tex_w = 0, tex_h = 0;
+  for (uint32_t i = 0; i < 4 && !tex_base; ++i) {
+    const uint32_t* t = tf + i * 6;
+    if ((t[0] & 3) == uint32_t(xenos::FetchConstantType::kTexture)) {
+      tex_base = t[1] & 0xFFFFF000u;
+      tex_w = (t[2] & 0x1FFF) + 1;
+      tex_h = ((t[2] >> 13) & 0x1FFF) + 1;
+    }
+  }
+  if (c.frame_items.size() < 512) {
+    c.frame_items.insert(Dmc4Mix(Dmc4Mix(vs_hash, ps_hash), tex_base));
+  }
+  if (!c.logging) return;
+  if (draw >= 1500) return;
+  const uint32_t pitch = regs.Get<reg::RB_SURFACE_INFO>().surface_pitch;
+  const float vxs = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE);
+  const float vxo = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE + 1);
+  const float vys = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE + 2);
+  const float vyo = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE + 3);
+  const uint32_t vte = regs[XE_GPU_REG_PA_CL_VTE_CNTL];
+  const uint32_t win_off = regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET];
+  std::string line = fmt::format(
+      "UID {} vs {:016X} ps {:016X} p{} n{} ix{} pitch {} rt {:08X} vp {:g},{:g},{:g},{:g} vte {:X} "
+      "woff {:X} tex {:08X} {}x{} tf {:08X} {:08X} {:08X}",
+      draw, vs_hash, ps_hash, uint32_t(prim), index_count, ib ? 1 : 0, pitch,
+      regs[XE_GPU_REG_RB_COLOR_INFO], vxs, vxo, vys, vyo, vte, win_off, tex_base, tex_w, tex_h,
+      tf[0], tf[2], tf[3]);
+  // VS constants c0..c7 when they change (the 2D transform usually lives there).
+  {
+    const uint32_t* cst = &regs.values[XE_GPU_REG_SHADER_CONSTANT_000_X];
+    uint64_t h = 0;
+    for (uint32_t i = 0; i < 32; ++i) h = Dmc4Mix(h, cst[i]);
+    if (h != c.last_consts_hash) {
+      c.last_consts_hash = h;
+      std::string cl = "UIDC";
+      for (uint32_t i = 0; i < 32; ++i) {
+        float f;
+        std::memcpy(&f, &cst[i], 4);
+        cl += fmt::format(" {:g}", f);
+      }
+      Dmc4UiOut(cl);
+    }
+  }
+  if (!vs->vertex_bindings().empty()) {
+    const auto& binding = vs->vertex_bindings()[0];
+    const uint32_t* vf = &regs.values[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 +
+                                      binding.fetch_constant * 2];
+    if ((vf[0] & 3) == uint32_t(xenos::FetchConstantType::kVertex)) {
+      const uint32_t base = vf[0] & ~uint32_t(3);
+      const uint32_t size_words = (vf[1] >> 2) & 0xFFFFFF;
+      const auto endian = xenos::Endian(vf[1] & 3);
+      const uint32_t stride = binding.stride_words;
+      line += fmt::format(" vb {:08X} w{} s{} at", base, size_words, stride);
+      int32_t pos_offset = -1;
+      xenos::VertexFormat pos_format = xenos::VertexFormat::kUndefined;
+      for (const auto& a : binding.attributes) {
+        const auto& at = a.fetch_instr.attributes;
+        line += fmt::format(" {}:{}", uint32_t(at.data_format), at.offset);
+        if (pos_offset < 0 || at.offset < pos_offset) {
+          pos_offset = at.offset;
+          pos_format = at.data_format;
+        }
+      }
+      const uint32_t* vb = memory->TranslatePhysical<const uint32_t*>(base);
+      auto word = [&](uint32_t index) -> uint32_t {
+        return index < size_words ? xenos::GpuSwap(vb[index], endian) : 0;
+      };
+      // Vertices used by the draw, in index order; kRestart separates the strips (primitive
+      // reset) - with triangle strips one strip is usually one sprite.
+      constexpr uint32_t kRestart = UINT32_MAX;
+      const uint32_t indx_offset = regs[XE_GPU_REG_VGT_INDX_OFFSET] & 0xFFFFFF;
+      std::vector<uint32_t> used;
+      const uint32_t n = std::min(index_count, 4096u);
+      used.reserve(n);
+      if (ib) {
+        for (uint32_t i = 0; i < n; ++i) {
+          uint32_t v;
+          if (ib_format == xenos::IndexFormat::kInt32) {
+            v = xenos::GpuSwap(memory->TranslatePhysical<const uint32_t*>(ib_base)[i], ib_endian);
+            if (v == 0xFFFFFFFFu) v = kRestart;
+          } else {
+            v = xenos::GpuSwap(memory->TranslatePhysical<const uint16_t*>(ib_base)[i], ib_endian);
+            if (v == 0xFFFFu) v = kRestart;
+          }
+          used.push_back(v == kRestart ? kRestart : ((v + indx_offset) & 0xFFFFFF));
+        }
+      } else {
+        for (uint32_t i = 0; i < n; ++i) used.push_back(i + indx_offset);
+      }
+      uint32_t first_vertex = kRestart;
+      for (uint32_t v : used) {
+        if (v != kRestart) {
+          first_vertex = v;
+          break;
+        }
+      }
+      const bool pos_float = pos_format == xenos::VertexFormat::k_32_32_FLOAT ||
+                             pos_format == xenos::VertexFormat::k_32_32_32_FLOAT ||
+                             pos_format == xenos::VertexFormat::k_32_32_32_32_FLOAT;
+      if (vb && stride && pos_offset >= 0 && pos_float && first_vertex != kRestart) {
+        auto pos = [&](uint32_t v, float& x, float& y) {
+          uint32_t wx = word(v * stride + pos_offset), wy = word(v * stride + pos_offset + 1);
+          std::memcpy(&x, &wx, 4);
+          std::memcpy(&y, &wy, 4);
+        };
+        float x0 = 1e30f, y0 = 1e30f, x1 = -1e30f, y1 = -1e30f;
+        for (uint32_t v : used) {
+          if (v == kRestart) continue;
+          float x, y;
+          pos(v, x, y);
+          x0 = std::min(x0, x);
+          y0 = std::min(y0, y);
+          x1 = std::max(x1, x);
+          y1 = std::max(y1, y);
+        }
+        line += fmt::format(" bb {:g},{:g} {:g},{:g}", x0, y0, x1, y1);
+        // Every used vertex position, strips separated by "/" (big 3D draws skipped).
+        if (index_count <= 2048) {
+          line += " xy";
+          for (uint32_t v : used) {
+            if (v == kRestart) {
+              line += " /";
+              continue;
+            }
+            float x, y;
+            pos(v, x, y);
+            line += fmt::format(" {:.1f},{:.1f}", x, y);
+          }
+        }
+      }
+      const uint32_t vmin = first_vertex == kRestart ? 0 : first_vertex;
+      const uint32_t vmax = vmin + 3;
+      if (vb && stride) {
+        line += " raw";
+        const uint32_t count = std::min<uint32_t>(vmax - vmin + 1, 4);
+        for (uint32_t v = 0; v < count; ++v) {
+          line += " |";
+          for (uint32_t w = 0; w < std::min(stride, 12u); ++w) {
+            uint32_t x = word((vmin + v) * stride + w);
+            float f;
+            std::memcpy(&f, &x, 4);
+            if (std::abs(f) > 1e-6f && std::abs(f) < 1e7f) line += fmt::format(" {:g}", f);
+            else line += fmt::format(" #{:X}", x);
+          }
+        }
+      }
+    }
+  }
+  Dmc4UiOut(line);
+}
+
+namespace rex::graphics::vulkan {
+// [4DevilTears] Android performance hints (ADPF): with a frame rate cap, tell the system the
+// frame budget of the guest threads and the GPU thread and how long each frame really took,
+// so the CPU governor keeps an even clock instead of dropping it between heavy frames (frame
+// time spikes) or boosting past what the cap needs (heat). Vendor-neutral (Pixel, Snapdragon,
+// Dimensity): libandroid's APerformanceHint, a no-op where the device doesn't support it.
+#if REX_PLATFORM_ANDROID
+namespace {
+struct PerfHintApi {
+  void* (*get_manager)() = nullptr;
+  void* (*create_session)(void*, const int32_t*, size_t, int64_t) = nullptr;
+  int (*update_target)(void*, int64_t) = nullptr;
+  int (*report_actual)(void*, int64_t) = nullptr;
+  void (*close_session)(void*) = nullptr;
+  bool loaded = false, ok = false;
+};
+PerfHintApi& HintApi() {
+  static PerfHintApi api;
+  if (!api.loaded) {
+    api.loaded = true;
+    if (void* lib = dlopen("libandroid.so", RTLD_NOW | RTLD_NOLOAD)) {
+      api.get_manager = reinterpret_cast<void* (*)()>(dlsym(lib, "APerformanceHint_getManager"));
+      api.create_session = reinterpret_cast<void* (*)(void*, const int32_t*, size_t, int64_t)>(
+          dlsym(lib, "APerformanceHint_createSession"));
+      api.update_target =
+          reinterpret_cast<int (*)(void*, int64_t)>(dlsym(lib, "APerformanceHint_updateTargetWorkDuration"));
+      api.report_actual =
+          reinterpret_cast<int (*)(void*, int64_t)>(dlsym(lib, "APerformanceHint_reportActualWorkDuration"));
+      api.close_session = reinterpret_cast<void (*)(void*)>(dlsym(lib, "APerformanceHint_closeSession"));
+      api.ok = api.get_manager && api.create_session && api.update_target && api.report_actual &&
+               api.close_session;
+    }
+    REXGPU_INFO("perf hint: {}", api.ok ? "available" : "not available on this device");
+  }
+  return api;
+}
+}  // namespace
+#endif
+
+static std::chrono::steady_clock::time_point g_hint_last{};
+
+void Dmc4PerfHintAfterPacing(std::chrono::steady_clock::time_point now) { g_hint_last = now; }
+
+void Dmc4PerfHintFrame(int32_t limit, std::chrono::steady_clock::time_point now) {
+#if REX_PLATFORM_ANDROID
+  auto& last = g_hint_last;
+  static void* session = nullptr;
+  static uint32_t session_generation = UINT32_MAX;
+  static int32_t session_limit = 0;
+  static int32_t gpu_tid = 0;
+  PerfHintApi& api = HintApi();
+  if (!api.ok) return;
+  if (limit <= 0) {
+    // No cap: the system's own scheduling (no target to hold).
+    if (session) {
+      api.close_session(session);
+      session = nullptr;
+    }
+    last = {};
+    return;
+  }
+  if (!gpu_tid) gpu_tid = static_cast<int32_t>(gettid());
+  uint32_t generation = 0;
+  std::vector<int32_t> tids = rex::thread::PerfHintThreads(&generation);
+  const int64_t target_ns = 1000000000LL / limit;
+  if (!session && generation == session_generation) return;  // failed for this thread list
+  if (!session || generation != session_generation) {
+    if (session) api.close_session(session);
+    // Only threads that still exist (a finished one makes the whole session fail).
+    std::vector<int32_t> alive;
+    for (int32_t t : tids) {
+      char path[64];
+      std::snprintf(path, sizeof(path), "/proc/self/task/%d", t);
+      if (access(path, F_OK) == 0) alive.push_back(t);
+    }
+    alive.push_back(gpu_tid);
+    void* manager = api.get_manager();
+    session = manager ? api.create_session(manager, alive.data(), alive.size(), target_ns) : nullptr;
+    if (!session && manager) {
+      // Some systems cap the threads of a session: the GPU thread alone still helps.
+      session = api.create_session(manager, &gpu_tid, 1, target_ns);
+    }
+    session_generation = generation;
+    session_limit = limit;
+    REXGPU_INFO("perf hint: session for {} threads, target {} us -> {}", alive.size(),
+                target_ns / 1000, session ? "ok" : "failed");
+    last = {};
+    if (!session) return;
+  } else if (limit != session_limit) {
+    api.update_target(session, target_ns);
+    session_limit = limit;
+  }
+  // The frame's work: from the previous swap (after its pacing sleep) to this one.
+  if (last.time_since_epoch().count() != 0) {
+    const int64_t work = std::chrono::duration_cast<std::chrono::nanoseconds>(now - last).count();
+    if (work > 0 && work < 1000000000LL) api.report_actual(session, work);
+  }
+#endif
+}
