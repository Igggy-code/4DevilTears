+namespace {
+// [4deviltears] Removes guest MSAA (2X/4X) from rendering, keeping the EDRAM model exact.
+// Registers are rewritten for the duration of one draw or resolve and restored after.
+//  - Full-screen surfaces (pitch >= 1024): plain 1X of the same pixel size, for draws
+//    and resolves alike (the game always sees one consistent 1X layout of its scene).
+//  - Small surfaces (post-processing tricks, XDK clears at half resolution): draws go
+//    to a 1X surface with doubled dimensions - in EDRAM, 4X pitch P is byte-identical
+//    to 1X pitch 2P (samples become pixels), exactly what the game relies on when it
+//    blurs on "160x90 4X" and reads it as 320x180 1X or clears 1280x720 through
+//    "640x360 4X". The render target then keeps the same 1X key as its neighbours, so
+//    there are no ownership transfers. Their resolves keep the real 4X layout.
+// Saves the 4x sample bandwidth and the full-screen layout transfers on mobile GPUs.
+// [4DevilTears] Predicated tiling collapse state (see collapse_predicated_tiling).
+struct BandCollapseState {
+  // Tiled configurations (surface info) seen with a negative window Y offset -> the scissor
+  // bottom of the first band and the full height covered by the bands.
+  struct Config {
+    uint32_t first_band_bottom = 0;
+    uint32_t full_bottom = 0;
+    // Consecutive frames with this same band layout (a cut between cutscene shots switches
+    // layouts - the first frames of a new layout are drawn band by band as the game does).
+    uint32_t stable = 1;
+  };
+  static constexpr uint32_t kStableFrames = 3;
+  std::unordered_map<uint64_t, Config> configs_previous, configs_current;
+  // Scissor bottom of the last unshifted draw per surface (the first band, if bands follow).
+  std::unordered_map<uint64_t, uint32_t> last_unshifted_bottom;
+  // Configurations whose first band was drawn at full height in this frame.
+  std::unordered_set<uint64_t> expanded;
+  bool Ready(const Config& config) const { return config.stable >= kStableFrames; }
+  void OnFrame() {
+    for (auto& entry : configs_current) {
+      auto prev = configs_previous.find(entry.first);
+      if (prev != configs_previous.end() &&
+          prev->second.first_band_bottom == entry.second.first_band_bottom &&
+          prev->second.full_bottom == entry.second.full_bottom) {
+        entry.second.stable = prev->second.stable + 1;
+      }
+    }
+    configs_previous.swap(configs_current);
+    configs_current.clear();
+    last_unshifted_bottom.clear();
+    expanded.clear();
+  }
+};
+BandCollapseState g_band_collapse;
+
+class ScopedRegisterOverride {
+ public:
+  explicit ScopedRegisterOverride(RegisterFile& regs) : regs_(regs) {}
+  void Set(uint32_t reg, uint32_t value) {
+    if (count_ < 8) {
+      saved_[count_++] = {reg, regs_.values[reg]};
+      regs_.values[reg] = value;
+    }
+  }
+  ~ScopedRegisterOverride() {
+    for (uint32_t i = count_; i-- > 0;) regs_.values[saved_[i].reg] = saved_[i].value;
+  }
+
+ private:
+  RegisterFile& regs_;
+  struct Saved {
+    uint32_t reg, value;
+  } saved_[8];
+  uint32_t count_ = 0;
+};
+
+uint64_t BandCollapseKey(const RegisterFile& regs) {
+  // The bands may have different scissors (DMC4: 384 rows, then the rest to 720 with the
+  // window shifted up) - the surface identifies the tiled configuration.
+  return uint64_t(regs[XE_GPU_REG_RB_SURFACE_INFO] & 0x3FFFF);
+}
+
+bool BandCollapseUsable(const RegisterFile& regs) {
+  auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  // The resolve source shift is computed for 1X EDRAM tiles (80x16 pixels).
+  return surface_info.msaa_samples == xenos::MsaaSamples::k1X ||
+         (REXCVAR_GET(force_msaa_1x) && surface_info.surface_pitch >= 1024);
+}
+
+class ScopedMsaaOverride {
+ public:
+  ScopedMsaaOverride(RegisterFile& regs, bool apply, bool is_copy) : regs_(regs) {
+    if (!apply) return;
+    uint32_t surface_info = regs_.values[XE_GPU_REG_RB_SURFACE_INFO];
+    uint32_t msaa = (surface_info >> 16) & 3;
+    if (!msaa) return;
+    uint32_t pitch = surface_info & 0x3FFF;
+    if (pitch >= 1024) {
+      Save(XE_GPU_REG_RB_SURFACE_INFO);
+      regs_.values[XE_GPU_REG_RB_SURFACE_INFO] = surface_info & ~(3u << 16);
+      return;
+    }
+    if (is_copy) return;
+    auto vte = regs_.Get<reg::PA_CL_VTE_CNTL>();
+    if (!vte.vport_x_scale_ena || !vte.vport_x_offset_ena || !vte.vport_y_scale_ena ||
+        !vte.vport_y_offset_ena) {
+      return;  // Screen-space vertex positions - can't rescale, keep real MSAA.
+    }
+    const bool double_x = msaa >= 2;  // 4X: 2x2 samples; 2X: 1x2 samples.
+    if (pitch << uint32_t(double_x) > 0x3FFF) return;
+    Save(XE_GPU_REG_RB_SURFACE_INFO);
+    regs_.values[XE_GPU_REG_RB_SURFACE_INFO] =
+        (surface_info & ~((3u << 16) | 0x3FFFu)) | (pitch << uint32_t(double_x));
+    auto scale_float = [&](uint32_t reg) {
+      Save(reg);
+      float f;
+      std::memcpy(&f, &regs_.values[reg], 4);
+      f *= 2.0f;
+      std::memcpy(&regs_.values[reg], &f, 4);
+    };
+    if (double_x) {
+      scale_float(XE_GPU_REG_PA_CL_VPORT_XSCALE);
+      scale_float(XE_GPU_REG_PA_CL_VPORT_XOFFSET);
+    }
+    scale_float(XE_GPU_REG_PA_CL_VPORT_YSCALE);
+    scale_float(XE_GPU_REG_PA_CL_VPORT_YOFFSET);
+    // 14-bit unsigned (window scissor) / 15-bit signed (screen scissor, window offset)
+    // x and y fields at bits 0 and 16.
+    auto scale_xy = [&](uint32_t reg, bool is_signed, uint32_t bits) {
+      Save(reg);
+      uint32_t v = regs_.values[reg];
+      uint32_t mask = (1u << bits) - 1;
+      auto scale = [&](uint32_t field, bool do_scale) -> uint32_t {
+        if (!do_scale) return field;
+        int32_t value = is_signed ? int32_t(field << (32 - bits)) >> (32 - bits) : int32_t(field);
+        int32_t limit = is_signed ? (1 << (bits - 1)) - 1 : 8192;
+        int32_t low = is_signed ? -(1 << (bits - 1)) : 0;
+        value = std::clamp(value * 2, low, limit);
+        return uint32_t(value) & mask;
+      };
+      uint32_t x = scale(v & mask, double_x);
+      uint32_t y = scale((v >> 16) & mask, true);
+      regs_.values[reg] = (v & ~(mask | (mask << 16))) | x | (y << 16);
+    };
+    scale_xy(XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL, false, 14);
+    scale_xy(XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR, false, 14);
+    scale_xy(XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL, true, 15);
+    scale_xy(XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR, true, 15);
+    scale_xy(XE_GPU_REG_PA_SC_WINDOW_OFFSET, true, 15);
+  }
+  ~ScopedMsaaOverride() {
+    for (uint32_t i = saved_count_; i-- > 0;) {
+      regs_.values[saved_[i].reg] = saved_[i].value;
+    }
+  }
+
+ private:
+  void Save(uint32_t reg) { saved_[saved_count_++] = {reg, regs_.values[reg]}; }
+  RegisterFile& regs_;
+  struct SavedRegister {
+    uint32_t reg, value;
+  };
+  SavedRegister saved_[12];
+  uint32_t saved_count_ = 0;
+};
+}  // namespace
