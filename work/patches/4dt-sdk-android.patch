diff --git a/include/rex/audio/dmc4_recorder.h b/include/rex/audio/dmc4_recorder.h
new file mode 100644
index 0000000..d8b9325
--- /dev/null
+++ b/include/rex/audio/dmc4_recorder.h
@@ -0,0 +1,46 @@
+// [4DevilTears] Debug recorder: switched on by hand (a button / gesture in the app, or a
+// runner job) right before a known problem spot. While on, subsystems write compact state
+// lines into a separate file: audio (XMA contexts, audio clients), kernel waits that last,
+// file reads, frames. A watchdog dumps every guest thread blocked for a while.
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#include <fmt/format.h>
+
+#define DMC4REC_API __attribute__((visibility("default")))
+
+namespace rex::dmc4rec {
+
+DMC4REC_API bool On();
+DMC4REC_API void Line(const std::string& text);
+template <typename... Args>
+inline void Log(fmt::format_string<Args...> f, Args&&... args) {
+  if (On()) Line(fmt::format(f, std::forward<Args>(args)...));
+}
+
+// Something called every ~500 ms by the watchdog while recording (state summaries).
+using TickFn = void (*)(void* user);
+DMC4REC_API void AddTick(TickFn fn, void* user);
+
+// A guest synchronization call on a game-static object (event set / reset / semaphore
+// release / multi-object wait): logged with the calling thread and guest return address.
+DMC4REC_API void Sync(const char* what, uint32_t object, uint32_t extra = 0);
+
+// A guest wait in progress (the watchdog reports the ones that take long).
+class DMC4REC_API WaitScope {
+ public:
+  WaitScope(const char* kind, uint32_t object, uint32_t type, uint32_t count, bool infinite);
+  ~WaitScope();
+
+ private:
+  bool active_ = false;
+  uint64_t slot_ = 0;
+};
+
+}  // namespace rex::dmc4rec
+
+extern "C" DMC4REC_API void Rex4dtRecStart(const char* path);
+extern "C" DMC4REC_API void Rex4dtRecStop();
+extern "C" DMC4REC_API void Rex4dtRecNote(const char* text);
