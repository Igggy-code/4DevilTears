diff --git a/include/rex/graphics/frame_trace.h b/include/rex/graphics/frame_trace.h
new file mode 100644
index 0000000..289dfa9
--- /dev/null
+++ b/include/rex/graphics/frame_trace.h
@@ -0,0 +1,104 @@
+/**
+ * @file        frame_trace.h
+ * @brief       [4deviltears] One-frame GPU command trace (draws, resolves, render
+ *              target transfers) for analysing the game's frame structure.
+ *
+ * Triggered by creating <frame_trace_dir>/trace_now; the next full guest frame is
+ * written to <frame_trace_dir>/frame_trace.txt. Zero cost while inactive.
+ */
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace rex::memory {
+class Memory;
+}
+
+namespace rex::graphics::frame_trace {
+
+// True while a frame is being recorded.
+bool Active();
+// The current trace was asked without the forced texture reload (trace_now_light).
+bool Light();
+// Appends one printf-style line (newline added) to the trace, if active.
+void Line(const char* format, ...)
+#if defined(__GNUC__) || defined(__clang__)
+    __attribute__((format(printf, 1, 2)))
+#endif
+    ;
+// Called once per guest frame swap: finishes a recording or starts one if requested.
+void OnSwap(uint32_t frontbuffer_width, uint32_t frontbuffer_height);
+// Running index of the current draw within the frame being recorded.
+uint32_t NextDrawIndex();
+// The index the next draw will get (doesn't advance it).
+uint32_t PeekDrawIndex();
+// Changes for every recorded frame.
+uint32_t FrameSerial();
+// Writes the guest memory of a texture (6 fetch constant dwords) next to the trace, once
+// per texture per process.
+void DumpGuestTexture(memory::Memory* memory, const uint32_t* fetch);
+// Any guest range (vertex streams), dumped from the CPU and later the GPU copy.
+void DumpGuestRange(memory::Memory* memory, uint32_t base, uint32_t size, const char* tag);
+// Guest ranges of the textures dumped in the current trace (to read the GPU-side copy
+// of the same memory back at the end of the frame): base, size, file name.
+struct TextureRange {
+  uint32_t base;
+  uint32_t size;
+  char name[80];
+};
+std::vector<TextureRange> TakeTextureRanges();
+// Directory of the trace output.
+std::string Directory();
+// Host-side decoded texture data (texture cache load output) to read back at the end of
+// the traced frame. Opaque handles to keep this header Vulkan-free.
+struct HostTextureDump {
+  uint64_t buffer;  // VkBuffer, or a linear VkImage if image_width != 0
+  uint64_t memory;
+  uint64_t size;
+  char name[128];
+  // Linear image readback (render target / resolve result checkpoints): rows are written
+  // tightly packed, image_width * image_bpp bytes each.
+  uint32_t image_width = 0;
+  uint32_t image_height = 0;
+  uint32_t image_bpp = 0;
+};
+void AddHostTextureDump(const HostTextureDump& dump);
+std::vector<HostTextureDump> TakeHostTextureDumps();
+
+}  // namespace rex::graphics::frame_trace
+
+// [4deviltears] Always-on per-frame counters of the expensive emulation work, logged as
+// "GPUSTAT" every 120 frames (averages per frame).
+namespace rex::graphics::gpu_stats {
+enum Counter : uint32_t {
+  kTextureLoads,
+  kTextureLoadKB,
+  kResolves,
+  kResolveKPixels,
+  kDumps,
+  kDumpTiles,
+  kTransfers,
+  kTransferTiles,
+  kRenderPasses,
+  kDraws,
+  kAliasCopies,
+  kTransferCopies,
+  kTransfersDropped,
+  kHleClears,
+  kPassRestarts,
+  kSharedMemoryUploads,
+  kSharedMemoryUploadKB,
+  kStaleTextures,
+  kSharedMemoryHoistedUploads,
+  kTexturesEvicted,
+  kGpuMicroseconds,
+  kBandDrawsSkipped,
+  kTightPasses,
+  kPassBarriers,
+  kCount
+};
+void Add(Counter counter, uint64_t value);
+}  // namespace rex::graphics::gpu_stats
+
