+int SpirvShaderTranslator::DebugOutputRegister(bool& initial) const {
+  initial = false;
+  const std::string& debug_list = REXCVAR_GET(debug_ps_output_register);
+  if (debug_list.empty() || !is_pixel_shader() || var_main_registers_ == spv::NoResult ||
+      !(current_shader().writes_color_targets() & 1) ||
+      output_or_var_fragment_data_[0] == spv::NoResult) {
+    return -1;
