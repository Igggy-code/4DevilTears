+std::string PhysicalHeap::DebugDescribePage(uint32_t physical_address) const {
+  uint32_t physical_address_offset = GetPhysicalAddress(heap_base_);
+  if (physical_address < physical_address_offset ||
+      physical_address - physical_address_offset >= heap_size_) {
+    return "-";
+  }
+  uint32_t heap_relative_address = physical_address - physical_address_offset;
+  uint32_t guest_page = heap_relative_address >> page_size_shift_;
+  uint32_t system_page = (heap_relative_address + host_address_offset()) / system_page_size_;
+  const PageEntry& entry = page_table_[guest_page];
+  bool watched = system_page < system_page_count_ &&
+                 (system_page_flags_[system_page >> 6].notify_on_invalidation &
+                  (uint64_t(1) << (system_page & 63))) != 0;
+  return fmt::format("st{}cp{:X}ap{:X}w{}", uint32_t(entry.state), uint32_t(entry.current_protect),
+                     uint32_t(entry.allocation_protect), watched ? 1 : 0);
+}
