+// the faulting address and the library + offset of pc / lr, appended to crash.txt next to the
+// log - so a player's "the game closed" can be diagnosed from the saved diagnostics.
+static void Dmc4WriteCrashNote(int signal_number, siginfo_t* signal_info, void* signal_context) {
+  static volatile int once = 0;
+  if (once) return;
+  uintptr_t fault_pc = 0;
