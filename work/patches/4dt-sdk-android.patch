+std::mutex g_scene_mutex;
+std::unordered_map<uint32_t, int> g_scene_handles;  // handle -> mode
+std::atomic<int> g_scene_mode{kModeInteractive};
+
+int RecomputeLocked() {
+  int mode = kModeInteractive;
+  for (const auto& entry : g_scene_handles) mode = std::max(mode, entry.second);
+  return mode;
+}
+
+bool EndsWithNoCase(const std::string& s, const char* suffix) {
+  size_t n = std::strlen(suffix);
+  if (s.size() < n) return false;
+  for (size_t i = 0; i < n; ++i) {
+    if (std::tolower(uint8_t(s[s.size() - n + i])) != std::tolower(uint8_t(suffix[i]))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool ContainsNoCase(const std::string& s, const char* needle) {
+  std::string lower(s);
+  for (char& c : lower) c = char(std::tolower(uint8_t(c)));
+  return lower.find(needle) != std::string::npos;
+}
+}  // namespace
+
+void OnFileOpened(uint32_t handle, const std::string& path) {
+  int mode = kModeInteractive;
+  if (EndsWithNoCase(path, ".wmv") || EndsWithNoCase(path, ".xmv")) {
+    mode = kModeMovie;
+  } else if (EndsWithNoCase(path, ".xma") && (ContainsNoCase(path, "sound\\demo\\") || ContainsNoCase(path, "sound/demo/"))) {
+    mode = kModeCutscene;
+  }
+  if (mode == kModeInteractive) return;
+  std::lock_guard<std::mutex> lock(g_scene_mutex);
+  g_scene_handles[handle] = mode;
+  int now = RecomputeLocked();
+  if (now != g_scene_mode.exchange(now)) {
+    REXKRNL_INFO("SCENE mode {} (open '{}' handle={:#x})", now, path, handle);
+  }
+}
+
+void OnHandleClosed(uint32_t handle) {
+  std::lock_guard<std::mutex> lock(g_scene_mutex);
+  if (!g_scene_handles.erase(handle)) return;
+  int now = RecomputeLocked();
+  if (now != g_scene_mode.exchange(now)) {
+    REXKRNL_INFO("SCENE mode {} (closed handle={:#x})", now, handle);
+  }
+}
+
+int CurrentMode() { return g_scene_mode.load(std::memory_order_relaxed); }
