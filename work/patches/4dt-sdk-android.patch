+cmake_minimum_required(VERSION 3.14)
+
+# [4DevilTears] ANDROID_ABI also accepted (NDK toolchain file)
+if(NOT "${CMAKE_ANDROID_ARCH_ABI}" STREQUAL "arm64-v8a" AND NOT "${ANDROID_ABI}" STREQUAL "arm64-v8a")
+	message(FATAL_ERROR "Unsupported target architecture: ${CMAKE_ANDROID_ARCH_ABI}. Please make an issue on the repo!")
