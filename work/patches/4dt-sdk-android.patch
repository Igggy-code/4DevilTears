+bool VulkanRenderTargetCache::CopyTransferAsImage(RenderTarget* dest, const Transfer& transfer) {
+  RenderTarget* source = transfer.source;
+  if (!dest || !source || source == dest) {
+    return false;
+  }
+  RenderTargetKey dest_key = dest->key();
+  RenderTargetKey source_key = source->key();
+  if (dest_key.is_depth != source_key.is_depth ||
+      dest_key.msaa_samples != source_key.msaa_samples ||
+      dest_key.pitch_tiles_at_32bpp != source_key.pitch_tiles_at_32bpp ||
+      dest_key.base_tiles != source_key.base_tiles) {
+    return false;
+  }
+  if (dest_key.is_depth) {
+    if (dest_key.resource_format != source_key.resource_format) {
+      return false;
+    }
+  } else {
+    auto is_8bit_storage = [](xenos::ColorRenderTargetFormat format) {
+      return format == xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+             format == xenos::ColorRenderTargetFormat::k_2_10_10_10 ||
+             format == xenos::ColorRenderTargetFormat::k_2_10_10_10_AS_10_10_10_10;
+    };
+    if (dest_key.resource_format != source_key.resource_format &&
+        !(is_8bit_storage(dest_key.GetColorFormat()) &&
+          is_8bit_storage(source_key.GetColorFormat()))) {
+      return false;
+    }
+    if (xenos::IsColorRenderTargetFormat64bpp(dest_key.GetColorFormat())) {
+      return false;
+    }
+  }
+  Transfer::Rectangle rectangles[Transfer::kMaxRectanglesWithoutCutout];
+  uint32_t rectangle_count =
+      transfer.GetRectangles(dest_key.base_tiles, dest_key.pitch_tiles_at_32bpp,
+                             dest_key.msaa_samples, false, rectangles);
+  if (!rectangle_count) {
+    return true;
+  }
+  auto& vulkan_source = *static_cast<VulkanRenderTarget*>(source);
+  auto& vulkan_dest = *static_cast<VulkanRenderTarget*>(dest);
+  VkImageAspectFlags aspects = dest_key.is_depth
+                                   ? (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)
+                                   : VK_IMAGE_ASPECT_COLOR_BIT;
+  command_processor_.PushImageMemoryBarrier(
+      vulkan_source.image(), ui::vulkan::util::InitializeSubresourceRange(aspects),
+      vulkan_source.current_stage_mask(), VK_PIPELINE_STAGE_TRANSFER_BIT,
+      vulkan_source.current_access_mask(), VK_ACCESS_TRANSFER_READ_BIT,
+      vulkan_source.current_layout(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  vulkan_source.SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+                         VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  command_processor_.PushImageMemoryBarrier(
+      vulkan_dest.image(), ui::vulkan::util::InitializeSubresourceRange(aspects),
+      vulkan_dest.current_stage_mask(), VK_PIPELINE_STAGE_TRANSFER_BIT,
+      vulkan_dest.current_access_mask(), VK_ACCESS_TRANSFER_WRITE_BIT,
+      vulkan_dest.current_layout(), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  vulkan_dest.SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                       VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  for (uint32_t i = 0; i < rectangle_count; ++i) {
+    const Transfer::Rectangle& rectangle = rectangles[i];
+    VkImageCopy region = {};
+    region.srcSubresource.aspectMask = aspects;
+    region.srcSubresource.layerCount = 1;
+    region.dstSubresource = region.srcSubresource;
+    region.srcOffset = {int32_t(rectangle.x_pixels * draw_resolution_scale_x()),
+                        int32_t(rectangle.y_pixels * draw_resolution_scale_y()), 0};
+    region.dstOffset = region.srcOffset;
+    region.extent = {rectangle.width_pixels * draw_resolution_scale_x(),
+                     rectangle.height_pixels * draw_resolution_scale_y(), 1};
+    command_buffer.CmdVkCopyImage(vulkan_source.image(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                  vulkan_dest.image(), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                                  region);
+  }
+  return true;
+}
