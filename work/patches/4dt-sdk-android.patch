index 0000000..c8a92c6
--- /dev/null
+++ b/src/graphics/pipeline/texture/title_patch.cpp
@@ -0,0 +1,327 @@
+/**
+ * [4DevilTears] "PRESS START BUTTON" -> "TAP to START" on the Devil May Cry 4 title screen.
+ *
+ * Nothing from the game is shipped: when the title atlas (1024x1024 k_8_8_8_8, tiled) is
+ * about to be uploaded, its two "PRESS START BUTTON" lines (glowing and metallic) are
+ * recognised by a hash of their alpha and rebuilt in guest memory from the game's own
+ * letters - T, A, P, O and the word "START" are cut out of the original lettering (masks
+ * come from the clean glowing line), the capital T is the small-caps T scaled up and the
+ * small-caps P is the capital P scaled down. Any other version / language does not match
+ * the hash and is left untouched.
+ */
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/graphics/pipeline/texture/util.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(title_tap_to_start, true, "GPU",
+                    "[4DevilTears] Replace PRESS START BUTTON on the title screen with "
+                    "TAP to START, built from the game's own lettering");
+
+namespace rex::graphics::title_patch {
+namespace {
+
+constexpr int kW = 1024;
+constexpr int kBandH = 58;
+constexpr int kBandY[2] = {400, 451};    // glowing line, metallic line
+constexpr int kBaseline[2] = {442, 493};
+constexpr int kX0 = 100, kX1 = 540;      // working columns
+constexpr uint32_t kSignature = 0x40CD4930u;
+constexpr uint32_t kSignatureRu = 0x07484852u;
+#include "title_ru_tap.inc"
+
+struct Px {
+  float r, g, b, a;  // premultiplied
+};
+
+struct Image {
+  int w = 0, h = 0;
+  std::vector<Px> p;
+  Image() = default;
+  Image(int w_, int h_) : w(w_), h(h_), p(size_t(w_) * h_, Px{0, 0, 0, 0}) {}
+  Px& at(int x, int y) { return p[size_t(y) * w + x]; }
+  const Px& at(int x, int y) const { return p[size_t(y) * w + x]; }
+};
+
+struct Glyph {
+  Image img;
+  float core_left, core_right;  // ink extent inside img
+};
+
+uint8_t* TexelPtr(uint8_t* base, int x, int y) {
+  return base + texture_util::GetTiledOffset2D(x, y, kW, 2);
+}
+
+// Guest k_8_8_8_8 here is stored A, B, G, R.
+Px ReadPx(uint8_t* base, int x, int y) {
+  const uint8_t* t = TexelPtr(base, x, y);
+  float a = t[0] / 255.0f;
+  return Px{t[3] / 255.0f * a, t[2] / 255.0f * a, t[1] / 255.0f * a, a};
+}
+
+void WritePx(uint8_t* base, int x, int y, const Px& v) {
+  uint8_t* t = TexelPtr(base, x, y);
+  float a = std::clamp(v.a, 0.0f, 1.0f);
+  auto c = [&](float premul) {
+    float u = a > 1e-4f ? premul / a : 0.0f;
+    return uint8_t(std::lround(std::clamp(u, 0.0f, 1.0f) * 255.0f));
+  };
+  t[0] = uint8_t(std::lround(a * 255.0f));
+  t[1] = c(v.b);
+  t[2] = c(v.g);
+  t[3] = c(v.r);
+}
+
+// Letters of the glowing line, as 8-connected components of its opaque core.
+struct Components {
+  std::vector<int> label;  // kBandH x kW, 0 = none
+  std::vector<float> mean_x;
+};
+
+Components Label(const std::array<Image, 2>& bands) {
+  Components c;
+  c.label.assign(size_t(kBandH) * kW, 0);
+  c.mean_x.push_back(0.0f);
+  const Image& a = bands[0];
+  std::vector<int> stack;
+  for (int y = 0; y < kBandH; ++y) {
+    for (int x = kX0; x < kX1; ++x) {
+      if (a.at(x, y).a <= 0.95f || c.label[size_t(y) * kW + x]) continue;
+      int id = int(c.mean_x.size());
+      double sum = 0.0;
+      int n = 0;
+      stack.assign(1, y * kW + x);
+      c.label[size_t(y) * kW + x] = id;
+      while (!stack.empty()) {
+        int v = stack.back();
+        stack.pop_back();
+        int vx = v % kW, vy = v / kW;
+        sum += vx;
+        ++n;
+        for (int dy = -1; dy <= 1; ++dy) {
+          for (int dx = -1; dx <= 1; ++dx) {
+            int nx = vx + dx, ny = vy + dy;
+            if (nx < kX0 || nx >= kX1 || ny < 0 || ny >= kBandH) continue;
+            size_t i = size_t(ny) * kW + nx;
+            if (c.label[i] || a.at(nx, ny).a <= 0.95f) continue;
+            c.label[i] = id;
+            stack.push_back(ny * kW + nx);
+          }
+        }
+      }
+      c.mean_x.push_back(float(sum / n));
+    }
+  }
+  return c;
+}
+
+Glyph Cut(const Image& band, const Components& comps, int x0, int x1, int pad) {
+  constexpr int R = 5;
+  std::vector<float> m(size_t(kBandH) * kW, 0.0f);
+  for (size_t i = 0; i < m.size(); ++i) {
+    int id = comps.label[i];
+    if (id && comps.mean_x[id] >= x0 && comps.mean_x[id] <= x1) m[i] = 1.0f;
+  }
+  // Dilate (Chebyshev radius R), then a 3x3 box blur for a soft edge.
+  for (int it = 0; it < R; ++it) {
+    std::vector<float> d(m);
+    for (int y = 0; y < kBandH; ++y) {
+      for (int x = kX0; x < kX1; ++x) {
+        if (m[size_t(y) * kW + x] > 0.0f) continue;
+        for (int dy = -1; dy <= 1 && !d[size_t(y) * kW + x]; ++dy) {
+          for (int dx = -1; dx <= 1; ++dx) {
+            int nx = x + dx, ny = y + dy;
+            if (nx < 0 || nx >= kW || ny < 0 || ny >= kBandH) continue;
+            if (m[size_t(ny) * kW + nx] > 0.0f) {
+              d[size_t(y) * kW + x] = 1.0f;
+              break;
+            }
+          }
+        }
+      }
+    }
+    m.swap(d);
+  }
+  std::vector<float> b(m.size(), 0.0f);
+  for (int y = 0; y < kBandH; ++y) {
+    for (int x = kX0; x < kX1; ++x) {
+      float s = 0.0f;
+      for (int dy = -1; dy <= 1; ++dy)
+        for (int dx = -1; dx <= 1; ++dx) {
+          int nx = x + dx, ny = std::clamp(y + dy, 0, kBandH - 1);
+          s += m[size_t(ny) * kW + nx];
+        }
+      float colw = std::clamp(std::min(float(x - (x0 - pad - 2)), float((x1 + pad + 2) - x)) / 2.0f,
+                              0.0f, 1.0f);
+      b[size_t(y) * kW + x] = s / 9.0f * colw;
+    }
+  }
+  int l = kX1, r = kX0;
+  for (int y = 0; y < kBandH; ++y)
+    for (int x = kX0; x < kX1; ++x)
+      if (b[size_t(y) * kW + x] > 0.003f) {
+        l = std::min(l, x);
+        r = std::max(r, x + 1);
+      }
+  Glyph g;
+  if (r <= l) return g;
+  g.img = Image(r - l, kBandH);
+  for (int y = 0; y < kBandH; ++y)
+    for (int x = l; x < r; ++x) {
+      Px v = band.at(x, y);
+      float w = b[size_t(y) * kW + x];
+      g.img.at(x - l, y) = Px{v.r * w, v.g * w, v.b * w, v.a * w};
+    }
+  g.core_left = float(x0 - l);
+  g.core_right = float(x1 - l);
+  return g;
+}
+
+// Bilinear rescale keeping the baseline row in place.
+Glyph Scale(const Glyph& src, float k, int baseline) {
+  Glyph g;
+  int nw = std::max(1, int(std::lround(src.img.w * k)));
+  g.img = Image(nw, kBandH);
+  for (int y = 0; y < kBandH; ++y) {
+    float sy = baseline + (y - baseline) / k;
+    for (int x = 0; x < nw; ++x) {
+      float sx = (x + 0.5f) / k - 0.5f;
+      int x0 = int(std::floor(sx)), y0 = int(std::floor(sy));
+      float fx = sx - x0, fy = sy - y0;
+      Px acc{0, 0, 0, 0};
+      for (int j = 0; j < 2; ++j)
+        for (int i = 0; i < 2; ++i) {
+          int xx = x0 + i, yy = y0 + j;
+          if (xx < 0 || yy < 0 || xx >= src.img.w || yy >= kBandH) continue;
+          float w = (i ? fx : 1 - fx) * (j ? fy : 1 - fy);
+          const Px& v = src.img.at(xx, yy);
+          acc.r += v.r * w;
+          acc.g += v.g * w;
+          acc.b += v.b * w;
+          acc.a += v.a * w;
+        }
+      g.img.at(x, y) = acc;
+    }
+  }
+  g.core_left = src.core_left * k;
+  g.core_right = src.core_right * k;
+  return g;
+}
+
+}  // namespace
+
+bool MaybePatch(uint8_t* guest_texture, uint32_t width, uint32_t height, bool tiled,
+                bool is_8888, uint32_t pitch) {
+  if (!REXCVAR_GET(title_tap_to_start) || !guest_texture || !tiled || !is_8888 ||
+      width != 1024 || height != 1024 || (pitch && pitch != 1024)) {
+    return false;
+  }
+  uint32_t h = 0x811C9DC5u;
+  for (int y = 405; y < 505; ++y)
+    for (int x = 115; x < 525; ++x) {
+      h ^= TexelPtr(guest_texture, x, y)[0];
+      h *= 0x01000193u;
+    }
+  if (h == kSignatureRu) {
+    // Russian fan translation ("Нажмите Любую Кнопку"): its letters can't spell the new text,
+    // so a prepared strip is written over both lines.
+    for (int y = 0; y < 97; ++y)
+      for (int x = 0; x < 384; ++x) {
+        const unsigned char* c = kRuTapToStart + (size_t(y) * 384 + x) * 4;
+        float a = c[3] / 255.0f;
+        WritePx(guest_texture, 128 + x, 405 + y,
+                Px{c[0] / 255.0f * a, c[1] / 255.0f * a, c[2] / 255.0f * a, a});
+      }
+    REXGPU_INFO("title: Нажмите Любую Кнопку -> Коснитесь Экрана");
+    // The translation swapped the two states of the menu captions in this atlas: the cursor
+    // row came out dull and the others bright. Each caption is drawn twice, one block above
+    // the other - swap the blocks back (texels, x0..x1, rows y0..y0+h <-> y0+h..y0+2h):
+    //   main menu (Новая игра / Загрузить игру / Опции), 3 rows of 56 per state;
+    //   Вкл / Выкл; Человек; Охотник на демонов (the new game screens).
+    struct Swap {
+      int x0, x1, y0, h;
+    };
+    const Swap swaps[] = {{0, 416, 0, 168}, {512, 1024, 224, 48}, {720, 1024, 128, 48},
+                          {640, 1024, 376, 48}};
+    for (const Swap& sw : swaps)
+      for (int y = sw.y0; y < sw.y0 + sw.h; ++y)
+        for (int x = sw.x0; x < sw.x1; ++x) {
+          uint8_t* a = TexelPtr(guest_texture, x, y);
+          uint8_t* b = TexelPtr(guest_texture, x, y + sw.h);
+          for (int i = 0; i < 4; ++i) std::swap(a[i], b[i]);
+        }
+    REXGPU_INFO("title: menu caption states swapped back (Russian translation)");
+    return true;
+  }
+  if (h != kSignature) {
+    static std::atomic<int> logged{0};
+    if (logged.fetch_add(1) < 12) {
+      REXGPU_INFO("title: 1024x1024 8888 texture, signature {:08X} (want {:08X})", h,
+                  kSignature);
+    }
+    return false;
+  }
+
+  std::array<Image, 2> bands;
+  for (int v = 0; v < 2; ++v) {
+    bands[v] = Image(kW, kBandH);
+    for (int y = 0; y < kBandH; ++y)
+      for (int x = kX0; x < kX1; ++x) bands[v].at(x, y) = ReadPx(guest_texture, x, kBandY[v] + y);
+  }
+  Components comps = Label(bands);
+
+  for (int v = 0; v < 2; ++v) {
+    int baseline = kBaseline[v] - kBandY[v];
+    Glyph t = Cut(bands[v], comps, 336, 354, 3);
+    Glyph a = Cut(bands[v], comps, 288, 309, 3);
+    Glyph p = Cut(bands[v], comps, 129, 153, 3);
+    Glyph o = Cut(bands[v], comps, 463, 484, 1);
+    Glyph start = Cut(bands[v], comps, 248, 354, 3);
+    if (!t.img.w || !a.img.w || !p.img.w || !o.img.w || !start.img.w) return false;
+    const float k = 1.33f;
+    Glyph big_t = Scale(t, k, baseline);
+    Glyph small_p = Scale(p, 1.0f / k, baseline);
+    struct Item {
+      const Glyph* g;
+      float gap;
+    };
+    const float letter_gap = 2.0f, word_gap = 14.0f;
+    const Item seq[] = {{&big_t, letter_gap - 2}, {&a, letter_gap}, {&small_p, word_gap},
+                        {&t, letter_gap},         {&o, word_gap},    {&start, 0}};
+    float x = 0;
+    float pos[6];
+    for (int i = 0; i < 6; ++i) {
+      pos[i] = x - seq[i].g->core_left;
+      x += seq[i].g->core_right - seq[i].g->core_left + seq[i].gap;
+    }
+    float left = 320.5f - x / 2.0f;
+    Image canvas(kW, kBandH);
+    for (int i = 0; i < 6; ++i) {
+      int ix = int(std::lround(left + pos[i]));
+      const Image& gi = seq[i].g->img;
+      for (int yy = 0; yy < kBandH; ++yy)
+        for (int xx = 0; xx < gi.w; ++xx) {
+          int cx = ix + xx;
+          if (cx < 0 || cx >= kW) continue;
+          const Px& s = gi.at(xx, yy);
+          Px& d = canvas.at(cx, yy);
+          float ia = 1.0f - s.a;
+          d = Px{s.r + d.r * ia, s.g + d.g * ia, s.b + d.b * ia, s.a + d.a * ia};
+        }
+    }
+    for (int yy = 0; yy < kBandH; ++yy)
