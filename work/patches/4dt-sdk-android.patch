+++ b/src/audio/dmc4_recorder.cpp
@@ -0,0 +1,428 @@
+// [4DevilTears] Debug recorder - see rex/audio/dmc4_recorder.h.
+#include <rex/audio/dmc4_recorder.h>
+#include <rex/thread.h>
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#if defined(__linux__) || defined(__ANDROID__)
+#include <dirent.h>
+#include <dlfcn.h>
+#include <signal.h>
+#include <sys/syscall.h>
+#include <ucontext.h>
+#include <unistd.h>
+#define DMC4REC_SAMPLER 1
+#endif
+
+#include <rex/system/thread_state.h>
+#include <rex/system/xthread.h>
+
+namespace rex::dmc4rec {
+namespace {
+
+std::atomic<bool> g_on{false};
+std::mutex g_file_mutex;
+std::FILE* g_file = nullptr;
+std::chrono::steady_clock::time_point g_start;
+
+// One slot per guest thread, written by the thread itself on every wait (always on, lock
+// free) - so waits that began before recording started are seen too.
+struct Slot {
+  std::atomic<uint32_t> used{0};
+  std::atomic<uint32_t> thread_id{0}, entry{0};
+  std::atomic<int64_t> since_us{0};  // 0 - not waiting
+  std::atomic<int64_t> reported_since{0};
+  std::atomic<uint32_t> object{0}, type{0}, count{0}, lr{0};
+  std::atomic<const char*> kind{nullptr};
+  std::atomic<bool> infinite{false};
+  std::atomic<PPCContext*> ctx{nullptr};
+  std::atomic<int> host_tid{0};
+  // Host stack sample (signal handler): pc, lr and a few frame-pointer return addresses.
+  std::atomic<uint32_t> sample_serial{0};
+  uintptr_t sample[8] = {};
+};
+constexpr int kSlots = 512;
+Slot g_slots[kSlots];
+std::atomic<int> g_slot_next{0};
+thread_local Slot* t_slot = nullptr;
+const auto g_epoch = std::chrono::steady_clock::now();
+
+int64_t NowUs() {
+  return std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() -
+                                                               g_epoch)
+      .count();
+}
+
+Slot* MySlot() {
+  if (t_slot) return t_slot;
+  int i = g_slot_next.fetch_add(1);
+  if (i >= kSlots) return nullptr;
+  Slot* s = &g_slots[i];
+  if (auto* thread = rex::system::XThread::GetCurrentThread()) {
+    s->thread_id = thread->thread_id();
+    s->entry = thread->creation_params()->start_address;
+  }
+  if (auto* ts = rex::runtime::ThreadState::Get()) s->ctx = ts->context();
+#if DMC4REC_SAMPLER
+  s->host_tid = int(syscall(SYS_gettid));
+#endif
+  s->used = 1;
+  t_slot = s;
+  return s;
+}
+
+std::mutex g_tick_mutex;
+std::vector<std::pair<TickFn, void*>> g_ticks;
+
+std::thread g_watchdog;
+std::mutex g_watch_mutex;
+std::condition_variable g_watch_cv;
+bool g_watch_stop = false;
+
+int64_t Ms() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() -
+                                                               g_start)
+      .count();
+}
+
+#if DMC4REC_SAMPLER
+// Where a running (not waiting) thread really is: a real-time signal makes it record its
+// own registers; the recompiled game functions are named sub_<guest address> in the
+// symbol table, so dladdr turns host addresses into guest functions.
+int SampleSignal() { return SIGRTMIN + 10; }
+
+// Samples of every thread of the process (host threads too: GPU, audio, decoders...).
+struct HostSample {
+  std::atomic<int> tid{0};
+  std::atomic<uint32_t> serial{0};
+  uintptr_t frames[10] = {};
+};
+constexpr int kHostSamples = 256;
+HostSample g_host_samples[kHostSamples];
+
+void SampleHandler(int, siginfo_t*, void* context) {
+  const int tid = int(syscall(SYS_gettid));
+  for (int i = 0; i < kHostSamples; ++i) {
+    HostSample& s = g_host_samples[i];
+    if (s.tid.load() != tid) continue;
+    auto* uc = static_cast<ucontext_t*>(context);
+#if defined(__aarch64__)
+    s.frames[0] = uc->uc_mcontext.pc;
+    s.frames[1] = uc->uc_mcontext.regs[30];
+    uintptr_t fp = uc->uc_mcontext.regs[29];
+    const uintptr_t sp = uc->uc_mcontext.sp;
+#elif defined(__x86_64__)
+    s.frames[0] = uc->uc_mcontext.gregs[REG_RIP];
+    s.frames[1] = 0;
+    uintptr_t fp = uc->uc_mcontext.gregs[REG_RBP];
+    const uintptr_t sp = uc->uc_mcontext.gregs[REG_RSP];
+#else
+    uintptr_t fp = 0;
+    const uintptr_t sp = 0;
+#endif
+    // Only frame pointers inside this thread's live stack (code built without frame
+    // pointers - GPU driver, ART - keeps other values in x29: never dereference those).
+    const uintptr_t stack_end = sp + (256u << 10);
+    for (int k = 2; k < 10; ++k) {
+      if (!fp || (fp & 7) || fp < sp || fp + 16 > stack_end) {
+        fp = 0;
+        s.frames[k] = 0;
+        continue;
+      }
+      const uintptr_t* frame = reinterpret_cast<const uintptr_t*>(fp);
+      s.frames[k] = frame[1];
+      const uintptr_t next = frame[0];
+      fp = next > fp && next - fp < (1u << 20) ? next : 0;
+    }
+    s.serial.fetch_add(1);
+    return;
+  }
+}
+
+void InstallSampler() {
+  static bool installed = false;
+  if (installed) return;
+  installed = true;
+  struct sigaction sa = {};
+  sa.sa_sigaction = SampleHandler;
+  sa.sa_flags = SA_SIGINFO | SA_RESTART;
+  sigemptyset(&sa.sa_mask);
+  sigaction(SampleSignal(), &sa, nullptr);
+}
+
+std::string Symbolize(uintptr_t addr) {
+  if (!addr) return "-";
+#if defined(__aarch64__)
+  {
+    // Return addresses signed with pointer authentication: strip the signature.
+    register uintptr_t lr asm("x30") = addr;
+    asm volatile("hint #7" : "+r"(lr));  // xpaclri
+    addr = lr;
+  }
+#endif
+  Dl_info info = {};
+  if (dladdr(reinterpret_cast<void*>(addr), &info) && info.dli_sname) {
+    return fmt::format("{}+{:X}", info.dli_sname, addr - uintptr_t(info.dli_saddr));
+  }
+  if (info.dli_fname) {
+    const char* base = std::strrchr(info.dli_fname, '/');
+    return fmt::format("{}+{:X}", base ? base + 1 : info.dli_fname, addr - uintptr_t(info.dli_fbase));
+  }
+  return fmt::format("{:X}", addr);
+}
+
+// Samples every thread of the process except guest threads already reported as waiting,
+// and logs where each one is (guest threads by id, host threads by name).
+void SampleRunningThreads(std::vector<std::string>& lines) {
+  InstallSampler();
+  const int64_t now = NowUs();
+  const int self = int(syscall(SYS_gettid));
+  // Guest thread id by host tid; waiting ones are skipped.
+  std::unordered_map<int, uint32_t> guest_by_tid;
+  std::unordered_map<int, bool> waiting;
+  const int n = std::min(g_slot_next.load(), kSlots);
+  for (int i = 0; i < n; ++i) {
+    Slot& s = g_slots[i];
+    if (!s.used || !s.host_tid.load()) continue;
+    guest_by_tid[s.host_tid.load()] = s.thread_id.load();
+    const int64_t since = s.since_us.load();
+    if (since && now - since > 800000) waiting[s.host_tid.load()] = true;
+  }
+  waiting.erase(rex::thread::GlobalLockOwnerTid());
+  std::vector<int> tids;
+  if (DIR* dir = opendir("/proc/self/task")) {
+    while (dirent* ent = readdir(dir)) {
+      const int tid = std::atoi(ent->d_name);
+      if (tid > 0 && tid != self && !waiting.count(tid)) tids.push_back(tid);
+    }
+    closedir(dir);
+  }
+  if (int(tids.size()) > kHostSamples) tids.resize(kHostSamples);
+  std::vector<uint32_t> serials(tids.size());
+  for (size_t i = 0; i < tids.size(); ++i) {
+    g_host_samples[i].tid = tids[i];
+    serials[i] = g_host_samples[i].serial.load();
+    syscall(SYS_tgkill, getpid(), tids[i], SampleSignal());
+  }
+  std::this_thread::sleep_for(std::chrono::milliseconds(40));
+  for (size_t i = 0; i < tids.size(); ++i) {
+    HostSample& s = g_host_samples[i];
+    char name[32] = "?";
+    if (std::FILE* f = std::fopen(fmt::format("/proc/self/task/{}/comm", tids[i]).c_str(), "r")) {
+      if (std::fgets(name, sizeof(name), f)) name[std::strcspn(name, "\n")] = 0;
+      std::fclose(f);
+    }
+    auto g = guest_by_tid.find(tids[i]);
+    std::string who = g != guest_by_tid.end() ? fmt::format("t{:X}", g->second)
+                                             : fmt::format("host{}", tids[i]);
+    if (s.serial.load() == serials[i]) {
+      lines.push_back(fmt::format("RUN {} '{}' (no sample)", who, name));
+      continue;
+    }
+    std::string l = fmt::format("RUN {} '{}' pc {} lr {} |", who, name, Symbolize(s.frames[0]),
+                                Symbolize(s.frames[1]));
+    for (int k = 2; k < 10 && s.frames[k]; ++k) l += " " + Symbolize(s.frames[k]);
+    lines.push_back(l);
+  }
+  for (size_t i = 0; i < tids.size(); ++i) g_host_samples[i].tid = 0;
+}
+#endif
+
+void WatchdogMain() {
+  std::unique_lock<std::mutex> lock(g_watch_mutex);
+  while (!g_watch_stop) {
+    g_watch_cv.wait_for(lock, std::chrono::milliseconds(500));
+    if (g_watch_stop) break;
+    lock.unlock();
+    {
+      std::vector<std::pair<TickFn, void*>> ticks;
+      {
+        std::lock_guard<std::mutex> t(g_tick_mutex);
+        ticks = g_ticks;
+      }
+      for (auto& [fn, user] : ticks) fn(user);
+    }
+    // Guest threads blocked for more than 0.8 s; every 2 s where every known thread is.
+    std::vector<std::string> lines;
+    {
+      const int64_t now = NowUs();
+      const int n = std::min(g_slot_next.load(), kSlots);
+      static int tick = 0;
+      const bool all = (++tick % 4) == 0;
+      std::string threads = "THREADS";
+      for (int i = 0; i < n; ++i) {
+        Slot& s = g_slots[i];
+        if (!s.used) continue;
+        const int64_t since = s.since_us.load();
+        PPCContext* ctx = s.ctx.load();
+        if (all) {
+          threads += fmt::format(" | t{:X} e{:08X} lr{:08X} {}", s.thread_id.load(), s.entry.load(),
+                                 ctx ? uint32_t(ctx->lr) : 0u,
+                                 since ? fmt::format("wait {}ms", (now - since) / 1000) : "run");
+        }
+        if (!since || now - since < 800000) continue;
+        const bool fresh = s.reported_since.exchange(since) != since;
+        lines.push_back(fmt::format(
+            "WAIT{} t{:X} entry {:08X} lr {:08X} {} obj {:08X} type {} n{} {}ms{}",
+            fresh ? "-NEW" : "", s.thread_id.load(), s.entry.load(), s.lr.load(),
+            s.kind.load() ? s.kind.load() : "?", s.object.load(), s.type.load(), s.count.load(),
+            (now - since) / 1000, s.infinite.load() ? " infinite" : ""));
+      }
+      {
+        // Who holds the global critical region (logged when held across two ticks).
+        static int last_owner = 0;
+        const int owner = rex::thread::GlobalLockOwnerTid();
+        if (owner && owner == last_owner) {
+          std::string who = fmt::format("host{}", owner);
+          for (int i = 0; i < n; ++i) {
+            if (g_slots[i].used && g_slots[i].host_tid.load() == owner) {
+              PPCContext* c = g_slots[i].ctx.load();
+              who = fmt::format("t{:X} lr {:08X}", g_slots[i].thread_id.load(),
+                                c ? uint32_t(c->lr) : 0u);
+            }
+          }
+          lines.push_back(fmt::format("GLOCK held by {}", who));
+        }
+        last_owner = owner;
+      }
+      if (all) lines.push_back(threads);
+    }
+#if DMC4REC_SAMPLER
+    {
+      static int sample_tick = 0;
+      if ((++sample_tick % 2) == 0) SampleRunningThreads(lines);
+    }
+#endif
+    for (auto& l : lines) Line(l);
+    {
+      std::lock_guard<std::mutex> f(g_file_mutex);
+      if (g_file) std::fflush(g_file);
+    }
+    lock.lock();
+  }
+}
