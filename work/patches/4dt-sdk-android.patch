+std::FILE* g_file = nullptr;
+uint32_t g_draw_index = 0;
+uint32_t g_frames_checked = 0;
+bool g_light = false;
+constexpr uint32_t kBurstFrames = 12;
+uint32_t g_burst_left = 0;
+std::vector<TextureRange> g_texture_ranges;
