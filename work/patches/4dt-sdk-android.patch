+std::atomic<uint64_t> g_counters[kCount];
+uint32_t g_frames = 0;
+}  // namespace
+void Add(Counter counter, uint64_t value) {
+  g_counters[counter].fetch_add(value, std::memory_order_relaxed);
+}
+void OnFrame() {
+  if (++g_frames < 120) return;
+  uint64_t v[kCount];
+  for (uint32_t i = 0; i < kCount; ++i) v[i] = g_counters[i].exchange(0);
+  double f = double(g_frames);
+  g_frames = 0;
+  REXGPU_INFO(
+      "GPUSTAT/frame: draws {:.0f} passes {:.1f} texloads {:.1f} ({:.0f} KB) resolves {:.1f} "
+      "({:.0f} Kpx) dumps {:.1f} ({:.0f} tiles) transfers {:.1f} ({:.0f} tiles) alias copies {:.1f} "
+      "rt copies {:.1f} dropped {:.1f} hle clears {:.1f} pass restarts {:.1f} uploads {:.1f} "
+      "({:.0f} KB, hoisted {:.1f}) stale textures fixed {} evicted {} GPU {:.2f} ms "
+      "band draws skipped {:.1f} tight passes {:.1f} pass barriers {:.1f}",
+      v[kDraws] / f, v[kRenderPasses] / f, v[kTextureLoads] / f, v[kTextureLoadKB] / f,
+      v[kResolves] / f, v[kResolveKPixels] / f, v[kDumps] / f, v[kDumpTiles] / f,
+      v[kTransfers] / f, v[kTransferTiles] / f, v[kAliasCopies] / f, v[kTransferCopies] / f,
+      v[kTransfersDropped] / f, v[kHleClears] / f, v[kPassRestarts] / f,
+      v[kSharedMemoryUploads] / f, v[kSharedMemoryUploadKB] / f,
+      v[kSharedMemoryHoistedUploads] / f, v[kStaleTextures], v[kTexturesEvicted],
+      v[kGpuMicroseconds] / f / 1000.0, v[kBandDrawsSkipped] / f, v[kTightPasses] / f,
+      v[kPassBarriers] / f);
+}
