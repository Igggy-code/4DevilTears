diff --git a/include/rex/kernel/scene_state.h b/include/rex/kernel/scene_state.h
new file mode 100644
index 0000000..7b43940
--- /dev/null
+++ b/include/rex/kernel/scene_state.h
@@ -0,0 +1,25 @@
+/**
+ * [4DevilTears] What the game is showing right now, guessed from the files it streams:
+ * an open .wmv is a pre-rendered movie, an open sound\demo\*.xma is an in-engine cutscene
+ * (its 5.1 soundtrack streams for exactly as long as the cutscene plays). The Android UI
+ * uses it to hide the on-screen controller during non-interactive scenes.
+ */
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace rex::kernel::scene {
+
+enum Mode : int {
+  kModeInteractive = 0,
+  kModeCutscene = 1,
+  kModeMovie = 2,
+};
+
+void OnFileOpened(uint32_t handle, const std::string& path);
+void OnHandleClosed(uint32_t handle);
+/// Thread-safe. Movie wins over cutscene.
+int CurrentMode();
+
+}  // namespace rex::kernel::scene
