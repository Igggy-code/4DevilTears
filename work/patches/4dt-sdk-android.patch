+                    "format: host clear of that MSAA render target instead of drawing the clear");
+// MSAA of the surface of the XDK clear being performed (set by the command processor).
+xenos::MsaaSamples g_4dt_hle_clear_msaa = xenos::MsaaSamples::k1X;
+
+bool VulkanRenderTargetCache::HleClearEdram(uint32_t base_tiles, uint32_t pitch_tiles,
+                                            bool is_depth, uint32_t guest_format,
+                                            uint32_t first_row, uint32_t end_row,
+                                            const float* color, float depth, uint32_t stencil) {
+  if (GetPath() != Path::kHostRenderTargets || !pitch_tiles || end_row <= first_row) {
+    return false;
+  }
+  uint32_t start = base_tiles + first_row * pitch_tiles;
+  uint32_t end = std::min(base_tiles + end_row * pitch_tiles, xenos::kEdramTileCount);
+  // Clear the render targets that currently own the tiles, each in its own layout and
+  // format (no ownership changes, so no transfers later). Tiles owned by nothing or by
+  // the other kind (color vs depth) go to the 1X render target of the clear itself.
+  std::vector<EdramOwner> owners;
+  GetEdramOwners(start, end, owners);
+  RenderTargetKey own_key;
+  own_key.base_tiles = base_tiles;
+  own_key.pitch_tiles_at_32bpp = pitch_tiles;
+  own_key.msaa_samples = xenos::MsaaSamples::k1X;
+  own_key.is_depth = is_depth;
+  own_key.resource_format =
+      is_depth ? guest_format
+               : uint32_t(GetColorResourceFormatForGuest(
+                     xenos::ColorRenderTargetFormat(guest_format)));
+  uint64_t own_value;
+  if (!PackHleClearValue(is_depth, guest_format, color, depth, stencil, own_value)) {
+    return false;
+  }
+  const int32_t take_over_mode = REXCVAR_GET(d3d_clear_hle_take_ownership);
+  const bool take_over =
+      take_over_mode >= 2 ||
+      (take_over_mode == 1 && g_4dt_hle_clear_msaa != xenos::MsaaSamples::k1X);
+  // [4DevilTears] Only when the owners hold the same kind of data in the same format: a clear
+  // whose EDRAM range is currently another format's surface (logo screens: a 2_10_10_10
+  // clear over an 8_8_8_8 frame) left visible coloured bands - the draw is used then.
+  for (const EdramOwner& owner : owners) {
+    if (!owner.render_target) {
+      continue;
+    }
+    RenderTargetKey key = owner.render_target->key();
+    uint32_t owner_format =
+        key.is_depth ? uint32_t(key.GetDepthFormat()) : uint32_t(key.GetColorFormat());
+    if (bool(key.is_depth) != is_depth || key.resource_format != own_key.resource_format) {
+      // [4DevilTears] Which surfaces these clears land on (once per combination).
+      static std::unordered_set<std::string> logged;
+      std::string what = fmt::format(
+          "{}{} base {} p{} msaa{} rows {}-{} over {}{} base {} p{} msaa{} tiles {}-{}{}",
+          is_depth ? "D" : "C", uint32_t(own_key.resource_format), base_tiles, pitch_tiles,
+          1u << uint32_t(g_4dt_hle_clear_msaa), first_row, end_row, key.is_depth ? "D" : "C",
+          uint32_t(key.resource_format), uint32_t(key.base_tiles),
+          uint32_t(key.pitch_tiles_at_32bpp), 1u << uint32_t(key.msaa_samples),
+          owner.start_tiles, owner.end_tiles, take_over ? " - taken over" : " - drawn");
+      if (logged.size() < 64 && logged.insert(what).second) {
+        REXGPU_INFO("HLECLEAR other format: {}", what);
+      }
+      if (!take_over) {
+        // [4DevilTears] Through an MSAA surface (the 4x clear of the 1x scene): do what the
+        // drawn clear would - its own (MSAA) render target takes the rows over and is
+        // cleared - as a host clear instead of a full-surface draw (~2 ms each on Mali).
+        // Only once a heavy 3D scene has been running for a while (gameplay, in-engine
+        // cutscenes): on logos / loading screens / scene changes it showed red bands.
+        extern uint32_t g_4dt_heavy_frames;
+        if (g_4dt_hle_clear_msaa != xenos::MsaaSamples::k1X &&
+            REXCVAR_GET(d3d_clear_hle_msaa_surface) && g_4dt_heavy_frames >= 30) {
+          RenderTargetKey msaa_key = own_key;
+          msaa_key.msaa_samples = g_4dt_hle_clear_msaa;
+          RenderTarget* msaa_rt =
+              TakeOwnershipWithoutTransfers(msaa_key, start - base_tiles, end - start);
+          if (!msaa_rt) {
+            return false;
+          }
+          ClearRenderTargetTiles(msaa_rt, start, end, own_value);
+          if (!is_depth) {
+            // Transfers out of it into the 1X scene render target become fills.
+            Dmc4RecordUniformClear(base_tiles, pitch_tiles, g_4dt_hle_clear_msaa, is_depth,
+                                   guest_format, first_row, end_row, color, depth, stencil);
+          }
+          return true;
+        }
+        return false;
+      }
+    }
+    (void)owner_format;
+  }
+  bool any = false;
+  for (const EdramOwner& owner : owners) {
+    RenderTarget* render_target = owner.render_target;
+    uint64_t value;
+    if (render_target) {
+      RenderTargetKey key = render_target->key();
+      uint32_t owner_format = key.is_depth ? uint32_t(key.GetDepthFormat())
+                                           : uint32_t(key.GetColorFormat());
+      // [4DevilTears] Another format's surface here: the clear's own render target takes the
+      // rows over (the clear overwrites them all, nothing to carry over) - the draws that
+      // follow in the clear's format then find them already theirs, without transfers.
+      // Through an MSAA surface the clear's 1X render target takes everything over (no 4X
+      // render target left owning the rows the 1X scene draws into next).
+      bool clear_in_place = take_over ? key.key == own_key.key
+                                      : (bool(key.is_depth) == is_depth &&
+                                         key.resource_format == own_key.resource_format);
+      if (clear_in_place &&
+          PackHleClearValue(is_depth, owner_format, color, depth, stencil, value)) {
+        any |= ClearRenderTargetTiles(render_target, owner.start_tiles, owner.end_tiles, value);
+        continue;
+      }
+    }
+    render_target = TakeOwnershipWithoutTransfers(own_key, owner.start_tiles - base_tiles,
+                                                  owner.end_tiles - owner.start_tiles);
+    if (render_target) {
+      any |= ClearRenderTargetTiles(render_target, owner.start_tiles, owner.end_tiles,
+                                    own_value);
+    }
+  }
+  return any;
+}
+
+void VulkanRenderTargetCache::Dmc4RecordUniformClear(uint32_t base_tiles, uint32_t pitch_tiles,
+                                                     xenos::MsaaSamples msaa_samples,
+                                                     bool is_depth, uint32_t guest_format,
+                                                     uint32_t first_row, uint32_t end_row,
+                                                     const float* color, float depth,
+                                                     uint32_t stencil) {
+  RenderTargetKey key;
+  key.base_tiles = base_tiles;
+  key.pitch_tiles_at_32bpp = pitch_tiles;
+  key.msaa_samples = msaa_samples;
+  key.is_depth = is_depth;
+  key.resource_format =
+      is_depth ? guest_format
+               : uint32_t(GetColorResourceFormatForGuest(
+                     xenos::ColorRenderTargetFormat(guest_format)));
+  uint64_t value;
+  if (!PackHleClearValue(is_depth, guest_format, color, depth, stencil, value)) {
+    return;
+  }
+  uint32_t start = base_tiles + first_row * pitch_tiles;
+  uint32_t end = std::min(base_tiles + end_row * pitch_tiles, xenos::kEdramTileCount);
+  uint32_t k = key.key;
+  g_4dt_uniform_clears.erase(
+      std::remove_if(g_4dt_uniform_clears.begin(), g_4dt_uniform_clears.end(),
+                     [k](const Dmc4UniformClear& c) { return c.key == k; }),
+      g_4dt_uniform_clears.end());
+  if (g_4dt_uniform_clears.size() >= 32) {
+    g_4dt_uniform_clears.erase(g_4dt_uniform_clears.begin());
+  }
+  g_4dt_uniform_clears.push_back({k, start, end, value, g_4dt_draw_serial});
+}
+
+bool VulkanRenderTargetCache::ClearRenderTargetTiles(RenderTarget* render_target,
+                                                     uint32_t start_tiles, uint32_t end_tiles,
+                                                     uint64_t guest_clear_value) {
+  if (!render_target || GetPath() != Path::kHostRenderTargets) {
+    return false;
+  }
+  RenderTargetKey key = render_target->key();
+  {
+    uint32_t k = key.key;
+    g_4dt_uniform_clears.erase(
+        std::remove_if(g_4dt_uniform_clears.begin(), g_4dt_uniform_clears.end(),
+                       [k](const Dmc4UniformClear& c) { return c.key == k; }),
+        g_4dt_uniform_clears.end());
+  }
+  bool is_64bpp = !key.is_depth && xenos::IsColorRenderTargetFormat64bpp(key.GetColorFormat());
+  Transfer::Rectangle rectangles[Transfer::kMaxRectanglesWithoutCutout];
+  uint32_t rectangle_count =
+      Transfer::GetRangeRectangles(start_tiles, end_tiles, key.base_tiles,
+                                   key.pitch_tiles_at_32bpp, key.msaa_samples, is_64bpp,
+                                   rectangles);
+  std::vector<Transfer> no_transfers[1];
+  for (uint32_t i = 0; i < rectangle_count; ++i) {
+    PerformTransfersAndResolveClears(1, &render_target, no_transfers, &guest_clear_value,
+                                     &rectangles[i]);
+  }
+  return rectangle_count != 0;
+}
