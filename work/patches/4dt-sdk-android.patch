+// [fable2-port] Diagnostic: host call chain for unhandled guest faults, so the
+// recompiled guest functions (sub_XXXXXXXX) on the path can be symbolized with atos.
+namespace {
+void LogUnhandledFaultTrace(rex::arch::Exception* ex) {
+  static std::atomic<uint32_t> logged{0};
+  static uint64_t seen_pcs[64];
+  uint64_t pc = ex->pc();
+  uint32_t n = logged.load();
+  for (uint32_t i = 0; i < std::min<uint32_t>(n, 64); ++i) {
+    if (seen_pcs[i] == pc) return;
+  }
+  if (n >= 64) return;
+  seen_pcs[n] = pc;
+  logged.store(n + 1);
+  uint64_t frames[16];
+  int count = 0;
+  frames[count++] = pc;
+#if REX_ARCH_ARM64
+  auto* tc = ex->thread_context();
+  frames[count++] = tc->x[30];
+  uint64_t fp = tc->x[29];
+  while (count < 16 && fp && (fp & 0xF) == 0) {
+    uint64_t next_fp = reinterpret_cast<uint64_t*>(fp)[0];
+    uint64_t ret = reinterpret_cast<uint64_t*>(fp)[1];
+    if (!ret || next_fp <= fp) break;
+    frames[count++] = ret;
+    fp = next_fp;
+  }
+#endif
+  std::string line = fmt::format("[fault-trace] fault=0x{:X}", ex->fault_address());
+  for (int i = 0; i < count; ++i) {
+    Dl_info info{};
+    if (dladdr(reinterpret_cast<void*>(frames[i]), &info) && info.dli_fbase) {
+      const char* name = info.dli_fname ? std::strrchr(info.dli_fname, '/') : nullptr;
+      line += fmt::format(" {}@0x{:X}+0x{:X}", name ? name + 1 : "?",
+                          reinterpret_cast<uint64_t>(info.dli_fbase),
+                          frames[i] - reinterpret_cast<uint64_t>(info.dli_fbase));
+    } else {
+      line += fmt::format(" ?@0x{:X}", frames[i]);
+    }
+  }
+  REXSYS_ERROR("{}", line);
+}
