@@ -0,0 +1,24 @@
+// [4DevilTears] Shared between the render target cache and its Vulkan backend (kept out of the
+// public SDK headers).
+#pragma once
+#include <cstdint>
+#include <vector>
+
+namespace rex::graphics {
+struct Dmc4UniformClear {
+  uint32_t key;  // RenderTargetKey::key
+  uint32_t start_tiles, end_tiles;
+  uint64_t value;  // guest-packed clear value (RB_COLOR_CLEAR / RB_DEPTH_CLEAR encoding)
+  uint64_t draw_serial;  // the clear draw that recorded it
+};
+using Dmc4UniformClearList = std::vector<Dmc4UniformClear>;
+struct Dmc4UniformFill {
+  void* render_target;  // RenderTargetCache::RenderTarget*
+  uint32_t start_tiles, end_tiles;
+  uint64_t value;
+};
+extern Dmc4UniformClearList g_4dt_uniform_clears;
+extern std::vector<Dmc4UniformFill> g_4dt_uniform_fills;
+extern uint64_t g_4dt_draw_serial;
+extern uint64_t g_4dt_uniform_clear_draw;
+}  // namespace rex::graphics
