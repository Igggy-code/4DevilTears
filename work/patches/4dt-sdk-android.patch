+  last_begin_args_offset_ = SIZE_MAX;
+}
+
+void DeferredCommandBuffer::PatchLastBeginRenderArea(const VkRect2D& render_area) {
+  if (last_begin_args_offset_ == SIZE_MAX || last_begin_args_offset_ >= command_stream_.size()) {
+    return;
+  }
+  void* args = command_stream_.data() + last_begin_args_offset_;
+  if (last_begin_is_rendering_) {
+    reinterpret_cast<ArgsVkBeginRendering*>(args)->render_area = render_area;
+  } else {
+    reinterpret_cast<ArgsVkBeginRenderPass*>(args)->render_area = render_area;
+  }
+}
+
+void DeferredCommandBuffer::PatchLastBeginLoadOpDontCare() {
+  if (last_begin_args_offset_ == SIZE_MAX || last_begin_args_offset_ >= command_stream_.size() ||
+      !last_begin_is_rendering_) {
+    return;
+  }
+  uint8_t* args_ptr = reinterpret_cast<uint8_t*>(command_stream_.data() + last_begin_args_offset_);
+  auto& args = *reinterpret_cast<ArgsVkBeginRendering*>(args_ptr);
+  auto* attachments = reinterpret_cast<VkRenderingAttachmentInfo*>(
+      args_ptr + rex::align(sizeof(ArgsVkBeginRendering), alignof(VkRenderingAttachmentInfo)));
+  uint32_t count = args.color_attachment_count + uint32_t(args.has_depth_attachment) +
+                   uint32_t(args.has_stencil_attachment);
+  for (uint32_t i = 0; i < count; ++i) {
+    attachments[i].loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+  }
+}
+
+bool DeferredCommandBuffer::Dmc4OnlyBarriersBetween(size_t from, size_t to) const {
+  if (from > to || to > command_stream_.size()) {
+    return false;
+  }
+  size_t offset = from;
+  while (offset < to) {
+    const CommandHeader& header =
+        *reinterpret_cast<const CommandHeader*>(command_stream_.data() + offset);
+    if (header.command != Command::kVkPipelineBarrier &&
+        header.command != Command::kVkWriteTimestamp) {
+      return false;
+    }
+    offset += kCommandHeaderSizeElements + header.arguments_size_elements;
+  }
+  return offset == to;
+}
+
+VkRenderingAttachmentInfo* DeferredCommandBuffer::Dmc4RenderingAttachments(
+    size_t args_offset, uint32_t& color_count, bool& has_depth, bool& has_stencil) {
+  if (args_offset == SIZE_MAX || args_offset >= command_stream_.size()) {
+    return nullptr;
+  }
+  uint8_t* args_ptr = reinterpret_cast<uint8_t*>(command_stream_.data() + args_offset);
+  auto& args = *reinterpret_cast<ArgsVkBeginRendering*>(args_ptr);
+  color_count = args.color_attachment_count;
+  has_depth = args.has_depth_attachment;
+  has_stencil = args.has_stencil_attachment;
+  return reinterpret_cast<VkRenderingAttachmentInfo*>(
+      args_ptr + rex::align(sizeof(ArgsVkBeginRendering), alignof(VkRenderingAttachmentInfo)));
+}
+
+void DeferredCommandBuffer::Dmc4PatchRenderArea(size_t args_offset, const VkRect2D& area) {
+  if (args_offset == SIZE_MAX || args_offset >= command_stream_.size()) {
+    return;
+  }
+  reinterpret_cast<ArgsVkBeginRendering*>(command_stream_.data() + args_offset)->render_area =
+      area;
 }
 
