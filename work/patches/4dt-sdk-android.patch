+    const char* f = info.dli_fname;
+    if (strstr(f, "libart") || strstr(f, ".oat") || strstr(f, ".odex") || strstr(f, ".art") ||
+        strstr(f, "/framework/") || strstr(f, "/apex/com.android.art/")) {
+      return;
+    }
+  }
+  once = 1;
+  std::string path = FLAGS_log_file_storage_();
+  const size_t slash = path.rfind('/');
+  if (slash == std::string::npos) return;
+  path = path.substr(0, slash + 1) + "crash.txt";
+  const int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_APPEND, 0600);
+  if (fd < 0) return;
+  uintptr_t pc = 0, lr = 0;
+#if defined(__aarch64__)
+  const ucontext_t* uc = static_cast<const ucontext_t*>(signal_context);
+  pc = uintptr_t(uc->uc_mcontext.pc);
+  lr = uintptr_t(uc->uc_mcontext.regs[30]);
+#endif
+  auto where = [](uintptr_t a, char* out, size_t n) {
+    Dl_info info{};
+    if (a && dladdr(reinterpret_cast<void*>(a), &info) && info.dli_fname) {
+      const char* base = strrchr(info.dli_fname, '/');
+      snprintf(out, n, "%s+0x%lx%s%s", base ? base + 1 : info.dli_fname,
+               (unsigned long)(a - uintptr_t(info.dli_fbase)), info.dli_sname ? " " : "",
+               info.dli_sname ? info.dli_sname : "");
+    } else {
+      snprintf(out, n, "0x%lx", (unsigned long)a);
+    }
+  };
+  char pcs[256], lrs[256], thread[32] = {}, line[700];
+  where(pc, pcs, sizeof(pcs));
+  where(lr, lrs, sizeof(lrs));
+#if defined(__ANDROID__) || defined(__linux__)
+  pthread_getname_np(pthread_self(), thread, sizeof(thread));
+#endif
+  const int len = snprintf(line, sizeof(line),
+                           "CRASH signal %d code %d fault 0x%lx thread '%s' pc %s lr %s\n",
+                           signal_number, signal_info ? signal_info->si_code : 0,
+                           (unsigned long)(signal_info ? uintptr_t(signal_info->si_addr) : 0),
+                           thread, pcs, lrs);
+  if (len > 0) write(fd, line, size_t(len));
+  close(fd);
+}
+#endif
