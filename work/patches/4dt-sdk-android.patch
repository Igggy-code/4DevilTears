+
+set(GEN_INSTALL_TARGET OFF CACHE BOOL "")
+
+add_subdirectory(lib/linkernsbypass)
+
+set(LIB_SOURCES src/bcenabler.cpp
+                src/driver.cpp
+                include/adrenotools/bcenabler.h
+                include/adrenotools/driver.h
+                include/adrenotools/priv.h)
