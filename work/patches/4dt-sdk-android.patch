+extern "C" __attribute__((visibility("default"))) void Rex4dtSetHudActiveFn(int (*fn)()) { g_4dt_hud_active_fn.store(fn); }
+bool g_4dt_band_collapse_now = false;
+namespace {
+struct Dmc4UiDrawCapture {
+  bool logging = false;
+  uint32_t frame_draw = 0;
+  uint64_t layout_hash = 0;      // Hash of what the current frame draws (no positions).
+  uint64_t last_key = 0;
+  int64_t key_since_ms = 0;
+  int64_t last_log_ms = 0;
+  uint64_t logging_key = 0;
+  std::unordered_set<uint64_t> done;
+  uint64_t last_consts_hash = 0;
+  std::unordered_set<uint64_t> frame_items;  // Distinct shader/texture pairs of the frame.
+  std::FILE* file = nullptr;
+  bool file_tried = false;
+};
+Dmc4UiDrawCapture g_uicap;
+int64_t Dmc4UiNowMs() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+uint64_t Dmc4Mix(uint64_t h, uint64_t v) {
+  h ^= v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2);
+  return h;
+}
+void Dmc4UiOut(const std::string& line) {
+  auto& c = g_uicap;
+  if (!c.file_tried) {
+    c.file_tried = true;
+    const std::string& path = REXCVAR_GET(ui_capture_file);
+    if (!path.empty()) c.file = std::fopen(path.c_str(), "w");
+    REXGPU_INFO("UIDRAW capture to {} ({})", path, c.file ? "open" : "main log");
+  }
+  if (c.file) {
+    std::fputs(line.c_str(), c.file);
+    std::fputc('\n', c.file);
+  } else {
+    REXGPU_INFO("{}", line);
+  }
+}
