+void VulkanCommandProcessor::PassAreaFinish() {
+  if (dmc4_clear_only_pass_) {
+    dmc4_clear_only_pass_ = false;
+    if (REXCVAR_GET(vulkan_clear_pass_no_load)) {
+      pass_area_patchable_ = false;
+      deferred_command_buffer_.PatchLastBeginRenderArea(dmc4_clear_only_rect_);
+      deferred_command_buffer_.PatchLastBeginLoadOpDontCare();
+      gpu_stats::Add(gpu_stats::kTightPasses, 1);
+      size_t args = deferred_command_buffer_.Dmc4LastBeginArgsOffset();
+      if (args != SIZE_MAX) {
+        dmc4_clear_pending_ = {args, SIZE_MAX, dmc4_clear_only_image_, dmc4_clear_only_depth_,
+                               dmc4_clear_only_rect_, dmc4_clear_only_value_,
+                               GetCurrentSubmission()};
+        dmc4_clear_pending_end_ = true;
+      }
+      return;
+    }
+  }
+  if (!dmc4_draw_chain_.empty()) {
+    bool merged = Dmc4MergeClearsIntoDrawPass();
+    dmc4_draw_chain_.clear();
+    dmc4_draw_args_ = SIZE_MAX;
+    if (merged) {
+      pass_area_patchable_ = false;
+      return;
+    }
+  }
+  if (!pass_area_patchable_) {
+    return;
+  }
+  pass_area_patchable_ = false;
+  if (pass_area_x1_ <= pass_area_x0_ || pass_area_y1_ <= pass_area_y0_) {
+    return;  // No draws with a known extent - keep the full area.
+  }
+  // Align to 32 pixels (a whole number of tiles on Mali / Adreno bins are larger anyway).
+  int32_t x0 = pass_area_x0_ & ~31, y0 = pass_area_y0_ & ~31;
+  int32_t x1 = std::min((pass_area_x1_ + 31) & ~31, int32_t(pass_area_extent_.width));
+  int32_t y1 = std::min((pass_area_y1_ + 31) & ~31, int32_t(pass_area_extent_.height));
+  if (x0 == 0 && y0 == 0 && uint32_t(x1) == pass_area_extent_.width &&
+      uint32_t(y1) == pass_area_extent_.height) {
+    return;
+  }
+  VkRect2D area;
+  area.offset.x = x0;
+  area.offset.y = y0;
+  area.extent.width = uint32_t(x1 - x0);
+  area.extent.height = uint32_t(y1 - y0);
+  deferred_command_buffer_.PatchLastBeginRenderArea(area);
+  gpu_stats::Add(gpu_stats::kTightPasses, 1);
 }
 
