+  uint32_t words = length >> 3;
+  uint64_t hash = UINT64_C(0xCBF29CE484222325) ^ length;
+  if (!words) {
+    return hash;
+  }
+  uint32_t step = std::max(words / kSamples, UINT32_C(1));
+  const uint8_t* base = memory.TranslatePhysical<const uint8_t*>(start);
+  for (uint32_t w = 0; w < words; w += step) {
+    uint64_t value;
+    std::memcpy(&value, base + (size_t(w) << 3), sizeof(value));
+    hash = (hash ^ value) * UINT64_C(0x100000001B3);
+    hash ^= hash >> 29;
+  }
+  // The last word too (tails of mip chains).
+  uint64_t value;
+  std::memcpy(&value, base + (size_t(words - 1) << 3), sizeof(value));
+  hash = (hash ^ value) * UINT64_C(0x100000001B3);
+  return hash;
+}
+
+void TextureCache::UpdateTextureSignature(Texture& texture) {
+  if (!REXCVAR_GET(texture_verify_contents) || texture.key().scaled_resolve) {
+    texture.verify_signature_valid_ = false;
+    return;
+  }
+  const TextureKey& key = texture.key();
+  texture.verify_signature_base_ =
+      key.base_page ? ComputeGuestSignature(key.base_page << 12, texture.GetGuestBaseSize()) : 0;
+  texture.verify_signature_mips_ =
+      key.mip_page ? ComputeGuestSignature(key.mip_page << 12, texture.GetGuestMipsSize()) : 0;
+  texture.verify_signature_valid_ = true;
+}
+
+void TextureCache::VerifyTextureContents() {
+  int32_t budget = REXCVAR_GET(texture_verify_contents);
+  if (budget <= 0) {
+    return;
+  }
+  static uint32_t frame = 0;
+  ++frame;
+  uint32_t checked = 0, examined = 0;
+  bool any_stale = false;
+  for (Texture* texture = texture_used_last_; texture && checked < uint32_t(budget);
+       texture = texture->used_previous()) {
+    // Only textures used recently matter; the list is in usage order.
+    if (texture->last_usage_submission_index() + 8 < current_submission_index_) {
+      break;
+    }
+    // Spread the checks over 4 frames.
+    if (((examined++) & 3) != (frame & 3)) {
+      continue;
+    }
+    if (!texture->verify_signature_valid_ || texture->outdated_mask()) {
+      continue;
+    }
+    ++checked;
+    const TextureKey& key = texture->key();
+    bool stale_base = key.base_page &&
+                      ComputeGuestSignature(key.base_page << 12, texture->GetGuestBaseSize()) !=
+                          texture->verify_signature_base_;
+    bool stale_mips = key.mip_page &&
+                      ComputeGuestSignature(key.mip_page << 12, texture->GetGuestMipsSize()) !=
+                          texture->verify_signature_mips_;
+    if (!stale_base && !stale_mips) {
+      continue;
+    }
+    texture->verify_signature_valid_ = false;
+    any_stale = true;
+    gpu_stats::Add(gpu_stats::kStaleTextures, 1);
+    // Proper CPU-write invalidation: drops the pages from the shared memory and
+    // fires the watches of everything built from them (this texture included).
+    if (stale_base) {
+      shared_memory().MemoryInvalidationCallback(key.base_page << 12, texture->GetGuestBaseSize(),
+                                                 true);
+    }
+    if (stale_mips) {
+      shared_memory().MemoryInvalidationCallback(key.mip_page << 12, texture->GetGuestMipsSize(),
+                                                 true);
+    }
+  }
+  if (any_stale) {
+    ResetTextureBindings();
+  }
 }
 
