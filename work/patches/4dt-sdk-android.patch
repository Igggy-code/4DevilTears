+        vte.vport_y_offset_ena && !regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET]) {
+      auto regf = [&](uint32_t reg) {
+        float f;
+        std::memcpy(&f, &regs[reg], 4);
+        return f;
+      };
+      float sx = std::abs(regf(XE_GPU_REG_PA_CL_VPORT_XSCALE));
+      float sy = std::abs(regf(XE_GPU_REG_PA_CL_VPORT_YSCALE));
+      float ox = regf(XE_GPU_REG_PA_CL_VPORT_XOFFSET);
+      float oy = regf(XE_GPU_REG_PA_CL_VPORT_YOFFSET);
+      if (std::isfinite(sx) && std::isfinite(sy) && std::isfinite(ox) && std::isfinite(oy) &&
+          sx > 0.0f && sy > 0.0f) {
+        // Host pixels per guest pixel: resolution scale, and up to 2x2 for MSAA surfaces
+        // (whether the host keeps the samples or stores them as a bigger 1x image).
+        xenos::MsaaSamples msaa = regs.Get<reg::RB_SURFACE_INFO>().msaa_samples;
+        int32_t mx = int32_t(render_target_cache_->draw_resolution_scale_x()) *
+                     (msaa >= xenos::MsaaSamples::k4X ? 2 : 1);
+        int32_t my = int32_t(render_target_cache_->draw_resolution_scale_y()) *
+                     (msaa >= xenos::MsaaSamples::k2X ? 2 : 1);
+        // One pixel of margin for half-pixel offsets.
+        int32_t vx0 = (int32_t(std::floor(ox - sx)) - 1) * mx;
+        int32_t vx1 = (int32_t(std::ceil(ox + sx)) + 1) * mx;
+        int32_t vy0 = (int32_t(std::floor(oy - sy)) - 1) * my;
+        int32_t vy1 = (int32_t(std::ceil(oy + sy)) + 1) * my;
+        x0 = std::max(x0, vx0);
+        y0 = std::max(y0, vy0);
+        x1 = std::min(x1, vx1);
+        y1 = std::min(y1, vy1);
+      }
+    }
+  }
+  if (x1 <= x0 || y1 <= y0) {
+    return;
+  }
+  PassAreaAddRect(x0, y0, uint32_t(x1 - x0), uint32_t(y1 - y0));
+}
+
+void VulkanCommandProcessor::PassAreaAddRect(int32_t x, int32_t y, uint32_t width,
+                                             uint32_t height) {
+  if (!pass_area_patchable_ || !in_render_pass_) {
+    return;
+  }
+  int32_t x0 = std::max(x, 0), y0 = std::max(y, 0);
+  int32_t x1 = std::min(int32_t(x + int32_t(width)), int32_t(pass_area_extent_.width));
+  int32_t y1 = std::min(int32_t(y + int32_t(height)), int32_t(pass_area_extent_.height));
+  if (x1 <= x0 || y1 <= y0) {
+    return;
+  }
+  pass_area_x0_ = std::min(pass_area_x0_, x0);
+  pass_area_y0_ = std::min(pass_area_y0_, y0);
+  pass_area_x1_ = std::max(pass_area_x1_, x1);
+  pass_area_y1_ = std::max(pass_area_y1_, y1);
+}
